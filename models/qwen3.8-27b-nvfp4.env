# Qwen3.8 27B in NVFP4, served by NIM: the model this release ships.
MODEL_ENGINE="nim"
NIM_LLM_MODEL_PATH="hf://Inferact/Qwen3.8-27B-NVFP4"
NIM_LLM_PASSTHROUGH_ARGS=--gpu-memory-utilization 0.75 --max-model-len 131072 --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3 --speculative-config '{"method":"mtp","num_speculative_tokens":3}' --default-chat-template-kwargs '{"enable_thinking":false}' --enable-prefix-caching
LLM_MODEL="Qwen/Qwen3.8-27B"
GATEWAY_LLM_SERVED_NAME="Qwen/Qwen3.8-27B"
GATEWAY_VLM_MODEL="Qwen/Qwen3.8-27B"
VLLM_LLM_MODEL="Qwen/Qwen3.8-27B"
VLLM_CONDENSE_MODEL="Qwen/Qwen3.8-27B"
VLLM_VLM_MODEL="Qwen/Qwen3.8-27B"
