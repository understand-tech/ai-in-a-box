# Nemotron-3.5-Bolt-74B-A9B, with b12x and speculative decoding: the model the office
# ran by hand on .56. NIM cannot serve it; vLLM does, from ut-engines' image, by digest.
# 0.85, not vLLM's 0.92: on a GB10 the 0.92 asks for 111.95 of 121.69 GiB, more than is
# free once the rest of the box runs, and the engine restarts forever.
VLLM_ENGINE_IMAGE="ghcr.io/understand-tech/engines/vllm:0.32.0rc1.dev100-b12x1.5.1@sha256:496fa5c9449c7d8613b3ddf73eb68feaaf9f6c76da78a6acb166047fd1e24cf5"
VLLM_ENGINE_MODEL="nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB"
VLLM_ENGINE_ARGS=--gpu-memory-utilization 0.85 --trust-remote-code --load-format auto --tensor-parallel-size 1 --max-model-len 262144 --max-num-seqs 16 --enable-chunked-prefill --max-num-batched-tokens 8192 --override-generation-config {"temperature":0.2,"top_p":0.9,"top_k":20} --kv-cache-dtype fp8 --linear-backend b12x --moe-backend b12x --attention-backend FLASHINFER --mamba-backend flashinfer --mamba-ssm-cache-dtype bfloat16 --mamba-cache-dtype bfloat16 --mamba-cache-mode align --seed 42 --limit-mm-per-prompt {"video":1,"image":1} --video-pruning-rate 0.5 --media-io-kwargs {"video":{"fps":2,"num_frames":256}} --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser-plugin ultra_v3_reasoning_parser.py --reasoning-parser ultra_v3 --speculative-config {"method":"dflash","model":"nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr","num_speculative_tokens":7,"rejection_sample_method":"standard","attention_backend":"FLASHINFER","draft_load_config":{"load_format":"auto"}}
LLM_MODEL="nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB"
GATEWAY_LLM_SERVED_NAME="nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB"
GATEWAY_VLM_MODEL="nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB"
VLLM_LLM_MODEL="nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB"
VLLM_CONDENSE_MODEL="nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB"
VLLM_VLM_MODEL="nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB"
