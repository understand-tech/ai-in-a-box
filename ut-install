#!/usr/bin/env bash

set -Eeuo pipefail

REPO_URL="${UT_REPO_URL:-https://github.com/understand-tech/ai-in-a-box.git}"
REPO_REF="${UT_REPO_REF:-main}"
REGISTRY="${UT_REGISTRY:-ghcr.io}"
REGISTRY_USER="${UT_REGISTRY_USER:-dgx-access}"

PACKAGE_SHARE_DIR="/usr/share/understandtech"
CHECKOUT_INSTALL_DIR="/opt/understandtech"
INSTALL_DIR="${UT_INSTALL_DIR:-}"
FROM_CHECKOUT="${UT_FROM_CHECKOUT:-}"
DATA_DIR="/var/lib/understandtech"
LOG_FILE="/var/log/ut-install.log"
TARGET_USER="${SUDO_USER:-root}"
DOMAIN="${UT_DOMAIN:-}"
FALLBACK_DOMAIN="understand.local"

MIN_DOCKER_MAJOR=24
MIN_DISK_BYTES=$((250 * 1000 * 1000 * 1000))
MIN_RAM_KB=$((24 * 1024 * 1024))
# 15.74 GB of images plus a 3.5 GB ceiling on the journals — x-logging caps them
# at 50 MB over 5 files per service — leaves the rest for the database, the
# uploads and thirty days of backups.
MIN_DISK_BYTES_NO_INFERENCE=$((60 * 1000 * 1000 * 1000))
# The thirteen services left once the engines are out reserve 10 GB at the
# replica counts the release ships (WORKER_REPLICAS=2, WORKER_CUSTOMER_REPLICAS=2):
# api-customer and workers-customer take 2 GB each, mongodb and api 1 GB each,
# the rest 64 to 512 MB. 12 leaves the host its own.
MIN_RAM_KB_NO_INFERENCE=$((12 * 1024 * 1024))
NIM_COLD_START_SECONDS=2700

ACTION="install"
DO_UPDATE=false
DO_AUTOSTART=true
DO_PULL=true
NO_GPU=false
TOKEN_FILE=""
REGISTRY_TOKEN="${UT_REGISTRY_TOKEN:-}"
LICENSE_FILE=""
LICENSE="${UT_LICENSE:-}"
LICENSE_STORE="/etc/understandtech/license"
HEALTH_TIMEOUT="${UT_HEALTH_TIMEOUT:-3600}"
REPORTING="${UT_REPORTING:-}"
REPORTING_RECEIVER=""
REPORTING_TOKEN_FILE=""
REPORTING_RECEIVER_CERT=""
REPORTING_EVERY=""
UT_SEND="${UT_SEND:-ut-send}"
CURRENT_STEP=""
INFERENCE_STILL_LOADING=""

SHIPPED_PLACEHOLDERS=(
    "" "12345678" "password" "SECRET" "SJKFVK" "FVVE" "SJBVSJB" "ut"
    "czIzgahTJGzdG3b1XtEgGIWPvwhdfBvhVd1JjzetjWQ" "EMPTY"
)
GENERATED_SECRET_KEYS=(JWT_SECRET STATE_SECRET OPENID_SECRET_KEY ADMIN_SETUP_PASSWORD BACKUP_FILES_PASSWORD CA_PASSWORD GPU_VM_API_TOKEN GATEWAY_METRICS_TOKEN APP_BUILDER_TOKEN_ENCRYPTION_KEY VLLM_API_KEY)
STEP_CA_UID=1000
CA_CERT_DURATION=168h

if [[ -t 1 ]]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
    CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; CYAN=""; BOLD=""; NC=""
fi

log()       { printf '%s\n' "$*"; }
log_info()  { printf '%s[ ok ]%s %s\n' "$GREEN" "$NC" "$*"; }
log_warn()  { printf '%s[warn]%s %s\n' "$YELLOW" "$NC" "$*"; }
log_error() { printf '%s[fail]%s %s\n' "$RED" "$NC" "$*" >&2; }
log_step()  { CURRENT_STEP=$*; printf '\n%s==>%s %s%s%s\n' "$CYAN" "$NC" "$BOLD" "$*" "$NC"; }

die() { log_error "$*"; exit 1; }

report_failure_and_exit() {
    local exit_code=$? line=$1
    log_error "Install stopped at line ${line} (exit ${exit_code})."
    log_error "Nothing was rolled back — re-running the same command resumes."
    log_error "Log: ${LOG_FILE}"
    exit "$exit_code"
}
trap 'report_failure_and_exit $LINENO' ERR

usage() {
    cat <<'EOF'
ut-install — installs the UnderstandTech appliance in one command.

Replaces steps 1 to 10 of the manual setup guide. Safe to re-run: every step
checks its own state before acting, so an interrupted install is resumed by
running the same command again.

  sudo ./ut-install                 install
  sudo ./ut-install --check         preflight only, changes nothing
  sudo ./ut-install --update        also fast-forward an existing checkout

Options
  --check              Run the preflight checks and exit. Changes nothing.
  --update             Fast-forward an existing checkout to the target ref.
                       Off by default so a support fix applied on the machine
                       is not silently discarded.
  --license-file PATH  The license key UnderstandTech issued for this machine.
                       Asked for when it is not given and none is stored yet.
  --token-file PATH    A registry token instead of a license key. Accepted by
                       this version only.
  --dir PATH           Install directory. Defaults to /usr/share/understandtech
  --from-checkout PATH Take the settings from an install that lives in a git
                       checkout. Found on its own when there is exactly one;
                       needed when there are several. The checkout is read,
                       never moved, changed or removed.
                       when installed from the package, /opt/understandtech
                       otherwise.
  --domain NAME        Address the platform is served at. Asked for when it is
                       not given, offering the address this machine already
                       answers on, or understand.local on a first install.
  --no-autostart       Skip the boot service and the mDNS publisher, which is
                       installed on a .local domain only.
  --skip-pull          Do not pull images. Useful when they are already local.
  --no-gpu             This machine has no accelerator and serves no inference;
                       another machine does, named by VLLM_LLM_BASE_URL. Waives
                       the accelerator check, never a driver that stopped
                       answering. A settings file already carrying
                       compose.no-gpu.yaml says the same thing.
  --health-timeout N   Seconds to wait for services (default: 3600).
  --reporting yes|no   Whether this machine sends its usage reports to
                       UnderstandTech (docs/usage-report.md says what they hold).
                       Asked for when it is not given and a terminal is there;
                       with no terminal and no answer, nothing is sent. Asked
                       once: a later run keeps the answer unless given again.
  --reporting-receiver URL, --reporting-token-file PATH,
  --reporting-receiver-cert PATH
                       Where reports go, this machine's token, and the
                       receiver's certificate. Can come later, through
                       ut-send configure.
  --reporting-every N  Minutes between two sends (default: 15).
  -h, --help           This message.

Environment
  UT_LICENSE           License key, instead of --license-file or the prompt.
  UT_REGISTRY_TOKEN    Registry token, instead of --token-file.
  UT_REPO_REF          Branch or tag to install (default: main).
  UT_DOMAIN            Address the platform is served at.
  UT_REPORTING         yes or no, as --reporting.

The license key is read from UT_LICENSE, from --license-file, from the key stored
by an earlier install, or from a hidden prompt. It is checked before anything
else, kept in /etc/understandtech/license, and the registry token it carries is
never passed on a command line nor written to the log. A license that has ended
stops an install or an update, never a platform that is running.
EOF
}

as_target_user() {
    if [[ "$TARGET_USER" == "root" ]]; then
        "$@"
    else
        sudo -u "$TARGET_USER" -H "$@"
    fi
}

random_alphanumeric() {
    # The platform builds its database URI by concatenation, so a value holding
    # @ / # or % breaks the connection string.
    local chars="${1:-32}" raw
    if command -v openssl >/dev/null 2>&1; then
        raw=$(openssl rand -hex "$(( (chars + 1) / 2 ))")
    else
        raw=$(od -An -tx1 -N "$(( (chars + 1) / 2 ))" /dev/urandom | tr -d ' \n')
    fi
    printf '%s' "${raw:0:chars}"
}

# The App Builder reads its token key with Fernet, which takes 32 bytes in
# URL-safe base64 and refuses anything else, hexadecimal included.
random_fernet_key() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -base64 32 | tr '+/' '-_'
    else
        head -c 32 /dev/urandom | base64 | tr '+/' '-_'
    fi
}

env_get() {
    local file=$1 key=$2 value
    [[ -f "$file" ]] || return 1
    value=$(grep -m1 -E "^[[:space:]]*${key}=" "$file" 2>/dev/null) || return 1
    value=${value#*=}
    value=${value%\"}; value=${value#\"}
    value=${value%\'}; value=${value#\'}
    printf '%s' "$value"
}

env_set() {
    # Copying the temp file's content back, rather than moving it over, keeps
    # the original inode and its 0600 permissions.
    local file=$1 key=$2 value=$3 tmp found=0 line
    tmp=$(mktemp)
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*${key}= ]]; then
            printf '%s="%s"\n' "$key" "$value" >> "$tmp"
            found=1
        else
            printf '%s\n' "$line" >> "$tmp"
        fi
    done < "$file"
    (( found )) || printf '%s="%s"\n' "$key" "$value" >> "$tmp"
    cat "$tmp" > "$file"
    rm -f "$tmp"
}

is_shipped_placeholder() {
    local candidate=$1 placeholder
    for placeholder in "${SHIPPED_PLACEHOLDERS[@]}"; do
        [[ "$candidate" == "$placeholder" ]] && return 0
    done
    return 1
}

database_already_initialised() {
    local env_file=$1 prefix
    prefix=$(env_get "$env_file" RESOURCE_PREFIX 2>/dev/null || true)
    docker volume inspect "${prefix:-ut}-mongodb-data" >/dev/null 2>&1
}

compose_in_dir() { ( cd "$INSTALL_DIR" && docker compose "$@" ); }

appbuilder_enabled() {
    [[ "$(env_get "$INSTALL_DIR/.env" COMPOSE_FILE 2>/dev/null || true)" == *appbuilder* ]]
}

# The preflight runs before step_configure, so on a first install there is no
# .env to read yet and the flag is the only way to say it. The settings file
# answers for a laboratory stack, which docs/install.md has the operator write
# before calling this.
the_inference_is_served_by_another_machine() {
    $NO_GPU && return 0
    [[ "$(env_get "$INSTALL_DIR/.env" COMPOSE_FILE 2>/dev/null || true)" == *no-gpu* ]]
}

# Printed at the end and kept in the install log. Without it, a box whose driver
# died and a machine that never had an accelerator leave the same trace, and the
# first one is a failure nobody would look for.
role_this_machine_was_installed_as() {
    if ! the_inference_is_served_by_another_machine; then
        printf 'appliance — inference runs on this machine'
    elif the_inference_url_names_a_service_this_machine_will_not_run; then
        printf 'control plane — and nothing serves it yet: VLLM_LLM_BASE_URL still names %s' \
            "${INTERNAL_INFERENCE_HOST:-no host at all}"
    else
        printf 'control plane — generates nothing here, inference comes from %s' \
            "$(env_get "$INSTALL_DIR/.env" VLLM_LLM_BASE_URL 2>/dev/null)"
    fi
}

checkout_exists() { [[ -d "$INSTALL_DIR/.git" ]]; }

# The package owns /usr/share/understandtech: the release arrives and leaves with
# apt, so there is nothing here to clone, pull or reset.
release_comes_from_the_package_manager() {
    [[ "$INSTALL_DIR" == "$PACKAGE_SHARE_DIR" && -f "$INSTALL_DIR/compose.yaml" ]]
}

running_from_the_package() {
    [[ "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" == "/usr/bin" ]]
}

directory_the_script_sits_in() {
    ( cd "$(dirname "${BASH_SOURCE[0]}")" && pwd )
}

# Both marks are required: a directory holding only one of them is something
# else, and adopting it would install beside the release rather than onto it.
looks_like_a_checkout() {
    [[ -f "$1/compose.yaml" && -d "$1/.git" ]]
}

resolve_install_dir() {
    [[ -n "$INSTALL_DIR" ]] && return 0
    local here
    here=$(directory_the_script_sits_in)
    if looks_like_a_checkout "$here"; then
        INSTALL_DIR="$here"
    elif running_from_the_package && [[ -f "$PACKAGE_SHARE_DIR/compose.yaml" ]]; then
        INSTALL_DIR="$PACKAGE_SHARE_DIR"
    else
        INSTALL_DIR="$CHECKOUT_INSTALL_DIR"
    fi
}

registry_credentials_stored() { grep -q "$REGISTRY" /root/.docker/config.json 2>/dev/null; }

release_declares() {
    local key=$1 line
    line=$(grep -m1 "^${key}=" "$INSTALL_DIR/release.env" 2>/dev/null) || return 1
    line=${line#*=}; line=${line%\"}; line=${line#\"}
    [[ -n "$line" ]] || return 1
    printf '%s' "$line"
}

nvidia_runtime_registered() {
    docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q nvidia
}

# The toolkit stopped registering a docker runtime once CDI became its default
# path, so a working GPU host can have no nvidia runtime at all.
nvidia_cdi_devices_declared() {
    local candidate
    for candidate in /etc/cdi/nvidia*.yaml /etc/cdi/nvidia*.json \
                     /var/run/cdi/nvidia*.yaml /var/run/cdi/nvidia*.json; do
        [[ -e "$candidate" ]] && return 0
    done
    return 1
}

# Docker hands each network a block from a small pool, and a machine that has
# run generated applications keeps their networks long after they stop. Asking
# for one is the only way to know there is room: nothing reports the count left.
docker_can_still_allocate_a_network() {
    local probe="ut-preflight-$$"
    docker network create "$probe" >/dev/null 2>&1 || return 1
    docker network rm "$probe" >/dev/null 2>&1 || true
    return 0
}

preflight() {
    log_step "Checking the system"
    local blocking=0

    if ! command -v docker >/dev/null 2>&1; then
        log_error "Docker is not installed."
        blocking=1
    else
        local docker_version major
        docker_version=$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo "unknown")
        major=${docker_version%%.*}
        if [[ "$major" =~ ^[0-9]+$ ]] && (( major >= MIN_DOCKER_MAJOR )); then
            log_info "Docker ${docker_version}"
        else
            log_error "Docker ${docker_version} — ${MIN_DOCKER_MAJOR}.0 or newer required."
            blocking=1
        fi
    fi

    if docker compose version >/dev/null 2>&1; then
        log_info "Compose $(docker compose version --short 2>/dev/null || echo v2)"
    else
        log_error "Docker Compose V2 is missing (docker compose)."
        blocking=1
    fi

    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
        log_info "GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
        if nvidia_runtime_registered; then
            log_info "GPU reachable from containers through the nvidia runtime"
        elif nvidia_cdi_devices_declared; then
            log_info "GPU reachable from containers through CDI"
        else
            log_error "Docker cannot reach the GPU: no nvidia runtime and no CDI device."
            log_error "  Inference containers will not start. Install the NVIDIA"
            log_error "  Container Toolkit, then either 'nvidia-ctk runtime configure'"
            log_error "  or 'nvidia-ctk cdi generate'."
            blocking=1
        fi
    elif the_inference_is_served_by_another_machine; then
        # Only reached when nvidia-smi answered nothing. A box whose driver died
        # under a kernel upgrade still answers, so it lands in the branch above
        # and stays blocked there: what is waived here is the absence of an
        # accelerator, never a broken one.
        log_warn "No accelerator — the inference is served by another machine."
        log_warn "  Nothing here will generate; VLLM_LLM_BASE_URL has to point at a machine that does."
    else
        log_error "No usable GPU detected (nvidia-smi)."
        log_error "  Install the driver, or say the inference runs on another machine:"
        log_error "    --no-gpu, or COMPOSE_FILE=\"compose.yaml:compose.no-gpu.yaml\" in .env"
        blocking=1
    fi

    # A box whose battery died boots in 1970 and nothing on it can tell: offline
    # there is no authority to ask. What can be proved without one is that the
    # clock is not earlier than the release — a package cannot have been built
    # after the machine that installs it.
    local built_at now
    built_at=$(release_declares UT_RELEASE_BUILT_AT || true)
    if [[ "$built_at" =~ ^[0-9]+$ ]]; then
        now=$(date +%s)
        if (( now >= built_at )); then
            log_info "Clock: $(date -u '+%Y-%m-%d %H:%M UTC')"
        else
            log_error "Clock: $(date -u '+%Y-%m-%d %H:%M UTC') — before this release was built"
            log_error "  ($(date -u -d "@${built_at}" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || printf 'epoch %s' "$built_at"))."
            log_error "  The clock is wrong, and every certificate issued here will be refused as"
            log_error "  not yet valid. Set it, then run this again:"
            log_error "    sudo timedatectl set-time 'YYYY-MM-DD HH:MM:SS'"
            blocking=1
        fi
    fi

    if command -v timedatectl >/dev/null 2>&1 \
        && [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" != yes ]]; then
        log_warn "The clock is not synchronised. On a machine with no network that is expected —"
        log_warn "  set it by hand and check it, because certificate validity depends on it."
    fi

    # Both floors were sized for a machine that holds the models. Measured on a
    # box in service: the engines account for 43.1 GB on their own — 24.44 for
    # model-free-nim, 15.11 for ut-llm-customers, 3.56 for the ut-llm-models
    # volume — and everything else comes to 15.74 GB. Asking a machine that
    # serves no inference for 250 GB refuses it over storage it will never use.
    local disk_floor=$MIN_DISK_BYTES ram_floor=$MIN_RAM_KB
    if the_inference_is_served_by_another_machine; then
        disk_floor=$MIN_DISK_BYTES_NO_INFERENCE
        ram_floor=$MIN_RAM_KB_NO_INFERENCE
    fi

    local available_bytes disk_target
    disk_target=$([[ -d /var/lib/docker ]] && echo /var/lib/docker || echo /var/lib)
    available_bytes=$(df -B1 --output=avail "$disk_target" 2>/dev/null | tail -1 | tr -d ' ')
    if [[ -n "$available_bytes" ]] && (( available_bytes >= disk_floor )); then
        log_info "Disk: $((available_bytes / 1000000000)) GB free on ${disk_target}"
    else
        log_error "Disk: $((${available_bytes:-0} / 1000000000)) GB free on ${disk_target} — $((disk_floor / 1000000000)) GB needed."
        blocking=1
    fi

    local ram_kb
    ram_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    if (( ram_kb >= ram_floor )); then
        log_info "Memory: $((ram_kb / 1024 / 1024)) GB"
    else
        log_warn "Memory: $((ram_kb / 1024 / 1024)) GB — low, workers may be starved"
    fi

    # Only the checkout path needs git. A release the package manager put in
    # place is never cloned, pulled or reset, so requiring git there would stop
    # an install that has everything it needs.
    if ! command -v docker >/dev/null 2>&1; then
        :
    elif docker_can_still_allocate_a_network; then
        log_info "Docker has address space left for the stack's networks"
    else
        log_error "Docker cannot create a network — its address pools are full."
        log_error "  The stack needs four. Reclaim the ones nothing uses:"
        log_error "    docker network prune"
        log_error "  Or widen the pools in /etc/docker/daemon.json and restart docker:"
        log_error '    { "default-address-pools": [ { "base": "10.100.0.0/16", "size": 24 } ] }'
        blocking=1
    fi

    if release_is_present && ! $DO_UPDATE; then
        log_info "Release already at ${INSTALL_DIR} — nothing to clone, git not needed"
    elif command -v git >/dev/null 2>&1; then
        log_info "git present"
    else
        log_error "git is not installed, and the release has to be fetched."
        blocking=1
    fi

    if (( blocking )); then
        log_error ""
        log_error "Blocking problems found. Nothing was changed."
        exit 1
    fi

    log_info "System ready"
}

release_is_present() { checkout_exists || release_comes_from_the_package_manager; }

token_required() {
    release_is_present && registry_credentials_stored && return 1
    return 0
}

# Measured on a real machine: an install from before UT_DOMAIN existed has no
# such line, and names its address in every URL instead.
domain_named_by_the_urls() {
    local file=$1 key url
    for key in PUBLIC_BASE_URL DOMAIN_URL BACKEND_URL FRONTEND_URL_AUTH; do
        url=$(env_get "$file" "$key" 2>/dev/null || true)
        [[ -n "$url" ]] || continue
        url=${url#*://}; url=${url%%/*}; url=${url%%:*}
        [[ -n "$url" ]] || continue
        printf '%s' "$url"
        return 0
    done
    return 1
}

domain_written_in() {
    local file=$1 named
    named=$(env_get "$file" UT_DOMAIN 2>/dev/null || true)
    if [[ -n "$named" ]]; then printf '%s' "$named"; return 0; fi
    domain_named_by_the_urls "$file"
}

# The address is read before the settings are written, so /etc is still empty
# here on a machine moving off a checkout.
configured_domain() {
    local found previous
    found=$(domain_written_in "$INSTALL_DIR/.env" 2>/dev/null || true)
    if [[ -n "$found" ]]; then printf '%s' "$found"; return 0; fi
    previous=$(settings_of_a_previous_install 2>/dev/null) || return 0
    domain_written_in "$previous" 2>/dev/null || true
}

domain_to_check() {
    local candidate="$DOMAIN"
    [[ -n "$candidate" ]] || candidate=$(configured_domain)
    printf '%s' "${candidate:-$FALLBACK_DOMAIN}"
}

# A terminal on stdin does not imply a controlling terminal: a process started
# without one has an open /dev/tty node that cannot be opened.
terminal_is_reachable() { ( exec 3<> /dev/tty ) 2>/dev/null; }

describe_domain() {
    case "$1" in
        *.local)
            log_warn "${1} is mDNS-only: it does not cross a router, and no"
            log_warn "public authority certifies it — every machine will need the root installed" ;;
        *)
            log_info "${1} — publish its six names in your DNS, see docs/certificates-and-dns.md" ;;
    esac
}

read_domain() {
    [[ -n "$DOMAIN" ]] && return 0

    local current suggested
    current=$(configured_domain)
    suggested="${current:-$FALLBACK_DOMAIN}"

    if [[ ! -t 0 ]]; then
        DOMAIN="$suggested"
        if [[ -n "$current" ]]; then
            log_info "No --domain given and no terminal to ask on — keeping ${DOMAIN}"
        else
            log_warn "No --domain given and no terminal to ask on — using ${DOMAIN}"
            describe_domain "$DOMAIN"
        fi
        return 0
    fi

    log_step "The address this appliance answers on"
    log "  A name from the customer's DNS zone lets browsers trust it without"
    log "  installing anything on their machines. See docs/certificates-and-dns.md."
    log ""
    if [[ -n "$current" ]]; then
        log "  Leave empty to keep ${current}, which this machine already answers on."
    else
        log "  Leave empty to use ${FALLBACK_DOMAIN}, which works on a flat local"
        log "  network and nowhere else."
    fi
    log ""
    local answer=""
    if terminal_is_reachable; then
        printf '  Domain [%s]: ' "$suggested" > /dev/tty
        read -r answer < /dev/tty || answer=""
    else
        printf '  Domain [%s]: ' "$suggested"
        read -r answer || answer=""
    fi
    DOMAIN="${answer:-$suggested}"

    describe_domain "$DOMAIN"
}

read_token() {
    [[ -n "$REGISTRY_TOKEN" ]] && return 0

    if [[ -n "$TOKEN_FILE" ]]; then
        [[ -r "$TOKEN_FILE" ]] || die "Token file not readable: ${TOKEN_FILE}"
        REGISTRY_TOKEN=$(tr -d '\r\n' < "$TOKEN_FILE")
    elif token_required; then
        terminal_is_reachable \
            || die "A registry token is needed and there is no terminal to ask on. Pass --token-file, or set UT_REGISTRY_TOKEN."
        printf 'Registry token for %s (input hidden): ' "$REGISTRY_USER" > /dev/tty
        read -rs REGISTRY_TOKEN < /dev/tty
        printf '\n' > /dev/tty
    else
        log_info "Checkout and registry credentials already present — no token needed"
        return 0
    fi

    [[ -n "$REGISTRY_TOKEN" ]] || die "No registry token supplied."
}

license_tool() {
    local beside
    beside="$(dirname "${BASH_SOURCE[0]}")/ut-license"
    if [[ -x "$beside" ]]; then printf '%s' "$beside"; else printf 'ut-license'; fi
}

ask_for_license() {
    terminal_is_reachable \
        || die "A license key is needed and there is no terminal to ask on. Pass --license-file, or set UT_LICENSE."
    printf 'License key from UnderstandTech (input hidden): ' > /dev/tty
    read -rs LICENSE < /dev/tty
    printf '\n' > /dev/tty
    [[ -n "$LICENSE" ]] || die "No license key supplied."
}

take_license() {
    local tool key licensed_registry
    tool=$(license_tool)
    key=$(mktemp)
    chmod 600 "$key"
    if [[ -n "$LICENSE" ]]; then
        printf '%s\n' "$LICENSE" > "$key"
    else
        [[ -r "$LICENSE_FILE" ]] || { rm -f "$key"; die "License file not readable: ${LICENSE_FILE}"; }
        cat "$LICENSE_FILE" > "$key"
    fi
    if ! "$tool" check "$key"; then
        rm -f "$key"
        die "The license key was refused. Nothing was changed on this machine."
    fi
    REGISTRY_USER=$("$tool" field registry_user "$key")
    REGISTRY_TOKEN=$("$tool" field registry_token "$key")
    licensed_registry=$("$tool" field registry "$key" 2>/dev/null || true)
    if [[ -n "$licensed_registry" && -z "${UT_REGISTRY:-}" ]]; then
        REGISTRY=$licensed_registry
        log_info "Images come from ${REGISTRY}, the registry this license names"
    fi
    [[ -d "$(dirname "$LICENSE_STORE")" ]] || mkdir -p -m 750 "$(dirname "$LICENSE_STORE")"
    install -m 600 "$key" "$LICENSE_STORE"
    rm -f "$key"
}

read_credentials() {
    if [[ -n "$LICENSE" || -n "$LICENSE_FILE" ]]; then
        take_license
    elif [[ -n "$REGISTRY_TOKEN" || -n "$TOKEN_FILE" ]]; then
        log_warn "A registry token on its own is accepted by this version only. Ask UnderstandTech for a license key, and pass it with --license-file."
        read_token
    elif [[ -s "$LICENSE_STORE" ]]; then
        LICENSE_FILE=$LICENSE_STORE
        take_license
    elif token_required; then
        ask_for_license
        take_license
    else
        log_warn "No license key on this machine. The next version will ask for one: ask UnderstandTech for it."
    fi
}

step_registry_login() {
    if ! $DO_PULL; then
        log_step "Images are already here (--skip-pull): no registry login"
        return 0
    fi
    if [[ -z "$REGISTRY_TOKEN" ]]; then
        log_step "Registry credentials already stored"
        return 0
    fi

    log_step "Authenticating with the registry"

    printf '%s' "$REGISTRY_TOKEN" | docker login "$REGISTRY" -u "$REGISTRY_USER" --password-stdin >/dev/null \
        || die "Registry login failed. Check the token, or ask for a new one."
    log_info "root can pull private images"

    if [[ "$TARGET_USER" != "root" ]]; then
        if printf '%s' "$REGISTRY_TOKEN" | as_target_user docker login "$REGISTRY" -u "$REGISTRY_USER" --password-stdin >/dev/null 2>&1; then
            log_info "${TARGET_USER} can pull private images"
        else
            log_warn "Could not store credentials for ${TARGET_USER}; updates will need sudo"
        fi
    fi
}

clone_without_persisting_token() {
    # The helper references the variables by name instead of expanding them, so
    # the token reaches git through the environment and never appears in the
    # process table, the shell history, or .git/config.
    UT_REGISTRY_USER="$REGISTRY_USER" UT_REGISTRY_TOKEN="$REGISTRY_TOKEN" \
    git -c 'credential.helper=!f() { printf "username=%s\npassword=%s\n" "$UT_REGISTRY_USER" "$UT_REGISTRY_TOKEN"; }; f' \
        clone --quiet --branch "$REPO_REF" "$REPO_URL" "$INSTALL_DIR"
}

assert_token_absent_from_git_config() {
    [[ -n "$REGISTRY_TOKEN" ]] || return 0
    grep -q "$REGISTRY_TOKEN" "$INSTALL_DIR/.git/config" 2>/dev/null \
        && die "The token leaked into .git/config — refusing to continue."
    return 0
}

step_fetch_repo() {
    log_step "Fetching the deployment files"

    if release_comes_from_the_package_manager; then
        log_info "Release installed by the package at ${INSTALL_DIR}"
        log_info "Updates come from 'apt upgrade understandtech', not from here"
        return 0
    fi

    if checkout_exists; then
        if $DO_UPDATE; then
            ( cd "$INSTALL_DIR"
              git fetch --quiet origin "$REPO_REF"
              git checkout --quiet "$REPO_REF"
              git reset --quiet --hard "origin/${REPO_REF}" )
            log_info "Updated to ${REPO_REF} ($(cd "$INSTALL_DIR" && git rev-parse --short HEAD))"
        else
            log_info "Checkout already present ($(cd "$INSTALL_DIR" && git rev-parse --short HEAD)) — use --update to refresh"
        fi
        return 0
    fi

    [[ -e "$INSTALL_DIR" && -n "$(ls -A "$INSTALL_DIR" 2>/dev/null)" ]] \
        && die "${INSTALL_DIR} exists and is not a checkout. Move it aside first."

    mkdir -p "$(dirname "$INSTALL_DIR")"
    clone_without_persisting_token || die "Clone failed. Check the token and the network."
    assert_token_absent_from_git_config

    log_info "Cloned ${REPO_REF} into ${INSTALL_DIR}"
}

# Whatever it looks like, the password a machine was installed with is the
# password of its database: mongo only reads it when it creates the volume.
settings_carry_database_credentials() {
    local env_file=$1
    [[ -n "$(env_get "$env_file" MONGODB_PASSWORD || true)" ]]
}

# Generating a new password here would not reach the database — mongo reads it
# once, when it creates its data directory — so the stack would start and fail
# to connect, with nothing saying why.
die_on_a_database_nobody_has_the_password_for() {
    local env_file=$1 prefix volume
    prefix=$(env_get "$env_file" RESOURCE_PREFIX 2>/dev/null || true)
    volume="${prefix:-ut}-mongodb-data"

    log_error "A database volume is already here, and ${env_file} holds no password for it."
    log_error "  volume: ${volume}"
    log_error ""
    log_error "Either put the password this database was created with back into"
    log_error "MONGODB_USERNAME and MONGODB_PASSWORD, or discard the volume and"
    log_error "everything in it:"
    log_error ""
    log_error "  docker volume rm ${volume}"
    exit 1
}

generate_database_credentials() {
    local env_file=$1 local_file=$2 user

    # The mongo image only reads MONGO_INITDB_ROOT_PASSWORD when it creates the
    # data directory. Rotating it later changes nothing in the database and just
    # stops every service from connecting.
    if database_already_initialised "$env_file"; then
        settings_carry_database_credentials "$local_file" \
            || die_on_a_database_nobody_has_the_password_for "$local_file"
        log_info "Database already initialised — leaving its credentials alone"
        return 0
    fi

    if ! is_shipped_placeholder "$(env_get "$local_file" MONGODB_PASSWORD || true)"; then
        log_info "Database credentials already set"
        return 0
    fi

    user=$(env_get "$local_file" MONGODB_USERNAME || true)
    [[ -z "$user" || "$user" == "mongoadmin" ]] && user="ut$(random_alphanumeric 8)"
    env_set "$local_file" MONGODB_USERNAME "$user"
    env_set "$local_file" MONGODB_PASSWORD "$(random_alphanumeric 32)"
    log_info "Generated database credentials"
}

generate_application_secrets() {
    local local_file=$1 key rotated=()

    for key in "${GENERATED_SECRET_KEYS[@]}"; do
        if is_shipped_placeholder "$(env_get "$local_file" "$key" || true)"; then
            case "$key" in
                JWT_SECRET|BACKUP_FILES_PASSWORD|CA_PASSWORD) env_set "$local_file" "$key" "$(random_alphanumeric 64)" ;;
                APP_BUILDER_TOKEN_ENCRYPTION_KEY) env_set "$local_file" "$key" "$(random_fernet_key)" ;;
                *)                                env_set "$local_file" "$key" "$(random_alphanumeric 32)" ;;
            esac
            rotated+=("$key")
        fi
    done

    if (( ${#rotated[@]} == 0 )); then
        log_info "Secrets already set"
        return 0
    fi

    log_info "Generated: ${rotated[*]}"
    [[ " ${rotated[*]} " == *" JWT_SECRET "* ]] \
        && log_warn "JWT_SECRET was the shipped value — tokens were forgeable across deployments"
    return 0
}

# The release directory reaches the settings through a link into /etc, and GNU cp
# refuses to write through one whose target does not exist yet. Creating the
# target first is also what makes a second run a no-op.
create_settings_file_behind() {
    local link=$1 target
    [[ -L "$link" && ! -e "$link" ]] || return 0
    target=$(readlink "$link")
    install -d -m 750 "$(dirname "$target")"
    install -m 600 /dev/null "$target"
}

settings_directory() {
    local link=$1
    if [[ -L "$link" ]]; then
        dirname "$(readlink "$link")"
    else
        dirname "$link"
    fi
}

key_is_overridden_locally() {
    local key=$1 overridden=$2
    printf '%s\n' "$overridden" | grep -qx "$key"
}

# An install that predates the package keeps its settings inside its checkout,
# where /etc/understandtech never looks.
checkouts_holding_settings() {
    local candidate home
    home=$(eval echo "~${TARGET_USER}" 2>/dev/null || echo /root)
    for candidate in "$CHECKOUT_INSTALL_DIR" "$home/understand-tech" "$home/ai-in-a-box"; do
        [[ -f "$candidate/.env" && ! -L "$candidate/.env" && -s "$candidate/.env" ]] || continue
        printf '%s\n' "$candidate/.env"
    done
}

settings_of_a_previous_install() {
    local found count
    if [[ -n "$FROM_CHECKOUT" ]]; then
        [[ -s "$FROM_CHECKOUT/.env" ]] || die "No .env in ${FROM_CHECKOUT}."
        printf '%s' "$FROM_CHECKOUT/.env"
        return 0
    fi
    found=$(checkouts_holding_settings)
    count=$(printf '%s' "$found" | grep -c . || true)
    (( count == 0 )) && return 1
    if (( count > 1 )); then
        log_error "More than one previous install holds settings:"
        printf '%s\n' "$found" | while IFS= read -r candidate; do log_error "  ${candidate}"; done
        die "Say which one with --from-checkout PATH, or move the ones you do not want."
    fi
    printf '%s' "$found"
}

# Lines are carried over verbatim, never re-quoted: GATEWAY_MODELS holds JSON
# inside single quotes, which env_set would rewrite as KEY="value" and corrupt.
migrate_existing_settings_into_local() {
    local env_file=$1 local_file=$2 release line key kept=0 diverged=0
    release="$INSTALL_DIR/release.env"

    [[ -s "$env_file" ]] || return 0
    [[ -s "$local_file" ]] && return 0

    install -m 600 "$env_file" "${local_file%/*}/env.before-split"
    install -m 600 /dev/null "$local_file"

    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            [A-Za-z_]*=*) key=${line%%=*} ;;
            *) continue ;;
        esac
        if grep -qxF "$line" "$release" 2>/dev/null; then continue; fi
        if grep -qE "^${key}=" "$release" 2>/dev/null; then diverged=$((diverged + 1)); fi
        printf '%s\n' "$line" >> "$local_file"
        kept=$((kept + 1))
    done < "$env_file"

    log_info "Split the settings: ${kept} kept as yours, ${diverged} of them differing from this release"
    log_info "The file as it was: ${local_file%/*}/env.before-split"
}

# Waiving the accelerator check is not enough to install: left alone, the release
# keeps COMPOSE_PROFILES="nim" and the stack still asks docker for an nvidia
# device it will not find. Measured on a machine with none: the engines are
# created, then `could not select device driver "nvidia"` stops the install after
# the images have already been pulled.
#
# It goes to local.env, which render_settings lets win over release.env, so an
# operator who wrote these two by hand keeps exactly what they chose.
write_the_settings_a_machine_without_an_accelerator_needs() {
    local local_file=$1 compose_files

    compose_files=$(env_get "$local_file" COMPOSE_FILE 2>/dev/null || true)
    [[ -n "$compose_files" ]] || compose_files=$(release_declares COMPOSE_FILE || echo "compose.yaml")

    case "$compose_files" in
        *compose.no-gpu.yaml*) ;;
        *) env_set "$local_file" COMPOSE_FILE "${compose_files}:compose.no-gpu.yaml" ;;
    esac

    if [[ "$(env_get "$local_file" COMPOSE_PROFILES 2>/dev/null || true)" != "" ]] \
        || [[ -n "$(release_declares COMPOSE_PROFILES || true)" ]]; then
        env_set "$local_file" COMPOSE_PROFILES ""
    fi

    log_info "Inference left to another machine: no engine is started here"

    if the_inference_url_names_a_service_this_machine_will_not_run; then
        log_warn "VLLM_LLM_BASE_URL still names ${INTERNAL_INFERENCE_HOST}, an engine this"
        log_warn "  machine no longer starts. The platform will come up and answer nothing"
        log_warn "  a model has to write. Point it at a machine that serves inference:"
        log_warn "    echo 'VLLM_LLM_BASE_URL=\"https://<that machine>/v1\"' | sudo tee -a ${local_file}"
    fi
}

BACKUP_DESTINATION_MARKER=".understandtech-backup-destination"

filesystem_of_the_nearest_existing() {
    local path=$1
    while [[ ! -e "$path" && "$path" != "/" ]]; do path=$(dirname "$path"); done
    stat -c %d "$path"
}

the_backup_destination_is_off_this_machine() {
    local filesystem
    filesystem=$(stat -c %d "$1")
    [[ "$filesystem" != "$(stat -c %d /)" && "$filesystem" != "$(filesystem_of_the_nearest_existing "$DATA_DIR")" ]]
}

die_on_a_backup_destination_that_is_not_one() {
    local destination=$1 reason=$2
    log_error "BACKUP_FILES_DESTINATION is ${destination}, and ${reason}."
    log_error ""
    log_error "Either mount the share or the disk there, or empty BACKUP_FILES_DESTINATION"
    log_error "to keep the backup on this machine:"
    log_error ""
    log_error "  sudoedit $(settings_directory "$INSTALL_DIR/.env")/local.env"
    exit 1
}

backup_destination_problem() {
    local destination=$1
    if [[ "$destination" != /* || ! -d "$destination" ]]; then
        echo "it is not an existing directory given by its full path"
    elif ! the_backup_destination_is_off_this_machine "$destination"; then
        echo "it sits on this machine's own disk: nothing is mounted there"
    elif ! touch "$destination/$BACKUP_DESTINATION_MARKER" 2>/dev/null; then
        echo "it cannot be written to"
    fi
}

die_on_two_backup_destinations() {
    local local_file=$1 repository
    repository=$(env_get "$local_file" BACKUP_FILES_REPOSITORY 2>/dev/null || true)
    the_backup_repository_is_reached_over_the_network "$repository" || return 0
    [[ -n "$(env_get "$local_file" BACKUP_FILES_DESTINATION 2>/dev/null || true)" ]] || return 0
    log_error "BACKUP_FILES_DESTINATION and BACKUP_FILES_REPOSITORY both say where the backup goes."
    log_error ""
    log_error "Keep one of them in $(settings_directory "$INSTALL_DIR/.env")/local.env: a disk the host"
    log_error "mounts, or ${repository%%:*} over the network."
    exit 1
}

# A destination on the root disk, or on the one holding DATA_ROOT, is either a
# mount point with nothing mounted yet or no destination at all: the backup
# would die with the machine. The marker is what files-backup looks for before
# each run, so it is only written once that has been ruled out. A destination
# accepted before and gone now stops nothing: files-backup refuses to write
# without the marker, and an update has no reason to wait for a NAS.
write_the_settings_a_backup_destination_needs() {
    local local_file=$1 destination compose_files problem

    destination=$(env_get "$local_file" BACKUP_FILES_DESTINATION 2>/dev/null || true)
    compose_files=$(env_get "$local_file" COMPOSE_FILE 2>/dev/null || true)
    [[ -n "$compose_files" ]] || compose_files=$(release_declares COMPOSE_FILE || echo "compose.yaml")

    if [[ -z "$destination" ]]; then
        case "$compose_files" in
            *:compose.backup-mount.yaml*)
                env_set "$local_file" COMPOSE_FILE "${compose_files//:compose.backup-mount.yaml/}"
                log_info "Backups kept on this machine again" ;;
        esac
        return 0
    fi

    problem=$(backup_destination_problem "$destination")
    if [[ -n "$problem" ]]; then
        case "$compose_files" in
            *compose.backup-mount.yaml*)
                log_warn "BACKUP_FILES_DESTINATION is ${destination}, and ${problem}."
                log_warn "  The install goes on; the backup writes nothing until it is back."
                return 0 ;;
        esac
        die_on_a_backup_destination_that_is_not_one "$destination" "$problem"
    fi

    case "$compose_files" in
        *compose.backup-mount.yaml*) ;;
        *) env_set "$local_file" COMPOSE_FILE "${compose_files}:compose.backup-mount.yaml" ;;
    esac
    log_info "Backups go to ${destination}, off this machine's disk"
}

the_backup_repository_is_reached_over_the_network() {
    case "$1" in
        s3:*|sftp:*|rest:*|b2:*|azure:*|gs:*|swift:*|rclone:*) return 0 ;;
        *) return 1 ;;
    esac
}

sftp_host_of() {
    local address=${1#sftp:}
    address=${address#//}
    address=${address#*@}
    address=${address%%[:/]*}
    printf '%s' "$address"
}

# The overlay gives files-backup a network with a gateway, and Docker cannot
# narrow it to one destination: it is only added when the repository needs it.
write_the_settings_a_backup_over_the_network_needs() {
    local local_file=$1 repository compose_files ssh_dir host

    repository=$(env_get "$local_file" BACKUP_FILES_REPOSITORY 2>/dev/null || true)
    compose_files=$(env_get "$local_file" COMPOSE_FILE 2>/dev/null || true)
    [[ -n "$compose_files" ]] || compose_files=$(release_declares COMPOSE_FILE || echo "compose.yaml")

    if ! the_backup_repository_is_reached_over_the_network "$repository"; then
        case "$compose_files" in
            *:compose.backup-network.yaml*)
                env_set "$local_file" COMPOSE_FILE "${compose_files//:compose.backup-network.yaml/}"
                log_info "The backup service has no way off this machine again" ;;
        esac
        return 0
    fi

    case "$compose_files" in
        *compose.backup-network.yaml*) ;;
        *) env_set "$local_file" COMPOSE_FILE "${compose_files}:compose.backup-network.yaml" ;;
    esac
    ssh_dir=$(env_get "$local_file" BACKUP_FILES_SSH_DIR 2>/dev/null || true)
    if [[ -z "$ssh_dir" ]]; then
        ssh_dir="$(settings_directory "$INSTALL_DIR/.env")/backup-ssh"
        env_set "$local_file" BACKUP_FILES_SSH_DIR "$ssh_dir"
    fi
    install -d -m 700 "$ssh_dir"
    log_warn "The backup service can now reach the network, to send to ${repository%%:*}."

    [[ "$repository" == sftp:* ]] || return 0
    host=$(sftp_host_of "$repository")
    if [[ ! -s "$ssh_dir/known_hosts" ]] || ! grep -q "$host" "$ssh_dir/known_hosts"; then
        log_warn "  But no host key is pinned for ${host}, so every backup will be refused."
        log_warn "  Check the fingerprint with whoever runs ${host}, then:"
        log_warn "    ssh-keyscan ${host} | sudo tee ${ssh_dir}/known_hosts"
    fi
    if [[ ! -s "$ssh_dir/id_ed25519" ]]; then
        log_warn "  And no key to log in with. Make one, and give ${host} its public half:"
        log_warn "    sudo ssh-keygen -t ed25519 -N '' -f ${ssh_dir}/id_ed25519"
    fi
}

INTERNAL_INFERENCE_HOST=""

# The release points VLLM_LLM_BASE_URL at nim-llm, a service on this machine's
# own compose network. On a control plane that service is never started, so the
# default is not a remote address waiting to be used — it is a dead one, and the
# summary would otherwise announce it as the source of inference.
the_inference_url_names_a_service_this_machine_will_not_run() {
    local url host
    # Read in the order render_settings resolves them, and local.env before the
    # release: on a first install .env does not exist yet, and an operator who
    # prepared local.env beforehand would otherwise be told their address is the
    # dead default.
    url=$(env_get "$INSTALL_DIR/.env" VLLM_LLM_BASE_URL 2>/dev/null || true)
    [[ -n "$url" ]] || url=$(env_get "$(settings_directory "$INSTALL_DIR/.env")/local.env" VLLM_LLM_BASE_URL 2>/dev/null || true)
    [[ -n "$url" ]] || url=$(release_declares VLLM_LLM_BASE_URL || true)
    host=${url#*://}; host=${host%%/*}; host=${host%%:*}
    INTERNAL_INFERENCE_HOST="$host"
    case "$host" in
        nim-llm|nim-vlm|llm|localhost|127.0.0.1|"") return 0 ;;
        *) return 1 ;;
    esac
}

# Compose reads .env from the project directory and interpolates ${} from it, so
# it has to stay one flat file — a list of sources would not be read at all.
# The registry keeps every image under the path it has on its own registry,
# Docker Hub's short names under library/, so a byte-for-byte copy keeps the
# digest release.env pins.
image_in_registry() {
    local reference=$1 first
    if [[ "$reference" == */* ]]; then
        first=${reference%%/*}
        case "$first" in
            *.*|*:*|localhost) reference=${reference#*/} ;;
        esac
    else
        reference="library/${reference}"
    fi
    printf '%s/%s' "$REGISTRY" "$reference"
}

render_settings() {
    local target=$1 local_file=$2 release key line overridden tmp
    release="$INSTALL_DIR/release.env"
    [[ -f "$release" ]] || die "No release.env in ${INSTALL_DIR}."

    overridden=$(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "$local_file" 2>/dev/null | tr -d '=' || true)
    tmp=$(mktemp)
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            [A-Za-z_]*=*)
                key=${line%%=*}
                if key_is_overridden_locally "$key" "$overridden"; then continue; fi
                if [[ "$REGISTRY" != "ghcr.io" && "$line" =~ ^[A-Z0-9_]+_IMAGE=\"(.+)\"$ ]]; then
                    line="${key}=\"$(image_in_registry "${BASH_REMATCH[1]}")\""
                fi
                ;;
        esac
        printf '%s\n' "$line" >> "$tmp"
    done < "$release"

    if [[ -s "$local_file" ]]; then
        printf '\n# ---------------------------------------------- yours, never replaced ----\n' >> "$tmp"
        printf '# Edit %s, not this file: this one is rebuilt on every install.\n\n' "$local_file" >> "$tmp"
        cat "$local_file" >> "$tmp"
    fi

    cat "$tmp" > "$target"
    rm -f "$tmp"
}

step_configure() {
    log_step "Writing the configuration"

    local env_file="$INSTALL_DIR/.env" local_file
    create_settings_file_behind "$env_file"

    local_file="$(settings_directory "$env_file")/local.env"
    install -d -m 750 "$(dirname "$local_file")"
    [[ -f "$local_file" ]] || install -m 600 /dev/null "$local_file"
    local source_settings="$env_file" previous
    if [[ ! -s "$env_file" ]] && previous=$(settings_of_a_previous_install); then
        source_settings="$previous"
        log_info "Settings taken from ${previous} — that checkout is left as it is"
    fi
    migrate_existing_settings_into_local "$source_settings" "$local_file"

    if [[ "$(env_get "$local_file" UT_DOMAIN || true)" != "$DOMAIN" ]]; then
        env_set "$local_file" UT_DOMAIN "$DOMAIN"
        log_info "Address set to ${DOMAIN} — every other URL derives from it"
    fi

    $NO_GPU && write_the_settings_a_machine_without_an_accelerator_needs "$local_file"
    die_on_two_backup_destinations "$local_file"
    write_the_settings_a_backup_destination_needs "$local_file"
    write_the_settings_a_backup_over_the_network_needs "$local_file"

    render_settings "$env_file" "$local_file"
    generate_database_credentials "$env_file" "$local_file"
    generate_application_secrets "$local_file"
    give_the_api_the_openai_key_it_needs_to_start "$env_file" "$local_file"
    render_settings "$env_file" "$local_file"

    chmod 600 "$env_file" "$local_file"
    chown "$TARGET_USER" "$env_file" "$local_file" 2>/dev/null || true

    mkdir -p "$DATA_DIR/app-data" "$DATA_DIR/appbuilder"/{workspaces,prod-workspaces,traefik-dynamic}
    log_info "Data directories ready under ${DATA_DIR}"
}

# The platform's API builds its OpenAI client while it loads its modules, from
# OA_KEY, so an empty value is an exception rather than a disabled feature: the
# container restarts forever and the eight services that depend on it never
# start. Measured on a bare install, 2026-09-21 — thirty-five restarts before
# anyone read far enough up the Python traceback to find the name.
#
# Any value that is not empty keeps it up — the client is built, never called —
# and a key the operator gives in local.env is never replaced.
give_the_api_the_openai_key_it_needs_to_start() {
    local env_file=$1 local_file=$2
    [[ -n "$(env_get "$env_file" OA_KEY 2>/dev/null || true)" ]] && return 0
    env_set "$local_file" OA_KEY "not-configured"
    log_info "OA_KEY set to \"not-configured\": the platform API does not start without a value"
    log_info "  A real OpenAI key, if one is ever needed, goes in ${local_file}"
}

step_check_resolution() {
    log_step "Checking how ${DOMAIN} resolves"

    if [[ "$DOMAIN" == *.local ]]; then
        log_warn "${DOMAIN} is an mDNS name: it only resolves on this network"
        log_warn "  segment. A box in a datacentre will be unreachable — use a"
        log_warn "  domain from the customer's DNS zone instead."
        command -v avahi-daemon >/dev/null 2>&1 \
            || log_warn "  avahi is not installed, so nothing publishes it either."
        return 0
    fi

    if getent hosts "$DOMAIN" >/dev/null 2>&1; then
        log_info "${DOMAIN} resolves"
    else
        log_warn "${DOMAIN} does not resolve yet. Two records are needed:"
        log_warn "    ${DOMAIN}.      A   <this machine's address>"
        log_warn "    *.${DOMAIN}.    A   <this machine's address>"
        log_warn "  The wildcard covers the satellite apps and every generated app."
    fi
}

step_docker_group() {
    log_step "Granting Docker access"

    if [[ "$TARGET_USER" == "root" ]]; then
        log_info "Running as root — nothing to grant"
        return 0
    fi

    if id -nG "$TARGET_USER" | tr ' ' '\n' | grep -qx docker; then
        log_info "${TARGET_USER} is already in the docker group"
        return 0
    fi

    usermod -aG docker "$TARGET_USER"
    log_info "Added ${TARGET_USER} to the docker group"
    log_warn "${TARGET_USER} must log out and back in before running docker unprivileged"
}

# step-ca runs as uid 1000 and writes its root into this directory on first
# start. Left to docker, the bind mount is created root-owned under a
# root-owned DATA_ROOT, and the container exits on "Permission denied" before
# issuing anything.
step_certificate_authority_root() {
    log_step "Preparing the certificate authority directory"

    local data_root ca_dir
    data_root=$(env_get "$INSTALL_DIR/.env" DATA_ROOT 2>/dev/null || true)
    ca_dir="${data_root:-/var/lib/understandtech}/ca"

    if [[ -d "$ca_dir" ]]; then
        log_info "Authority directory already present at ${ca_dir}"
        return 0
    fi

    install -d -o "$STEP_CA_UID" -g "$STEP_CA_UID" -m 700 "$ca_dir" \
        || die "Could not create ${ca_dir}"
    log_info "Created ${ca_dir}, readable only by the authority"
}

# step-ca ships with 24-hour certificates and allowRenewalAfterExpiry off, and
# exposes neither through its init variables. Left alone, an appliance switched
# off over a weekend comes back with an expired certificate the authority
# refuses to renew, and needs a hand on site.
step_certificate_policy() {
    log_step "Applying the certificate policy"

    local current
    current=$(compose_in_dir exec -T step-ca sh -c \
        'jq -r ".authority.provisioners[0].claims.defaultTLSCertDuration // empty" /home/step/config/ca.json' 2>/dev/null | tr -d '\r')

    if [[ "$current" == "$CA_CERT_DURATION" ]]; then
        log_info "Already ${CA_CERT_DURATION}, renewable after expiry"
        return 0
    fi

    compose_in_dir exec -T step-ca sh -c "
        cd /home/step/config
        jq '(.authority.provisioners[]) |= (.claims = {
              minTLSCertDuration: \"5m\",
              defaultTLSCertDuration: \"${CA_CERT_DURATION}\",
              maxTLSCertDuration: \"${CA_CERT_DURATION}\",
              allowRenewalAfterExpiry: true })' ca.json > ca.new && mv ca.new ca.json
    " >/dev/null 2>&1 || { log_warn "Could not apply the certificate policy"; return 0; }

    compose_in_dir restart step-ca >/dev/null 2>&1
    log_info "Certificates last ${CA_CERT_DURATION} and renew after expiry"
}

step_networks() {
    log_step "Preparing Docker networks"

    if ! appbuilder_enabled; then
        log_info "App Builder disabled — no extra network needed"
        return 0
    fi

    if docker network inspect proxy >/dev/null 2>&1; then
        log_info "Network 'proxy' already present"
    else
        docker network create proxy >/dev/null
        log_info "Created network 'proxy' — the App Builder overlay declares it external"
    fi
}

compose_reports_progress_as_json() { compose_in_dir --progress json version >/dev/null 2>&1; }

images_the_release_runs() { compose_in_dir config --images 2>/dev/null | sort -u | grep -c . || true; }

say_each_image_as_it_lands() {
    local total=$1 started=$SECONDS landed=0 line image
    (( total > 0 )) || total="?"
    while IFS= read -r line; do
        [[ "$line" == "{"* ]] || { log "$line"; continue; }
        if [[ "$line" == *'"error":true'* ]]; then
            log_error "$(sed -n 's/.*"message":"\(.*\)"}$/\1/p' <<< "$line")"
            continue
        fi
        [[ "$line" == *'"id":"Image '* ]] || continue
        image=${line#*\"id\":\"Image }
        image=${image%%\"*}
        case "$line" in
            *'"status":"Done"'*)
                landed=$((landed + 1))
                log "     ${landed}/${total}  ${image}  ($(( (SECONDS - started) / 60 )) min)"
                ;;
            *'"status":"Error"'*)
                log_error "${image}: $(sed -n 's/.*"text":"\([^"]*\)".*/\1/p' <<< "$line")"
                ;;
        esac
    done
}

# Compose draws its progress bars only on a terminal, and start_logging sends
# everything through tee: without JSON, a pull of tens of GB shows "0B" per layer.
# The JSON comes on stderr, beside any error that is not JSON.
step_pull() {
    if ! $DO_PULL; then
        log_step "Skipping image download (--skip-pull)"
        return 0
    fi
    log_step "Downloading images"
    log "     First run downloads several tens of GB. This is the long part."
    if compose_reports_progress_as_json; then
        compose_in_dir --progress json pull 2>&1 | say_each_image_as_it_lands "$(images_the_release_runs)" \
            || die "Image pull failed. Check the token and the network."
    else
        compose_in_dir pull || die "Image pull failed. Check the token and the network."
    fi
    log_info "Images present locally"
}

# As the boot service does: a service the release stopped declaring is removed,
# rather than left holding the GPU memory its replacement now asks for.
step_start() {
    log_step "Starting services"
    compose_in_dir up -d --remove-orphans
    log_info "Containers created"
}

container_health_lines() {
    local container_id
    compose_in_dir ps -q 2>/dev/null | while read -r container_id; do
        [[ -n "$container_id" ]] || continue
        docker inspect --format \
            '{{.Name}}|{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}|{{index .Config.Labels "ut.role"}}' \
            "$container_id" 2>/dev/null || true
    done
}

# An unlabelled container is waited for. A compose file written before roles
# existed then behaves exactly as it did, which is what an installed machine
# replaying ut-install expects.
role_is_waited_for() {
    [[ "$1" != "inference" && "$1" != "backup" ]]
}

step_wait_healthy() {
    log_step "Waiting for the platform to become ready"
    log "     Inference engines load their models in the background and are not"
    log "     waited for; the platform is usable before they answer."
    log "     Waiting up to $((HEALTH_TIMEOUT / 60)) minutes for everything else."

    local deadline=$(( SECONDS + HEALTH_TIMEOUT ))
    local pending loading failed backup name status health role line

    while (( SECONDS < deadline )); do
        pending=""
        loading=""
        failed=""
        backup=""
        while IFS='|' read -r name status health role; do
            [[ -n "$name" ]] || continue
            name=${name#/}
            case "$health" in
                healthy) continue ;;
                none)    [[ "$status" == "running" ]] && continue ;;
            esac
            if role_is_waited_for "$role"; then
                pending+="  ${name}: ${status}/${health}"$'\n'
            elif [[ "$role" == "backup" ]]; then
                backup+="  ${name}: ${status}/${health}"$'\n'
            elif [[ "$health" == "starting" ]]; then
                loading+="  ${name}: ${status}/${health}"$'\n'
            else
                failed+="  ${name}: ${status}/${health}"$'\n'
            fi
        done < <(container_health_lines)

        if [[ -z "$pending" ]]; then
            printf '\r\033[K'
            log_info "The platform is ready"
            report_inference_still_loading "$loading"
            report_backup_not_working "$backup"
            report_inference_that_failed "$failed" && return 0
            return 1
        fi

        printf '\r%s     %d service(s) still starting: %s (%dm elapsed)%s\033[K' \
            "$YELLOW" "$(printf '%s' "$pending" | grep -c .)" "$(names_in "$pending")" \
            "$(( SECONDS / 60 ))" "$NC"
        sleep 15
    done

    printf '\r\033[K'
    log_warn "Timed out after $((HEALTH_TIMEOUT / 60)) minutes. Still not ready:"
    printf '%s' "$pending" | while IFS= read -r line; do [[ -n "$line" ]] && log_warn "$line"; done
    log_warn "Inspect one with: cd ${INSTALL_DIR} && docker compose logs <service>"
    return 0
}

# A count tells the operator to keep waiting; a name tells them what to look at.
names_in() {
    local block=$1 line names=""
    printf '%s' "$block" | while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        line=${line#  }
        printf '%s ' "${line%%:*}"
    done | sed 's/ $//; s/ /, /g'
}

report_inference_still_loading() {
    local loading=$1 line
    [[ -n "$loading" ]] || return 0
    INFERENCE_STILL_LOADING=$(names_in "$loading")
    log ""
    log "     Inference is not ready yet, and the platform does not wait for it:"
    printf '%s' "$loading" | while IFS= read -r line; do [[ -n "$line" ]] && log "  ${line# }"; done
    log "     Follow it with: cd ${INSTALL_DIR} && sudo docker compose ps"
}

# A destination that is not mounted, does not answer or does not open with this
# machine's password held the install for an hour before; the users do not need
# the backup to start working, the operator needs to know it does not.
report_backup_not_working() {
    local backup=$1 line name reason
    [[ -n "$backup" ]] || return 0
    log_warn ""
    log_warn "The backup is not working yet, and the platform does not wait for it:"
    printf '%s' "$backup" | while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        log_warn "  ${line# }"
        name=${line#  }
        name=${name%%:*}
        reason=$(docker logs --tail 20 "$name" 2>&1 | grep -F '[files-backup]' | tail -1)
        [[ -z "$reason" ]] || log_warn "    ${reason#*\[files-backup\] }"
    done
    log_warn "  cd ${INSTALL_DIR} && docker compose logs files-backup mongodb-backup"
}

# Saying "still loading" about a container that has already failed would be the
# fourth way this installer has claimed success it did not have. A model that is
# loading reports starting; one that gave up reports unhealthy, and the two must
# not leave by the same door.
report_inference_that_failed() {
    local failed=$1 line
    [[ -n "$failed" ]] || return 0
    log_error ""
    log_error "Inference did not start. The platform is up, the models are not:"
    printf '%s' "$failed" | while IFS= read -r line; do [[ -n "$line" ]] && log_error "  ${line# }"; done
    log_error "  cd ${INSTALL_DIR} && docker compose logs nim-llm"
    return 1
}

step_autostart() {
    if ! $DO_AUTOSTART; then
        log_step "Skipping boot service (--no-autostart)"
        return 0
    fi

    log_step "Installing the boot service and mDNS names"

    if [[ ! -x "$INSTALL_DIR/setup-autostart.sh" ]]; then
        log_warn "setup-autostart.sh not found — the stack will NOT restart after a reboot,"
        log_warn "and the satellite hostnames will not be published."
        return 0
    fi

    "$INSTALL_DIR/setup-autostart.sh" --install --dir "$INSTALL_DIR" \
        || log_warn "setup-autostart.sh reported a problem; re-run it manually"
    log_info "Boot service and mDNS publisher installed"
}

print_secrets_out_of_band() {
    local env_file=$1 admin_password backup_password
    if ! terminal_is_reachable; then
        log_info "No terminal here, so nothing was printed. The secrets are in $(settings_directory "$env_file")/local.env"
        return 0
    fi

    admin_password=$(env_get "$env_file" ADMIN_SETUP_PASSWORD 2>/dev/null || true)
    backup_password=$(env_get "$env_file" BACKUP_FILES_PASSWORD 2>/dev/null || true)

    if [[ -n "$admin_password" ]]; then
        printf '  %sInitial admin password%s  %s\n' "$BOLD" "$NC" "$admin_password" > /dev/tty
    fi

    if [[ -n "$backup_password" ]]; then
        printf '\n  %sBackup repository password%s  %s\n' "$BOLD" "$NC" "$backup_password" > /dev/tty
        printf '  %sWrite this down somewhere other than this machine.%s Losing it makes\n' "$YELLOW" "$NC" > /dev/tty
        printf '  every snapshot unreadable, including copies held off-site — there is\n' > /dev/tty
        printf '  no recovery path.\n' > /dev/tty
    fi

    printf '\n  (shown here only — stored in %s, never in the install log)\n\n' "$env_file" > /dev/tty
}

install_history() {
    local data_root
    data_root=$(env_get "$INSTALL_DIR/.env" DATA_ROOT 2>/dev/null || true)
    printf '%s/install-history.jsonl' "${data_root:-$DATA_DIR}"
}

# Failed runs are kept too: an install re-run until it works must not read as
# one that served the first time.
record_this_install() {
    local status=$? outcome="done" step="" release history
    if (( status != 0 )); then
        outcome="failed"
        step=${CURRENT_STEP//\"/}
    fi
    release=$(env_get "$INSTALL_DIR/release.env" UT_RELEASE_VERSION 2>/dev/null || true)
    history=$(install_history)
    mkdir -p "$(dirname "$history")" 2>/dev/null || return 0
    printf '{"at":"%s","tool":"ut-install","outcome":"%s","step":"%s","release":"%s"}\n' \
        "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$outcome" "$step" "${release:-unstamped}" \
        >> "$history" 2>/dev/null || true
}

reporting_already_decided() {
    local said
    said=$("$UT_SEND" status 2>/dev/null) || return 1
    [[ "$said" != "Reporting: not decided" ]]
}

# No answer is offered as the default: pressing Enter asks again.
ask_about_reporting() {
    local answer=""
    log_step "Usage reports"
    log "  This machine can send UnderstandTech, every 15 minutes, how loaded it was and"
    log "  how many people it served — counts, never content, never who. docs/usage-report.md"
    log "  lists every field. The answer can be changed later with ut-send configure."
    log ""
    while [[ "$answer" != "yes" && "$answer" != "no" ]]; do
        printf '  Send usage reports to UnderstandTech? (yes/no): '
        read -r answer || return 1
    done
    REPORTING=$answer
    [[ "$REPORTING" == "yes" ]] || return 0
    log "  Where they go can wait: leave a field empty to give it later."
    [[ -n "$REPORTING_RECEIVER" ]] || { printf '  Receiver address (https://…): '; read -r REPORTING_RECEIVER || true; }
    [[ -n "$REPORTING_TOKEN_FILE" ]] || { printf '  File holding this machine'"'"'s token: '; read -r REPORTING_TOKEN_FILE || true; }
    [[ -n "$REPORTING_RECEIVER_CERT" ]] || { printf '  File holding the receiver'"'"'s certificate: '; read -r REPORTING_RECEIVER_CERT || true; }
}

reporting_configure_arguments() {
    printf '%s\n' configure --consent "$REPORTING"
    [[ -n "$REPORTING_RECEIVER" ]] && printf '%s\n' --receiver "$REPORTING_RECEIVER"
    [[ -n "$REPORTING_TOKEN_FILE" ]] && printf '%s\n' --token-file "$REPORTING_TOKEN_FILE"
    [[ -n "$REPORTING_RECEIVER_CERT" ]] && printf '%s\n' --receiver-cert "$REPORTING_RECEIVER_CERT"
    [[ -n "$REPORTING_EVERY" ]] && printf '%s\n' --every "$REPORTING_EVERY"
    return 0
}

# Reporting never holds an install back: the platform serves whether or not this
# step works, and the operator is told how to finish it.
step_reporting() {
    local arguments=() line
    if ! command -v "$UT_SEND" >/dev/null 2>&1; then
        log_warn "ut-send is not installed here — usage reports stay off. A package install carries it."
        return 0
    fi
    if [[ -z "$REPORTING" && -n "${REPORTING_RECEIVER}${REPORTING_TOKEN_FILE}${REPORTING_RECEIVER_CERT}${REPORTING_EVERY}" ]]; then
        log_warn "Receiver details were given without --reporting yes — they are not taken as a yes, nothing changes"
        return 0
    fi
    if [[ -z "$REPORTING" ]]; then
        if reporting_already_decided; then
            log_info "$("$UT_SEND" status) — kept from an earlier answer"
            return 0
        fi
        if terminal_is_reachable; then
            ask_about_reporting < /dev/tty > /dev/tty || REPORTING="no"
        else
            REPORTING="no"
            log_info "No --reporting given and no terminal to ask on — usage reports stay off"
        fi
    fi
    [[ "$REPORTING" == "yes" || "$REPORTING" == "no" ]] || die "--reporting must be yes or no, not '${REPORTING}'"
    while IFS= read -r line; do arguments+=("$line"); done < <(reporting_configure_arguments)
    if "$UT_SEND" "${arguments[@]}"; then
        return 0
    fi
    log_warn "Usage reports could not be set up. The platform is unaffected; finish with: sudo ut-send configure --consent yes|no …"
}

print_summary() {
    local env_file="$INSTALL_DIR/.env" inference=""
    [[ -z "$INFERENCE_STILL_LOADING" ]] \
        || inference=$'\n'"  Inference      still loading: ${INFERENCE_STILL_LOADING} — the platform works meanwhile"

    cat <<EOF

${BOLD}Installation complete in $(( SECONDS / 60 )) min${NC}

  Open https://${DOMAIN} — the initial admin password printed below opens
  the first-run wizard: models, sign-on, data sources.

  Address        https://${DOMAIN}${inference}
  Directory      ${INSTALL_DIR}
  Configuration  ${env_file}   (0600, contains generated secrets)
  Role           $(role_this_machine_was_installed_as)

  Satellite apps  https://llms.${DOMAIN}
                  https://assistants.${DOMAIN}
                  https://admin.${DOMAIN}

  Your browser will warn about the certificate: it is issued by the
  appliance's own authority. To remove the warning on a machine, export
  and trust the root certificate:

    docker exec ut-caddy cat /data/caddy/pki/authorities/local/root.crt > ut-root-ca.crt

  Status         cd ${INSTALL_DIR} && docker compose ps
  Logs           cd ${INSTALL_DIR} && docker compose logs -f api
  Install log    ${LOG_FILE}

EOF

    print_secrets_out_of_band "$env_file"
}

start_logging() {
    mkdir -p "$(dirname "$LOG_FILE")"
    touch "$LOG_FILE"
    chmod 600 "$LOG_FILE"
    exec > >(tee -a "$LOG_FILE") 2>&1
    printf '\n===== ut-install %s =====\n' "$(date -Is)"
}

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check)          ACTION="check" ;;
            --no-gpu)         NO_GPU=true ;;
            --update)         DO_UPDATE=true ;;
            --no-autostart)   DO_AUTOSTART=false ;;
            --skip-pull)      DO_PULL=false ;;
            --license-file)   LICENSE_FILE="${2:?--license-file needs a path}"; shift ;;
            --token-file)     TOKEN_FILE="${2:?--token-file needs a path}"; shift ;;
            --dir)            INSTALL_DIR="${2:?--dir needs a path}"; shift ;;
            --from-checkout)  FROM_CHECKOUT="${2:?--from-checkout needs a path}"; shift ;;
            --domain)         DOMAIN="${2:?--domain needs a name}"; shift ;;
            --health-timeout) HEALTH_TIMEOUT="${2:?--health-timeout needs seconds}"; shift ;;
            --reporting)      REPORTING="${2:?--reporting needs yes or no}"; shift ;;
            --reporting-receiver)      REPORTING_RECEIVER="${2:?--reporting-receiver needs an address}"; shift ;;
            --reporting-token-file)    REPORTING_TOKEN_FILE="${2:?--reporting-token-file needs a path}"; shift ;;
            --reporting-receiver-cert) REPORTING_RECEIVER_CERT="${2:?--reporting-receiver-cert needs a path}"; shift ;;
            --reporting-every)         REPORTING_EVERY="${2:?--reporting-every needs minutes}"; shift ;;
            -h|--help)        usage; exit 0 ;;
            *)                log_error "Unknown option: $1"; usage; exit 2 ;;
        esac
        shift
    done
}

main() {
    parse_arguments "$@"
    resolve_install_dir

    if [[ "$ACTION" == "check" ]]; then
        DOMAIN=$(domain_to_check)
        preflight
        exit 0
    fi

    [[ $EUID -eq 0 ]] || die "Run with sudo: sudo $0"

    start_logging
    trap record_this_install EXIT
    preflight
    read_domain
    read_credentials
    step_registry_login
    step_fetch_repo
    step_configure
    step_check_resolution
    step_docker_group
    step_certificate_authority_root
    step_networks
    step_pull
    step_start
    step_wait_healthy
    step_certificate_policy
    step_autostart
    step_reporting
    print_summary
}

# An `if` rather than `&&`: a false condition would otherwise be the script's
# exit status, so sourcing it for tests would fail under `set -e` — which is the
# one thing this guard exists to allow.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
