#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_SHARE_DIR="/usr/share/understandtech"
INSTALL_DIR="${UT_INSTALL_DIR:-}"

if [[ -t 1 ]]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; BOLD=""; NC=""
fi

log_info()  { printf '%s[ ok ]%s %s\n' "$GREEN" "$NC" "$*"; }
log_warn()  { printf '%s[warn]%s %s\n' "$YELLOW" "$NC" "$*"; }
log_error() { printf '%s[fail]%s %s\n' "$RED" "$NC" "$*" >&2; }
log_step()  { printf '\n%s==>%s %s%s%s\n' "$BOLD" "$NC" "$BOLD" "$*" "$NC"; }

usage() {
    cat <<'EOF'
Say whether an install is actually serving, rather than whether it started.

  ut-status                  check the install found in the usual places
  ut-status --dir PATH       check the one in PATH

Options
  --dir PATH   Install directory. Defaults to /usr/share/understandtech, then
               to the directory this script sits in.
  -h, --help   This message.

Exits non-zero when a service is unhealthy or a surface does not answer, so it
can be called from cron or a check.
EOF
}

resolve_install_dir() {
    [[ -n "$INSTALL_DIR" ]] && return 0
    if [[ -f "$PACKAGE_SHARE_DIR/compose.yaml" ]]; then
        INSTALL_DIR="$PACKAGE_SHARE_DIR"
    else
        INSTALL_DIR="$SCRIPT_DIR"
    fi
}

env_get() {
    local file=$1 key=$2 line
    line=$(grep -m1 -E "^${key}=" "$file" 2>/dev/null) || return 1
    line=${line#*=}; line=${line%\"}; line=${line#\"}
    printf '%s' "$line"
}

compose_here() { ( cd "$INSTALL_DIR" && docker compose "$@" ); }

# A service with no healthcheck reports its container state instead, which is
# the most that can be said about it: the four workers are queue consumers and
# declare none.
services_that_are_not_serving() {
    local id name state
    while read -r id; do
        [[ -n "$id" ]] || continue
        name=$(docker inspect -f '{{.Name}}' "$id" 2>/dev/null | sed 's|^/||')
        state=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$id" 2>/dev/null)
        case "$state" in
            healthy|running) ;;
            *) printf '%s\t%s\n' "$name" "$state" ;;
        esac
    done <<< "$(compose_here ps -q 2>/dev/null)"
}

a_surface_answers() {
    local host=$1 path=$2 port=$3 address=$4 code
    code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 \
        --resolve "${host}:${port}:${address}" "https://${host}:${port}${path}" 2>/dev/null) || return 1
    [[ "$code" == "200" ]]
}

inference_is_served_from_elsewhere() {
    [[ "$(env_get "$INSTALL_DIR/.env" COMPOSE_FILE || true)" == *no-gpu* ]]
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dir)     INSTALL_DIR="${2:?--dir needs a path}"; shift ;;
            -h|--help) usage; exit 0 ;;
            *)         usage; exit 1 ;;
        esac
        shift
    done

    resolve_install_dir
    [[ -f "$INSTALL_DIR/compose.yaml" ]] || { log_error "No install in ${INSTALL_DIR}."; exit 1; }
    [[ -f "$INSTALL_DIR/.env" ]] || { log_error "No configuration in ${INSTALL_DIR} — was it ever installed?"; exit 1; }

    local domain port failing=0 stopped
    domain=$(env_get "$INSTALL_DIR/.env" UT_DOMAIN || echo "understand.local")
    port=$(env_get "$INSTALL_DIR/.env" UT_HTTPS_PORT || echo "443")

    log_step "Services"
    stopped=$(services_that_are_not_serving)
    if [[ -z "$stopped" ]]; then
        log_info "every service is healthy or running"
    else
        while IFS=$'\t' read -r name state; do
            [[ -n "$name" ]] || continue
            log_error "${name} is ${state}"
            log_error "  cd ${INSTALL_DIR} && docker compose logs --tail 40 ${name#*-}"
        done <<< "$stopped"
        failing=1
    fi

    # Resolved to the loopback rather than to whatever DNS says: this asks
    # whether the machine serves, not whether the network can find it.
    log_step "Surfaces, asked on this machine"
    local surface
    for surface in "${domain}:/" "admin.${domain}:/" "llms.${domain}:/" "assistants.${domain}:/" \
                   "${domain}:/api/docs" "${domain}:/api/v3/docs"; do
        local host=${surface%%:*} path=${surface#*:}
        if a_surface_answers "$host" "$path" "$port" "127.0.0.1"; then
            log_info "https://${host}${path}"
        else
            log_error "https://${host}${path} does not answer 200"
            failing=1
        fi
    done

    log_step "Inference"
    if inference_is_served_from_elsewhere; then
        local url
        url=$(env_get "$INSTALL_DIR/.env" VLLM_LLM_BASE_URL || true)
        log_warn "served from ${url:-nowhere named} — nothing on this machine generates"
        log_warn "  Anything asking a model to write will fail, and that is the installed role."
    else
        log_info "served by this machine"
    fi

    printf '\n'
    if (( failing )); then
        # The verdict goes to stdout, unlike the failures above it: an operator
        # pasting `ut-status > out 2>&1` gets the two streams interleaved by the
        # buffering, and a conclusion that lands mid-report reads as one more
        # line rather than as the answer.
        printf '%s[fail]%s The install is not serving. See docs/when-it-breaks.md.\n' "$RED" "$NC"
        exit 1
    fi
    log_info "The install is serving on https://${domain}"
}

main "$@"
