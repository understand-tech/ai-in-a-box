# What this release decides.
#
# The package owns this file and replaces it on every upgrade. Nothing here is
# yours to edit: your own settings live in /etc/understandtech/local.env, which
# the package never touches and which wins over every value below.
#
# What each setting does, what can be rotated and what cannot, how to enable the
# App Builder: docs/configuration.md. TLS modes and DNS names:
# docs/certificates-and-dns.md.

# ---------------------------------------------------------------- images -----
# Quarterly updates: change the tags and re-deploy.

LLM_IMAGE="ghcr.io/understand-tech/ut-llm-customers:2.0-arm64"
API_IMAGE="ghcr.io/understand-tech/ut-api-customer:2.0-arm64"
WORKER_IMAGE="ghcr.io/understand-tech/ut-worker-customer:2.0-arm64"
FRONTEND_IMAGE="ghcr.io/understand-tech/ut-frontendv2-customer:2.0-arm64"
API_CUSTOMER_IMAGE="ghcr.io/understand-tech/ut-api-rest-customer:2.0-arm64"
WORKER_CUSTOMER_IMAGE="ghcr.io/understand-tech/ut-worker-rest-customer:2.0-arm64"
LLMS_APP_IMAGE="ghcr.io/understand-tech/ut-app-llms-customer:2.0-arm64"
ADMIN_PORTAL_IMAGE="ghcr.io/understand-tech/ut-portal-customer:2.0-arm64"
ASSISTANTS_APP_IMAGE="ghcr.io/understand-tech/ut-app-assistants-customer:2.0-arm64"
APP_BUILDER_IMAGE="ghcr.io/understand-tech/agentic-app-builder-customer:2.0-arm64"
NIM_IMAGE="ghcr.io/understand-tech/nim/nvidia/model-free-nim:2.0.9"

# Republished under our own registry on 2026-09-18, after Docker Hub withdrew
# every versioned tag of tiredofit/db-backup. Upstream latest is not a way back:
# 1.44 MB against 1.93 GB, a static binary with no shell, so the CMD-SHELL
# health check cannot run at all.
DB_BACKUP_IMAGE="ghcr.io/understand-tech/db-backup:4.1.100@sha256:28c0451ac69f832beb1abc41be4a2143b2b03430e42c54602433876f090227fa"

# ------------------------------------------------------- address and TLS -----
# Six names derive from UT_DOMAIN and must resolve here; ut-install asks for it
# and the value below is only the fallback. See docs/certificates-and-dns.md.

UT_DOMAIN="understand.local"
UT_INGRESS_MODE="internal"
UT_PUBLIC_SCHEME="https"
UT_CADDY_SCHEME="https"

#UT_TRUSTED_PROXIES="10.42.0.0/16"
#UT_CERT_DIR="/etc/understandtech/certs"
#UT_APPS_CERT_FILE="/etc/caddy/certs/apps-fullchain.pem"
#UT_APPS_KEY_FILE="/etc/caddy/certs/apps-privkey.pem"
#UT_HTTP_PORT="80"
#UT_HTTPS_PORT="443"
#UT_INTERNAL_BIND_ADDRESS="10.42.0.7"

# --------------------------------------------------------------- secrets -----
# None ship here. ut-install generates every secret into local.env, which is not
# part of the release, and an invariant refuses this file if one ever appears.
# MONGODB_PASSWORD and BACKUP_FILES_PASSWORD cannot be rotated afterwards —
# docs/configuration.md#the-secrets says why, and how to generate them by hand.

# ------------------------------------------------------------------ load -----

WORKER_REPLICAS="2"
WORKER_CUSTOMER_REPLICAS="2"

# ---------------------------------------------------------------- backup -----
# Defaults keep everything on this machine. To send it elsewhere, see
# docs/configuration.md#sending-backups-off-the-machine.

#BACKUP_FILES_REPOSITORY="s3:https://s3.eu-west-3.amazonaws.com/bucket/appliance"
#BACKUP_FILES_S3_KEY_ID=""
#BACKUP_FILES_S3_SECRET=""
# Backups start with the service and repeat every BACKUP_INTERVAL minutes. Set
# an HHMM time here to wait for a quiet hour instead, at the cost of a machine
# that carries no backup at all until that hour comes.
#BACKUP_BEGIN="1520"
#BACKUP_INTERVAL="1440"

# ------------------------------------------------------------- App Builder ---
# Off by default and impossible to enable on a first install: its gateway key
# is generated inside the running platform. Five steps, in
# docs/configuration.md#the-app-builder.

#COMPOSE_FILE="compose.yaml:compose.appbuilder.yaml"
APP_BUILDER_AGENT_MAX_OUTPUT_TOKENS="8192"
APP_BUILDER_AGENT_CONTEXT_TOKENS="24576"
APP_BUILDER_MEMORY_LIMIT="4G"
APP_BUILDER_CPU_LIMIT="2"

# --------------------------------------------------------------- logging -----
# INFO, not DEBUG: an audit found document content in the verbose logs. A value
# written here wins over the default in compose.yaml, so leaving DEBUG cancels
# that change.

LOG_LEVEL="INFO"

# ------------------------------------------------------------- inference -----
# LLM_BACKEND decides which model is actually served — see
# docs/configuration.md#inference. Editing VLLM_LLM_MODEL on a "nim" install
# changes nothing.

COMPOSE_PROFILES="nim"
LLM_BACKEND="nim"

NIM_LLM_MODEL_PATH="hf://Inferact/Qwen3.8-27B-NVFP4"
NIM_LLM_PASSTHROUGH_ARGS=--gpu-memory-utilization 0.55 --max-model-len 131072 --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3 --speculative-config '{"method":"mtp","num_speculative_tokens":3}' --default-chat-template-kwargs '{"enable_thinking":false}' --enable-prefix-caching
NIM_VLM_PASSTHROUGH_ARGS=--gpu-memory-utilization 0.25 --max-model-len 8192

# Loopback: the engines have no authentication. A compute node serving another
# machine must override both.
NIM_LLM_BIND_ADDRESS="127.0.0.1"
NIM_VLM_BIND_ADDRESS="127.0.0.1"

# "EMPTY" is vLLM's literal for "no authentication", not a placeholder to fill.
VLLM_API_KEY="EMPTY"

VLLM_LLM_IMAGE="vllm/vllm-openai:muse-glimmer"
VLLM_LLM_MODEL_PATH="Inferact/Muse-Glimmer-30B-NVFP4-W4A4"
VLLM_LLM_MODEL="Qwen/Qwen3.8-27B"
VLLM_CONDENSE_MODEL="Qwen/Qwen3.8-27B"
VLLM_VLM_MODEL="Qwen/Qwen3-VL-4B-Instruct"
VLLM_LLM_BASE_URL="http://nim-llm:8000/v1"
VLLM_VLM_BASE_URL="http://nim-vlm:8000/v1"
VLLM_LLM_GPU_MEM_UTIL="0.45"
VLLM_VLM_GPU_MEM_UTIL="0.12"
VLLM_LLM_EXTRA_ARGS="--max-model-len 32768"
VLLM_VLM_EXTRA_ARGS="--limit-mm-per-prompt.video 0 --max-model-len 8192"

LLM_MODEL="Qwen/Qwen3.8-27B"
CONDENSE_MODEL="Qwen/Qwen3.8-27B"
VLM_MODEL="Qwen/Qwen3-VL-4B-Instruct"
GATEWAY_LLM_SERVED_NAME="Qwen/Qwen3.8-27B"
GATEWAY_VLM_MODEL="Qwen/Qwen3-VL-4B-Instruct"
LLM_MAX_CONTEXT_LEN="131072"
AGENT_MAX_OUTPUT_TOKENS=24576

# Local models only. An entry with an external base_url sends prompts off the
# appliance, which is the one thing this product promises not to do.
GATEWAY_MODELS='[{"id": "uai-large", "served": "Qwen/Qwen3.8-27B", "upstream": "llm", "display_name": "Understand AI", "multimodal": false}, {"id": "uai-vision", "served": "Qwen/Qwen3-VL-4B-Instruct", "upstream": "vlm", "display_name": "Understand AI Vision", "multimodal": true}]'

# 0 lets containers fetch model weights on first start, so an appliance sold as
# offline is only offline after a connected first boot.
HF_HUB_OFFLINE="0"

# ----------------------------------------------------------- do not edit -----

MONGODB_DATABASE="ut-db"
MODELS_DIR="/root/models/"
EMBED_URL="https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/main/nomic-embed-text-v1.5.f32.gguf"
EMBED_MODEL_NAME="nomic-embed-text-v1.5.f32.gguf"
EMBED_MODEL_BACKEND="nomic"
DOWNLOAD_ONNX_EMBED="true"
ONNX_EMBED_HF_REPO="Qwen/Qwen3-Embedding-0.6B"
RERANKER_HF_PATH="tomaarsen/Qwen3-Reranker-0.6B-seq-cls"
RERANKER_MODEL_NAME="Qwen3-Reranker-0.6B-seq-cls"
GPU_VM_URL="http://llm:8000"

ADMIN_MAIL="cto@understand.tech"
REDIS_HOST="redis"
REDIS_PORT="6379"
openid_scope="openid profile email"
DEPLOY_ENV="production"
VITE_AUTH_TYPE="open-id"
VITE_DEPLOYMENT_TYPE="onprem-ai-in-a-box"
STORAGE_PROVIDER="local"
LOCAL_STORAGE_BASE="/app/storage"

APP_LLMS_UT_APP_BASE_URL="http://api:8501/api"
APP_LLMS_UT_CUSTOMER_URL="http://api-customer:8501"
APP_BUILDER_UT_API_URL="http://ut-api:8501"
APP_BUILDER_GATEWAY_URL="http://ut-api-customer:8501/api/llm"
APP_BUILDER_HOST_PORT="8011"

# ------------------------------------------------- settings with no value ----
# These fall back to an empty string in the compose files, so the release has so
# far decided nothing for them and the stack started with them blank. Declaring
# them here, still empty, changes no behaviour today and makes them decidable:
# giving one a value becomes a one-line change rather than a mechanism.

API_KEY_HASH_LAZY_MIGRATION=""
API_KEY_HASH_NEW_KEYS=""
GATEWAY_DEFAULT_MODEL=""
GATEWAY_RPM_PER_KEY=""
OLLAMA_HOST_PORT=""
OLLAMA_MODEL_CONDENSE_LLM=""
OLLAMA_MODEL_LLM=""
OLLAMA_MODEL_VLM=""

# ---------------------------------------------------------------- release ----
# Filled by packaging/build-deb.sh at build time. Empty in the repository on
# purpose: what is committed is not a release, and a .env claiming a version
# nobody built would be worse than one claiming none.

UT_RELEASE_VERSION=""
