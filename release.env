# What this release decides.
#
# The package owns this file and replaces it on every upgrade. Nothing here is
# yours to edit: your own settings live in /etc/understandtech/local.env, which
# the package never touches and which wins over every value below.
#
# What each setting does, what can be rotated and what cannot, how to enable the
# App Builder: docs/configuration.md. TLS modes and DNS names:
# docs/certificates-and-dns.md.

# ---------------------------------------------------------------- images -----
# Quarterly updates: change the tags and re-deploy.

LLM_IMAGE="ghcr.io/understand-tech/ut-llm-customers:2.0-arm64@sha256:4e0fad795facd50ee17a10b4476848646ac8a53b880edf8ee281a9453130af74"
API_IMAGE="ghcr.io/understand-tech/ut-api-customer:2.1-arm64@sha256:17408755b837c4e4471cdc2be748fbbc4ce083b20c9389110c45e93cddf21080"
WORKER_IMAGE="ghcr.io/understand-tech/ut-worker-customer:2.1-arm64@sha256:3e7e3db5bed8480f4614132d99ea059f02deb6b3ddbe35746c97fcfcc06dcef9"
