API_CUSTOMER_IMAGE="ghcr.io/understand-tech/ut-api-rest-customer:2.1-arm64@sha256:d8715e430789cdf1ba620ea68eaa22b585e07eb32a6633f09b6e72b7c6e6b329"
WORKER_CUSTOMER_IMAGE="ghcr.io/understand-tech/ut-worker-rest-customer:2.1-arm64@sha256:416dfb9210f2c76e8b4cb356a388bfbecda2cf61729fef6114ad83c5a00c7f6a"
LLMS_APP_IMAGE="ghcr.io/understand-tech/ut-app-llms-customer:2.0-arm64@sha256:63900913adbe6e0dfcb1bb1190be373563648e3fea57db7a4cacbe1a9898801a"
ADMIN_PORTAL_IMAGE="ghcr.io/understand-tech/ut-portal-customer:2.0-arm64@sha256:4521d6fc457f5d0e2fdf3cefe6e161ef016558afd8fb155a4c0f8e62e0361822"
ASSISTANTS_APP_IMAGE="ghcr.io/understand-tech/ut-app-assistants-customer:2.0-arm64@sha256:3b03a2a79e151cd0795ac5cad4fa7a78d1bfb91c6e22bd7914083b6d1e297e7c"
APP_BUILDER_IMAGE="ghcr.io/understand-tech/agentic-app-builder-customer:d011b15cea71cf07faa7646e80cfaaa45529b06a-arm64@sha256:0d575ff57cb9f9b7e78428ee1e6a57fc6a544bcc2f8c8a2ee16824f28576f048"
NIM_IMAGE="ghcr.io/understand-tech/nim/nvidia/model-free-nim:2.0.12@sha256:20e10652de4cf63d25417c0bcb0c35497b573cad575c3ba0a5296625c89b4bff"

# github.com/understand-tech/ut-arbiter, published and signed by its image.yml on
# push to main. Tagged by commit until that repository has a release train of
# its own; the digest, not the tag, is what a box actually runs.
ARBITER_IMAGE="ghcr.io/understand-tech/ut-arbiter:add4f7161c9802ca58d7594a3f8f8f2fe2e71e11@sha256:802877df8487c397cac2feca062eea9bbc0f29de4249d1e03a465388d61a2942"

# The hold binary runs on the host, not in a container — it has to survive
# Docker being the thing that failed. Pinned by checksum, fetched by
# packaging/fetch-ut-arbiter.sh from ut-arbiter's own GitHub release, the same
# way the image above is pinned by digest.
ARBITER_HOLD_RELEASE="build-7d316769e565e04a4315100be1af6b361334ab8d"
ARBITER_HOLD_SHA256_AMD64="f5a0b27459c1635477110b261e82eff4c1d0f538319de4997b9f8d65d53ef008"
ARBITER_HOLD_SHA256_ARM64="23104e28607c70da821cab31cfa37ddf7875b3c93580dfc24d9971015863f25e"

# Republished under our own registry on 2026-09-18, after Docker Hub withdrew
# every versioned tag of tiredofit/db-backup. Upstream latest is not a way back:
# 1.44 MB against 1.93 GB, a static binary with no shell, so the CMD-SHELL
# health check cannot run at all.
DB_BACKUP_IMAGE="ghcr.io/understand-tech/db-backup:4.1.100@sha256:28c0451ac69f832beb1abc41be4a2143b2b03430e42c54602433876f090227fa"

# Pulled from their publishers, pinned by digest on 2026-10-06: the same tag gave
# two different redis:7.2-alpine images to installs made a month apart. Redis
# stays on 7.2 — 7.4 and later are no longer BSD-licensed.
CADDY_IMAGE="caddy:2-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f"
REDIS_IMAGE="redis:7.2-alpine@sha256:29e8589c3f9ba699b5f7aa4b3c7733c58852a3626439e619aa0ee78de08c6ca0"
MONGODB_IMAGE="mongo:8.2@sha256:e0ce8c35124d4a9f9785532d1f268f39e9728ffa1cb38f46fa482436424c4bd3"
FILES_BACKUP_IMAGE="restic/restic:0.18.1@sha256:39d9072fb5651c80d75c7a811612eb60b4c06b32ffe87c2e9f3c7222e1797e76"
BACKUP_RELAY_IMAGE="alpine/socat:1.8.1.3@sha256:603174b77eebaba25ba8f8ebb15e1234d6600409554e95d6fb203fd106150287"
TRAEFIK_IMAGE="traefik:v3.2@sha256:e561a37f8710d9cf41c78bdf421d822b2c0b48267ec0552e644565fb55466ea9"
APP_BUILDER_DOCKER_IMAGE="docker:29.6.2-dind-rootless@sha256:212a9e782c7119fd6a212beaab6b7665a29b663d894d0f6201710c89575ad0ae"
PROMETHEUS_IMAGE="prom/prometheus:v3.13.4@sha256:87861b8cf91579109319ebc300f3f1060e6da9c05d6ae8ad15a20c879e84e32e"

# ------------------------------------------------------- address and TLS -----
# Six names derive from UT_DOMAIN and must resolve here; ut-install asks for it
# and the value below is only the fallback. See docs/certificates-and-dns.md.

UT_DOMAIN="understand.local"
UT_INGRESS_MODE="internal"
UT_CADDY_SCHEME="https"

#UT_TRUSTED_PROXIES="10.42.0.0/16"
#UT_CERT_DIR="/etc/understandtech/certs"
#UT_APPS_CERT_FILE="/etc/caddy/certs/apps-fullchain.pem"
#UT_APPS_KEY_FILE="/etc/caddy/certs/apps-privkey.pem"
#UT_HTTP_PORT="80"
#UT_HTTPS_PORT="443"

# --------------------------------------------------------------- secrets -----
# None ship here. ut-install generates every secret into local.env, which is not
# part of the release, and an invariant refuses this file if one ever appears.
# BACKUP_FILES_PASSWORD cannot be rotated afterwards, nor MONGODB_PASSWORD by
# hand: ut-install --rotate-database-password changes it in the database too —
# docs/configuration.md#the-secrets says why, and how to generate them by hand.

# ------------------------------------------------------------------ load -----

WORKER_REPLICAS="2"
WORKER_CUSTOMER_REPLICAS="2"

# ---------------------------------------------------------------- backup -----
# Defaults keep everything on this machine. To send it elsewhere, see
# docs/configuration.md#sending-backups-off-the-machine.

#BACKUP_FILES_DESTINATION="/mnt/appliance-backup"
#BACKUP_FILES_REPOSITORY="s3:https://s3.eu-west-3.amazonaws.com/bucket/appliance"
#BACKUP_FILES_S3_KEY_ID=""
#BACKUP_FILES_S3_SECRET=""
# "owner" leaves the destination's retention to whoever runs it, for one that
# refuses deletions; the repository on this machine keeps its own either way.
#BACKUP_DESTINATION_RETENTION="appliance"
# The repository on this machine, on a disk of its own rather than in the volume
# beside the database archives; and the free space under which no run writes.
#BACKUP_LOCAL_DIR="/srv/backup"
#BACKUP_MIN_FREE_PERCENT="10"
# The network between files-backup and the relay to S3, SFTP or a REST server.
# Another box on the same Docker host takes another one.
#BACKUP_RELAY_SUBNET="198.18.255.248/29"
# Backups start with the service and repeat every BACKUP_INTERVAL minutes. Set
# an HHMM time here to wait for a quiet hour instead, at the cost of a machine
# that carries no backup at all until that hour comes.
#BACKUP_BEGIN="1520"
#BACKUP_INTERVAL="1440"

# ------------------------------------------------------------- App Builder ---
# Off by default and impossible to enable on a first install: its gateway key
# is generated inside the running platform. Five steps, in
# docs/configuration.md#the-app-builder.

#COMPOSE_FILE="compose.yaml:compose.appbuilder.yaml"
# Where its apps run: "nested", a rootless Docker of their own that only the App
# Builder reaches; "host", this machine's Docker, which makes the App Builder
# root here. "host" is a way back while the move proves itself, not a choice to keep.
APP_BUILDER_DOCKER="nested"
APP_BUILDER_AGENT_MAX_OUTPUT_TOKENS="8192"
APP_BUILDER_AGENT_CONTEXT_TOKENS="24576"
APP_BUILDER_MEMORY_LIMIT="4G"
APP_BUILDER_CPU_LIMIT="2"

# --------------------------------------------------------------- logging -----
# INFO, not DEBUG: an audit found document content in the verbose logs. A value
# written here wins over the default in compose.yaml, so leaving DEBUG cancels
# that change.

LOG_LEVEL="INFO"

# ------------------------------------------------------------- inference -----
# LLM_BACKEND decides which model is actually served — see
# docs/configuration.md#inference. Editing VLLM_LLM_MODEL on a "nim" install
# changes nothing.

COMPOSE_PROFILES="nim"
LLM_BACKEND="nim"

NIM_LLM_MODEL_PATH="hf://Inferact/Qwen3.8-27B-NVFP4"
# 0.75 since the vision engine left: the weights take a fixed share, so the points
# it gave back all go to the KV cache — 210 000 to 720 000 tokens on a GB10, and
# about 22 GB left to the rest of the machine. Measured on 2026-10-06.
NIM_LLM_PASSTHROUGH_ARGS=--gpu-memory-utilization 0.75 --max-model-len 131072 --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3 --speculative-config '{"method":"mtp","num_speculative_tokens":3}' --default-chat-template-kwargs '{"enable_thinking":false}' --enable-prefix-caching

VLLM_LLM_MODEL="Qwen/Qwen3.8-27B"
VLLM_CONDENSE_MODEL="Qwen/Qwen3.8-27B"
VLLM_VLM_MODEL="Qwen/Qwen3.8-27B"
VLLM_LLM_BASE_URL="http://nim-llm:8000/v1"
VLLM_VLM_BASE_URL="http://nim-llm:8000/v1"
VLLM_LLM_GPU_MEM_UTIL="0.45"
VLLM_VLM_GPU_MEM_UTIL="0.12"
VLLM_LLM_EXTRA_ARGS="--max-model-len 32768"
VLLM_VLM_EXTRA_ARGS="--limit-mm-per-prompt.video 0 --max-model-len 8192"

LLM_MODEL="Qwen/Qwen3.8-27B"
GATEWAY_LLM_SERVED_NAME="Qwen/Qwen3.8-27B"
GATEWAY_VLM_MODEL="Qwen/Qwen3.8-27B"
GATEWAY_MAX_PROMPT_TOKENS="65536"
LLM_MAX_CONTEXT_LEN="131072"
# ut-api and ut-llm cap nothing when this is unset, as on the SaaS: the box
# has to say it. Raise it in local.env, see docs/configuration.md.
LLM_FILE_TOKEN_BUDGET="16000"

# Local models only. An entry with an external base_url sends prompts off the
# appliance, which is the one thing this product promises not to do.
GATEWAY_MODELS='[{"id": "uai-large", "served": "Qwen/Qwen3.8-27B", "upstream": "llm", "display_name": "Understand AI", "multimodal": false}, {"id": "uai-vision", "served": "Qwen/Qwen3.8-27B", "upstream": "vlm", "display_name": "Understand AI Vision", "multimodal": true}]'

# ut-install places the weights the release lists, from the network or from a
# prepared folder, and sets this to 1 then. 0 is left only for an install that
# placed none, --skip-pull, where the containers fetch them on first start.
HF_HUB_OFFLINE="0"

# ----------------------------------------------------------- do not edit -----

MONGODB_DATABASE="ut-db"
MODELS_DIR="/root/models/"
EMBED_URL="https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/main/nomic-embed-text-v1.5.f32.gguf"
EMBED_MODEL_NAME="nomic-embed-text-v1.5.f32.gguf"
EMBED_MODEL_BACKEND="nomic"
DOWNLOAD_ONNX_EMBED="false"
ONNX_EMBED_HF_REPO="Qwen/Qwen3-Embedding-0.6B"
RERANKER_HF_PATH="tomaarsen/Qwen3-Reranker-0.6B-seq-cls"
RERANKER_MODEL_NAME="Qwen3-Reranker-0.6B-seq-cls"
GPU_VM_URL="http://llm:8000"

ADMIN_MAIL="cto@understand.tech"
REDIS_HOST="redis"
REDIS_PORT="6379"
openid_scope="openid profile email"
DEPLOY_ENV="production"
STORAGE_PROVIDER="local"
LOCAL_STORAGE_BASE="/app/storage"

APP_BUILDER_UT_API_URL="http://ut-api:8501"
APP_BUILDER_GATEWAY_URL="http://ut-api-customer:8501/api/llm"
APP_BUILDER_HOST_PORT="8011"

# ------------------------------------------------- settings with no value ----
# These fall back to an empty string in the compose files, so the release has so
# far decided nothing for them and the stack started with them blank. Declaring
# them here, still empty, changes no behaviour today and makes them decidable:
# giving one a value becomes a one-line change rather than a mechanism.

APP_BUILDER_GITLAB_ALLOWED_HOSTS=""
APP_BUILDER_GITLAB_CLIENT_ID=""
APP_BUILDER_LLM_STREAMING=""
APP_BUILDER_PROGRESS_WAIT_SECS=""
API_KEY_HASH_LAZY_MIGRATION=""
API_KEY_HASH_NEW_KEYS=""
GATEWAY_DEFAULT_MODEL=""
GATEWAY_RPM_PER_KEY=""
GATEWAY_RPM_PER_KEY_TOTAL=""
GATEWAY_RPM_PER_USER=""

# ---------------------------------------------------------------- release ----
# Filled by packaging/build-deb.sh at build time. Empty in the repository on
# purpose: what is committed is not a release, and a .env claiming a version
# nobody built would be worse than one claiming none.

UT_RELEASE_VERSION=""

# Seconds since the epoch, from the commit this release was built at. The
# preflight refuses a clock earlier than this: offline there is no authority to
# ask, but a package cannot have been built after the machine installing it.
UT_RELEASE_BUILT_AT=""
