#!/usr/bin/env bash

set -Eeuo pipefail

REPO_URL="${UT_REPO_URL:-https://github.com/understand-tech/ai-in-a-box.git}"
REPO_REF="${UT_REPO_REF:-main}"
REGISTRY="${UT_REGISTRY:-ghcr.io}"
REGISTRY_USER="${UT_REGISTRY_USER:-dgx-access}"

PACKAGE_SHARE_DIR="/usr/share/understandtech"
CHECKOUT_INSTALL_DIR="/opt/understandtech"
INSTALL_DIR="${UT_INSTALL_DIR:-}"
FROM_CHECKOUT="${UT_FROM_CHECKOUT:-}"
DATA_DIR="/var/lib/understandtech"
LOG_FILE="/var/log/ut-install.log"
TARGET_USER="${SUDO_USER:-root}"
DOMAIN="${UT_DOMAIN:-}"
FALLBACK_DOMAIN="understand.local"

MIN_DOCKER_MAJOR=24
MIN_DISK_BYTES=$((250 * 1000 * 1000 * 1000))
MIN_RAM_KB=$((24 * 1024 * 1024))
# 15.74 GB of images plus a 3.5 GB ceiling on the journals — x-logging caps them
# at 50 MB over 5 files per service — leaves the rest for the database, the
# uploads and thirty days of backups.
MIN_DISK_BYTES_NO_INFERENCE=$((60 * 1000 * 1000 * 1000))
# The thirteen services left once the engines are out reserve 10 GB at the
# replica counts the release ships (WORKER_REPLICAS=2, WORKER_CUSTOMER_REPLICAS=2):
# api-customer and workers-customer take 2 GB each, mongodb and api 1 GB each,
# the rest 64 to 512 MB. 12 leaves the host its own.
MIN_RAM_KB_NO_INFERENCE=$((12 * 1024 * 1024))
NIM_COLD_START_SECONDS=2700

ACTION="install"
EVENTS_FILE=""
DO_UPDATE=false
DO_AUTOSTART=true
DO_PULL=true
NO_GPU=false
TOKEN_FILE=""
REGISTRY_TOKEN="${UT_REGISTRY_TOKEN:-}"
LICENSE_FILE=""
LICENSE="${UT_LICENSE:-}"
LICENSE_STORE="/etc/understandtech/license"
MACHINE_FILE="/etc/understandtech/machine.lic"
MACHINE_FILE_GIVEN=""
LICENSE_REQUEST="/etc/understandtech/license-request.json"
HEALTH_TIMEOUT="${UT_HEALTH_TIMEOUT:-3600}"
REPORTING="${UT_REPORTING:-}"
REPORTING_RECEIVER=""
REPORTING_TOKEN_FILE=""
REPORTING_RECEIVER_CERT=""
REPORTING_EVERY=""
CERTIFICATE_DIR=""
BEHIND_PROXY=""
IMAGES_FROM=""
MODEL_ID=""
ENGINE_CHOICE=""
HOST_CA_BUNDLE="${UT_HOST_CA_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}"
UT_SEND="${UT_SEND:-ut-send}"
CURRENT_STEP=""
INFERENCE_STILL_LOADING=""

SHIPPED_PLACEHOLDERS=(
    "" "12345678" "password" "SECRET" "SJKFVK" "FVVE" "SJBVSJB" "ut"
    "czIzgahTJGzdG3b1XtEgGIWPvwhdfBvhVd1JjzetjWQ" "EMPTY"
)
GENERATED_SECRET_KEYS=(JWT_SECRET STATE_SECRET OPENID_SECRET_KEY ADMIN_SETUP_PASSWORD BACKUP_FILES_PASSWORD GPU_VM_API_TOKEN GATEWAY_METRICS_TOKEN APP_BUILDER_TOKEN_ENCRYPTION_KEY VLLM_API_KEY UT_ARBITER_API_KEY)

# One file per role a machine can be given at install, sibling of this script
# so it is found the same way whether run from a checkout or from the package
# — resolve_install_dir has not run yet here, nothing else is.
for role_file in "$(dirname "${BASH_SOURCE[0]}")"/ut-install.d/*.sh; do
    source "$role_file"
done
unset role_file

if [[ -t 1 ]]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
    CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; CYAN=""; BOLD=""; NC=""
fi

log()       { printf '%s\n' "$*"; }
log_info()  { printf '%s[ ok ]%s %s\n' "$GREEN" "$NC" "$*"; say_message ok "$*"; }
log_warn()  { printf '%s[warn]%s %s\n' "$YELLOW" "$NC" "$*"; say_message warn "$*"; }
log_error() { printf '%s[fail]%s %s\n' "$RED" "$NC" "$*" >&2; say_message fail "$*"; }
log_step()  { CURRENT_STEP=$*; printf '\n%s==>%s %s%s%s\n' "$CYAN" "$NC" "$BOLD" "$*" "$NC"; say_message step "$*"; }

# --events writes each of these beside the text, never instead of it: ut-setup
# reads the events, a person reads the text, and neither changes the other.
json_string() {
    local text=$1
    text=${text//\\/\\\\}
    text=${text//\"/\\\"}
    text=${text//$'\t'/\\t}
    text=${text//$'\r'/\\r}
    text=${text//$'\n'/\\n}
    printf '"%s"' "$(tr -d '\000-\010\013\014\016-\037\177' <<< "$text")"
}

say_event() {
    [[ -n "$EVENTS_FILE" ]] || return 0
    printf '{"v":1,"event":"%s"%s}\n' "$1" "${2:-}" >> "$EVENTS_FILE" 2>/dev/null || true
}

# A message carried on over several lines indents the lines after its first.
say_message() {
    [[ -n "$EVENTS_FILE" ]] || return 0
    local kind=$1 text=$2
    [[ -z "$text" || "$text" == " "* ]] && kind=more
    say_event "$kind" ",\"text\":$(json_string "$text")"
}

die() { log_error "$*"; exit 1; }

report_failure_and_exit() {
    local exit_code=$? line=$1
    (( BASH_SUBSHELL == 0 )) || exit "$exit_code"
    log_error "Install stopped at line ${line} (exit ${exit_code})."
    log_error "Nothing was rolled back — re-running the same command resumes."
    log_error "Log: ${LOG_FILE}"
    exit "$exit_code"
}
trap 'report_failure_and_exit $LINENO' ERR

usage() {
    cat <<'EOF'
ut-install — installs the UnderstandTech appliance in one command.

Replaces steps 1 to 10 of the manual setup guide. Safe to re-run: every step
checks its own state before acting, so an interrupted install is resumed by
running the same command again.

  sudo ./ut-install                 install
  sudo ./ut-install --check         preflight only, changes nothing
  sudo ./ut-install --update        also fast-forward an existing checkout

Options
  --check              Run the preflight checks and exit. Changes nothing.
  --list-models        Print the models this machine can serve, one a line: the
                       name --model takes, the engine, the size of the weights,
                       the license, and whether it runs code of its own. Changes
                       nothing.
  --events FILE        Also append each step, message, image and model to FILE,
                       one JSON object a line, for ut-setup. What is printed
                       does not change.
  --update            Fast-forward an existing checkout to the target ref.
                       Off by default so a support fix applied on the machine
                       is not silently discarded.
  --license-file PATH  The license key UnderstandTech issued for this machine.
                       Asked for when it is not given and none is stored yet.
  --machine-file PATH  The license file UnderstandTech activated this machine
                       with, for a machine that cannot reach Keygen. It is checked
                       with no network, then kept.
  --token-file PATH    A registry token instead of a license key. Accepted by
                       this version only.
  --dir PATH           Install directory. Defaults to /usr/share/understandtech
  --from-checkout PATH Take the settings from an install that lives in a git
                       checkout. Found on its own when there is exactly one;
                       needed when there are several. The checkout is read,
                       never moved, changed or removed.
                       when installed from the package, /opt/understandtech
                       otherwise.
  --domain NAME        Address the platform is served at. Asked for when it is
                       not given, offering the address this machine already
                       answers on, or understand.local on a first install.
  --certificate-dir DIR
                       Serve the certificate in DIR — fullchain.pem and
                       privkey.pem, from your own authority or a public one —
                       instead of one this machine signs. Checked before
                       anything is written: both files, that they belong
                       together, and every name the platform answers on.
                       Kept by later runs.
  --behind-proxy RANGE Your load balancer terminates TLS and reaches this
                       machine from RANGE, a CIDR or several separated by
                       commas: Caddy serves plain HTTP and believes the client
                       addresses forwarded from there only. Kept by later runs.
  --no-autostart       Skip the boot service and the mDNS publisher, which is
                       installed on a .local domain only.
  --skip-pull          Do not pull images. Useful when they are already local.
  --images-from DIR    Take every image from a folder ut-get --prepare wrote on a
                       connected machine, under the digest the release names,
                       and download none. ut-get --from passes it on its own.
  --no-gpu             This machine has no accelerator and serves no inference;
                       another machine does, named by VLLM_LLM_BASE_URL. Waives
                       the accelerator check, never a driver that stopped
                       answering. A settings file already carrying
                       compose.no-gpu.yaml says the same thing.
  --model ID           Serve one of the models in models/: on NIM when its entry
                       has a NIM variant proven on this machine's GPU, else on
                       vLLM; refused, with what is proven here, when neither is.
                       Kept by later runs, which apply its entry again.
  --engine nim|vllm    Take that variant of the model, if it is proven here.
  --compute ADDRESS    Serve inference only, to a control plane that reaches this
                       machine at ADDRESS: a DNS name or an IP, never a .local
                       name, which the control plane's containers cannot resolve.
                       Starts the engine and Caddy's keyed surface on port 8444,
                       no platform. Kept by later runs.
  --inference-from URL, --inference-key-file PATH, --inference-ca-file PATH
                       Take the inference from a compute node: its address
                       (https://<node>:8444), its VLLM_API_KEY and its Caddy
                       root, as its own install printed them. No engine starts
                       here; a GPU, when there is one, stays with llm, which
                       searches the documents. Without one, as --no-gpu.
  --arbiter ADDRESS    This machine judges which of a pair of boxes is
                       reachable, to settle a two-box failover without two
                       primaries. ADDRESS is this machine's own: a DNS name or
                       an IP, never a .local name, which the two boxes'
                       containers cannot resolve. No GPU, no control-plane
                       state of its own. Starts Caddy's keyed surface on port
                       8446 and the lease server behind it, nothing else.
                       Kept by later runs.
  --health-timeout N   Seconds to wait for services (default: 3600).
  --reporting yes|no   Whether this machine sends its usage reports to
                       UnderstandTech (docs/usage-report.md says what they hold).
                       Asked for when it is not given and a terminal is there;
                       with no terminal and no answer, nothing is sent. Asked
                       once: a later run keeps the answer unless given again.
  --reporting-receiver URL, --reporting-token-file PATH,
  --reporting-receiver-cert PATH
                       Where reports go, this machine's token, and the
                       receiver's certificate. Can come later, through
                       ut-send configure.
  --reporting-every N  Minutes between two sends (default: 15).
  -h, --help           This message.

Environment
  UT_LICENSE           License key, instead of --license-file or the prompt.
  UT_REGISTRY_TOKEN    Registry token, instead of --token-file.
  UT_REPO_REF          Branch or tag to install (default: main).
  UT_DOMAIN            Address the platform is served at.
  UT_REPORTING         yes or no, as --reporting.

The license key is read from UT_LICENSE, from --license-file, from the key stored
by an earlier install, or from a hidden prompt, and kept in
/etc/understandtech/license. On its first install, a machine activates the
license with Keygen, which needs the network once, and keeps the license file
Keygen signs for this machine in /etc/understandtech/machine.lic. Every later run
checks that file first, with no network: an altered file, or one made for
another machine, stops the run there. A machine that cannot reach Keygen writes
/etc/understandtech/license-request.json instead, its fingerprint and name, for
UnderstandTech to activate it and send back the file --machine-file takes. The
registry token the license carries is never passed on a command line nor
written to the log. A license that has ended stops an install or an update,
never a platform that is running.
EOF
}

as_target_user() {
    if [[ "$TARGET_USER" == "root" ]]; then
        "$@"
    else
        sudo -u "$TARGET_USER" -H "$@"
    fi
}

random_alphanumeric() {
    # The platform builds its database URI by concatenation, so a value holding
    # @ / # or % breaks the connection string.
    local chars="${1:-32}" raw
    if command -v openssl >/dev/null 2>&1; then
        raw=$(openssl rand -hex "$(( (chars + 1) / 2 ))")
    else
        raw=$(od -An -tx1 -N "$(( (chars + 1) / 2 ))" /dev/urandom | tr -d ' \n')
    fi
    printf '%s' "${raw:0:chars}"
}

# The App Builder reads its token key with Fernet, which takes 32 bytes in
# URL-safe base64 and refuses anything else, hexadecimal included.
random_fernet_key() {
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -base64 32 | tr '+/' '-_'
    else
        head -c 32 /dev/urandom | base64 | tr '+/' '-_'
    fi
}

env_get() {
    local file=$1 key=$2 value
    [[ -f "$file" ]] || return 1
    value=$(grep -m1 -E "^[[:space:]]*${key}=" "$file" 2>/dev/null) || return 1
    value=${value#*=}
    value=${value%\"}; value=${value#\"}
    value=${value%\'}; value=${value#\'}
    printf '%s' "$value"
}

env_set() {
    # Copying the temp file's content back, rather than moving it over, keeps
    # the original inode and its 0600 permissions.
    local file=$1 key=$2 value=$3 tmp found=0 line
    tmp=$(mktemp)
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*${key}= ]]; then
            printf '%s="%s"\n' "$key" "$value" >> "$tmp"
            found=1
        else
            printf '%s\n' "$line" >> "$tmp"
        fi
    done < "$file"
    (( found )) || printf '%s="%s"\n' "$key" "$value" >> "$tmp"
    cat "$tmp" > "$file"
    rm -f "$tmp"
}

is_shipped_placeholder() {
    local candidate=$1 placeholder
    for placeholder in "${SHIPPED_PLACEHOLDERS[@]}"; do
        [[ "$candidate" == "$placeholder" ]] && return 0
    done
    return 1
}

database_already_initialised() {
    local env_file=$1 prefix
    prefix=$(env_get "$env_file" RESOURCE_PREFIX 2>/dev/null || true)
    docker volume inspect "${prefix:-ut}-mongodb-data" >/dev/null 2>&1
}

compose_in_dir() { ( cd "$INSTALL_DIR" && docker compose "$@" ); }

appbuilder_enabled() {
    [[ "$(env_get "$INSTALL_DIR/.env" COMPOSE_FILE 2>/dev/null || true)" == *appbuilder* ]]
}

this_machine_is_a_compute_node() {
    [[ "$(env_get "$INSTALL_DIR/.env" COMPOSE_FILE 2>/dev/null || true)" == *compose.compute.yaml* ]]
}

inference_surface_url() {
    local address port
    address=$(env_get "$INSTALL_DIR/.env" UT_INFERENCE_ADDRESS 2>/dev/null || true)
    [[ -n "$address" ]] || address=$(env_get "$INSTALL_DIR/.env" UT_DOMAIN 2>/dev/null || echo "$DOMAIN")
    port=$(env_get "$INSTALL_DIR/.env" UT_INFERENCE_PORT 2>/dev/null || true)
    printf 'https://%s:%s' "$address" "${port:-8444}"
}

# The preflight runs before step_configure, so on a first install there is no
# .env to read yet and the flag is the only way to say it. The settings file
# answers for a laboratory stack, which docs/install.md has the operator write
# before calling this.
the_inference_is_served_by_another_machine() {
    $NO_GPU && return 0
    [[ -n "$INFERENCE_FROM" ]] && return 0
    [[ "$(env_get "$INSTALL_DIR/.env" COMPOSE_FILE 2>/dev/null || true)" == *no-gpu* ]]
}

# Printed at the end and kept in the install log. Without it, a box whose driver
# died and a machine that never had an accelerator leave the same trace, and the
# first one is a failure nobody would look for.
role_this_machine_was_installed_as() {
    if this_machine_is_a_compute_node; then
        printf 'compute node — serves inference at %s/v1 to the bearer of its key' "$(inference_surface_url)"
    elif ! the_inference_url_names_a_service_this_machine_will_not_run; then
        printf 'control plane — generation comes from %s' \
            "$(env_get "$INSTALL_DIR/.env" VLLM_LLM_BASE_URL 2>/dev/null)"
    elif the_inference_is_served_by_another_machine; then
        printf 'control plane — and nothing serves it yet: VLLM_LLM_BASE_URL still names %s' \
            "${INTERNAL_INFERENCE_HOST:-no host at all}"
    else
        printf 'appliance — inference runs on this machine'
    fi
}

# What ut-setup needs to offer an update instead of a fresh install. Settings
# and versions only: no key, no password, no license.
say_what_is_installed() {
    local env_file="$INSTALL_DIR/.env" address role node="" model reporting=false licensed=false installed release
    address=$(env_get "$env_file" UT_DOMAIN 2>/dev/null || true)
    [[ -n "$address" ]] || return 0
    if this_machine_is_a_compute_node; then
        role=compute
    elif ! the_inference_url_names_a_service_this_machine_will_not_run || the_inference_is_served_by_another_machine; then
        role=control-plane
        node=$(env_get "$env_file" VLLM_LLM_BASE_URL 2>/dev/null || true)
    else
        role=appliance
    fi
    model=$(env_get "$env_file" UT_MODEL 2>/dev/null || true)
    command -v "$UT_SEND" >/dev/null 2>&1 && reporting_already_decided && reporting=true
    [[ -s "$LICENSE_STORE" ]] && licensed=true
    installed=$(env_get "$env_file" UT_RELEASE_VERSION 2>/dev/null || true)
    release=$(env_get "$INSTALL_DIR/release.env" UT_RELEASE_VERSION 2>/dev/null || true)
    log_info "Installed here: ${role} at ${address}, release ${installed:-unknown}; this package is ${release:-unknown}"
    say_event installed ",\"role\":$(json_string "$role"),\"address\":$(json_string "$address"),\"node\":$(json_string "$node"),\"model\":$(json_string "$model"),\"reporting_decided\":${reporting},\"licensed\":${licensed},\"installed\":$(json_string "$installed"),\"release\":$(json_string "$release")"
}

an_accelerator_answers() {
    command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1
}

this_machine_goes_without_its_accelerator() {
    $NO_GPU && return 0
    [[ -n "$INFERENCE_FROM" ]] && ! an_accelerator_answers
}

checkout_exists() { [[ -d "$INSTALL_DIR/.git" ]]; }

# The package owns /usr/share/understandtech: the release arrives and leaves with
# apt, so there is nothing here to clone, pull or reset.
release_comes_from_the_package_manager() {
    [[ "$INSTALL_DIR" == "$PACKAGE_SHARE_DIR" && -f "$INSTALL_DIR/compose.yaml" ]]
}

running_from_the_package() {
    [[ "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" == "/usr/bin" ]]
}

checkout_the_script_sits_in() {
    ( cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd )
}

# Both marks are required: a directory holding only one of them is something
# else, and adopting it would install beside the release rather than onto it.
looks_like_a_checkout() {
    [[ -f "$1/compose.yaml" && -d "$1/.git" ]]
}

resolve_install_dir() {
    [[ -n "$INSTALL_DIR" ]] && return 0
    local here
    here=$(checkout_the_script_sits_in)
    if looks_like_a_checkout "$here"; then
        INSTALL_DIR="$here"
    elif running_from_the_package && [[ -f "$PACKAGE_SHARE_DIR/compose.yaml" ]]; then
        INSTALL_DIR="$PACKAGE_SHARE_DIR"
    else
        INSTALL_DIR="$CHECKOUT_INSTALL_DIR"
    fi
}

registry_credentials_stored() { grep -q "$REGISTRY" /root/.docker/config.json 2>/dev/null; }

release_declares() {
    local key=$1 line
    line=$(grep -m1 "^${key}=" "$INSTALL_DIR/release.env" 2>/dev/null) || return 1
    line=${line#*=}; line=${line%\"}; line=${line#\"}
    [[ -n "$line" ]] || return 1
    printf '%s' "$line"
}

nvidia_runtime_registered() {
    docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q nvidia
}

# The toolkit stopped registering a docker runtime once CDI became its default
# path, so a working GPU host can have no nvidia runtime at all.
nvidia_cdi_devices_declared() {
    local candidate
    for candidate in /etc/cdi/nvidia*.yaml /etc/cdi/nvidia*.json \
                     /var/run/cdi/nvidia*.yaml /var/run/cdi/nvidia*.json; do
        [[ -e "$candidate" ]] && return 0
    done
    return 1
}

# Docker hands each network a block from a small pool, and a machine that has
# run generated applications keeps their networks long after they stop. Asking
# for one is the only way to know there is room: nothing reports the count left.
docker_can_still_allocate_a_network() {
    local probe="ut-preflight-$$"
    docker network create "$probe" >/dev/null 2>&1 || return 1
    docker network rm "$probe" >/dev/null 2>&1 || true
    return 0
}

preflight() {
    log_step "Checking the system"
    local blocking=0

    if ! command -v docker >/dev/null 2>&1; then
        log_error "Docker is not installed."
        blocking=1
    else
        local docker_version major
        docker_version=$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo "unknown")
        major=${docker_version%%.*}
        if [[ "$major" =~ ^[0-9]+$ ]] && (( major >= MIN_DOCKER_MAJOR )); then
            log_info "Docker ${docker_version}"
        else
            log_error "Docker ${docker_version} — ${MIN_DOCKER_MAJOR}.0 or newer required."
            blocking=1
        fi
    fi

    if docker compose version >/dev/null 2>&1; then
        log_info "Compose $(docker compose version --short 2>/dev/null || echo v2)"
    else
        log_error "Docker Compose V2 is missing (docker compose)."
        blocking=1
    fi

    if an_accelerator_answers; then
        log_info "GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
        if nvidia_runtime_registered; then
            log_info "GPU reachable from containers through the nvidia runtime"
        elif nvidia_cdi_devices_declared; then
            log_info "GPU reachable from containers through CDI"
        else
            log_error "Docker cannot reach the GPU: no nvidia runtime and no CDI device."
            log_error "  Inference containers will not start. Install the NVIDIA"
            log_error "  Container Toolkit, then either 'nvidia-ctk runtime configure'"
            log_error "  or 'nvidia-ctk cdi generate'."
            blocking=1
        fi
    elif the_inference_is_served_by_another_machine; then
        # Only reached when nvidia-smi answered nothing. A box whose driver died
        # under a kernel upgrade still answers, so it lands in the branch above
        # and stays blocked there: what is waived here is the absence of an
        # accelerator, never a broken one.
        log_warn "No accelerator — the inference is served by another machine."
        log_warn "  Nothing here will generate; VLLM_LLM_BASE_URL has to point at a machine that does."
    else
        log_error "No usable GPU detected (nvidia-smi)."
        log_error "  Install the driver, or say the inference runs on another machine:"
        log_error "    --no-gpu, or COMPOSE_FILE=\"compose.yaml:compose.no-gpu.yaml\" in .env"
        blocking=1
    fi

    # A box whose battery died boots in 1970 and nothing on it can tell: offline
    # there is no authority to ask. What can be proved without one is that the
    # clock is not earlier than the release — a package cannot have been built
    # after the machine that installs it.
    local built_at now
    built_at=$(release_declares UT_RELEASE_BUILT_AT || true)
    if [[ "$built_at" =~ ^[0-9]+$ ]]; then
        now=$(date +%s)
        if (( now >= built_at )); then
            log_info "Clock: $(date -u '+%Y-%m-%d %H:%M UTC')"
        else
            log_error "Clock: $(date -u '+%Y-%m-%d %H:%M UTC') — before this release was built"
            log_error "  ($(date -u -d "@${built_at}" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || printf 'epoch %s' "$built_at"))."
            log_error "  The clock is wrong, and every certificate issued here will be refused as"
            log_error "  not yet valid. Set it, then run this again:"
            log_error "    sudo timedatectl set-time 'YYYY-MM-DD HH:MM:SS'"
            blocking=1
        fi
    fi

    if command -v timedatectl >/dev/null 2>&1 \
        && [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" != yes ]]; then
        log_warn "The clock is not synchronised. On a machine with no network that is expected —"
        log_warn "  set it by hand and check it, because certificate validity depends on it."
    fi

    # Both floors were sized for a machine that holds the models. Measured on a
    # box in service: the engines account for 43.1 GB on their own — 24.44 for
    # model-free-nim, 15.11 for ut-llm-customers, 3.56 for the ut-llm-models
    # volume — and everything else comes to 15.74 GB. Asking a machine that
    # serves no inference for 250 GB refuses it over storage it will never use.
    local disk_floor=$MIN_DISK_BYTES ram_floor=$MIN_RAM_KB
    if the_inference_is_served_by_another_machine; then
        disk_floor=$MIN_DISK_BYTES_NO_INFERENCE
        ram_floor=$MIN_RAM_KB_NO_INFERENCE
    fi

    local available_bytes disk_target
    disk_target=$([[ -d /var/lib/docker ]] && echo /var/lib/docker || echo /var/lib)
    available_bytes=$(df -B1 --output=avail "$disk_target" 2>/dev/null | tail -1 | tr -d ' ')
    if [[ -n "$available_bytes" ]] && (( available_bytes >= disk_floor )); then
        log_info "Disk: $((available_bytes / 1000000000)) GB free on ${disk_target}"
    else
        log_error "Disk: $((${available_bytes:-0} / 1000000000)) GB free on ${disk_target} — $((disk_floor / 1000000000)) GB needed."
        blocking=1
    fi

    local ram_kb
    ram_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    if (( ram_kb >= ram_floor )); then
        log_info "Memory: $((ram_kb / 1024 / 1024)) GB"
    else
        log_warn "Memory: $((ram_kb / 1024 / 1024)) GB — low, workers may be starved"
    fi

    # Only the checkout path needs git. A release the package manager put in
    # place is never cloned, pulled or reset, so requiring git there would stop
    # an install that has everything it needs.
    if ! command -v docker >/dev/null 2>&1; then
        :
    elif docker_can_still_allocate_a_network; then
        log_info "Docker has address space left for the stack's networks"
    else
        log_error "Docker cannot create a network — its address pools are full."
        log_error "  The stack needs four. Reclaim the ones nothing uses:"
        log_error "    docker network prune"
        log_error "  Or widen the pools in /etc/docker/daemon.json and restart docker:"
        log_error '    { "default-address-pools": [ { "base": "10.100.0.0/16", "size": 24 } ] }'
        blocking=1
    fi

    if release_is_present && ! $DO_UPDATE; then
        log_info "Release already at ${INSTALL_DIR} — nothing to clone, git not needed"
    elif command -v git >/dev/null 2>&1; then
        log_info "git present"
    else
        log_error "git is not installed, and the release has to be fetched."
        blocking=1
    fi

    if (( blocking )); then
        log_error ""
        log_error "Blocking problems found. Nothing was changed."
        exit 1
    fi

    log_info "System ready"
}

release_is_present() { checkout_exists || release_comes_from_the_package_manager; }

token_required() {
    release_is_present && registry_credentials_stored && return 1
    return 0
}

# Measured on a real machine: an install from before UT_DOMAIN existed has no
# such line, and names its address in every URL instead.
domain_named_by_the_urls() {
    local file=$1 key url
    for key in PUBLIC_BASE_URL DOMAIN_URL BACKEND_URL FRONTEND_URL_AUTH; do
        url=$(env_get "$file" "$key" 2>/dev/null || true)
        [[ -n "$url" ]] || continue
        url=${url#*://}; url=${url%%/*}; url=${url%%:*}
        [[ -n "$url" ]] || continue
        printf '%s' "$url"
        return 0
    done
    return 1
}

domain_written_in() {
    local file=$1 named
    named=$(env_get "$file" UT_DOMAIN 2>/dev/null || true)
    if [[ -n "$named" ]]; then printf '%s' "$named"; return 0; fi
    domain_named_by_the_urls "$file"
}

# The address is read before the settings are written, so /etc is still empty
# here on a machine moving off a checkout.
configured_domain() {
    local found previous
    found=$(domain_written_in "$INSTALL_DIR/.env" 2>/dev/null || true)
    if [[ -n "$found" ]]; then printf '%s' "$found"; return 0; fi
    previous=$(settings_of_a_previous_install 2>/dev/null) || return 0
    domain_written_in "$previous" 2>/dev/null || true
}

domain_to_check() {
    local candidate="$DOMAIN"
    [[ -n "$candidate" ]] || candidate=$(configured_domain)
    printf '%s' "${candidate:-$FALLBACK_DOMAIN}"
}

# A terminal on stdin does not imply a controlling terminal: a process started
# without one has an open /dev/tty node that cannot be opened.
terminal_is_reachable() { ( exec 3<> /dev/tty ) 2>/dev/null; }

describe_domain() {
    case "$1" in
        *.local)
            log_warn "${1} is mDNS-only: it does not cross a router, and no"
            log_warn "public authority certifies it — every machine will need the root installed" ;;
        *)
            log_info "${1} — publish its six names in your DNS, see docs/certificates-and-dns.md" ;;
    esac
}

read_domain() {
    [[ -n "$DOMAIN" ]] && return 0

    local current suggested
    current=$(configured_domain)
    suggested="${current:-$FALLBACK_DOMAIN}"

    if [[ -n "$COMPUTE_ADDRESS" ]] || this_machine_is_a_compute_node; then
        DOMAIN="$suggested"
        log_info "A compute node serves no platform: its address is not asked, ${DOMAIN} is kept"
        return 0
    fi

    if [[ ! -t 0 ]]; then
        DOMAIN="$suggested"
        if [[ -n "$current" ]]; then
            log_info "No --domain given and no terminal to ask on — keeping ${DOMAIN}"
        else
            log_warn "No --domain given and no terminal to ask on — using ${DOMAIN}"
            describe_domain "$DOMAIN"
        fi
        return 0
    fi

    log_step "The address this appliance answers on"
    log "  A name from the customer's DNS zone lets browsers trust it without"
    log "  installing anything on their machines. See docs/certificates-and-dns.md."
    log ""
    if [[ -n "$current" ]]; then
        log "  Leave empty to keep ${current}, which this machine already answers on."
    else
        log "  Leave empty to use ${FALLBACK_DOMAIN}, which works on a flat local"
        log "  network and nowhere else."
    fi
    log ""
    local answer=""
    if terminal_is_reachable; then
        printf '  Domain [%s]: ' "$suggested" > /dev/tty
        read -r answer < /dev/tty || answer=""
    else
        printf '  Domain [%s]: ' "$suggested"
        read -r answer || answer=""
    fi
    DOMAIN="${answer:-$suggested}"

    describe_domain "$DOMAIN"
}

read_token() {
    [[ -n "$REGISTRY_TOKEN" ]] && return 0

    if [[ -n "$TOKEN_FILE" ]]; then
        [[ -r "$TOKEN_FILE" ]] || die "Token file not readable: ${TOKEN_FILE}"
        REGISTRY_TOKEN=$(tr -d '\r\n' < "$TOKEN_FILE")
    elif token_required; then
        terminal_is_reachable \
            || die "A registry token is needed and there is no terminal to ask on. Pass --token-file, or set UT_REGISTRY_TOKEN."
        printf 'Registry token for %s (input hidden): ' "$REGISTRY_USER" > /dev/tty
        read -rs REGISTRY_TOKEN < /dev/tty
        printf '\n' > /dev/tty
    else
        log_info "Checkout and registry credentials already present — no token needed"
        return 0
    fi

    [[ -n "$REGISTRY_TOKEN" ]] || die "No registry token supplied."
}

license_tool() {
    local beside
    beside="$(dirname "${BASH_SOURCE[0]}")/ut-license"
    if [[ -x "$beside" ]]; then printf '%s' "$beside"; else printf 'ut-license'; fi
}

ask_for_license() {
    terminal_is_reachable \
        || die "A license key is needed and there is no terminal to ask on. Pass --license-file, or set UT_LICENSE."
    printf 'License key from UnderstandTech (input hidden): ' > /dev/tty
    read -rs LICENSE < /dev/tty
    printf '\n' > /dev/tty
    [[ -n "$LICENSE" ]] || die "No license key supplied."
}

stored_license_is() {
    [[ -s "$LICENSE_STORE" && "$(tr -d ' \t\r\n' < "$1")" == "$(tr -d ' \t\r\n' < "$LICENSE_STORE")" ]]
}

refuse_the_license() {
    rm -f "$@"
    die "The license was refused. Nothing was changed on this machine."
}

# The request names the machine, never the license key, so that it can travel
# by mail or as a picture of the screen.
ask_for_the_license_by_file() {
    local tool=$1
    [[ -d "$(dirname "$LICENSE_REQUEST")" ]] || mkdir -p -m 750 "$(dirname "$LICENSE_REQUEST")"
    "$tool" request > "$LICENSE_REQUEST" || die "Could not write the license request ${LICENSE_REQUEST}."
    chmod 644 "$LICENSE_REQUEST"
    log_warn "To activate this machine with no network, send ${LICENSE_REQUEST} to UnderstandTech"
    log_warn "  (contact@understand.tech). It holds this machine's fingerprint and name, not the license key:"
    log_warn "  $(tr -d '\n' < "$LICENSE_REQUEST")"
    if command -v qrencode >/dev/null 2>&1; then
        qrencode -t ANSIUTF8 < "$LICENSE_REQUEST" || true
    fi
    log_warn "  Then run ut-install again with --machine-file <the file UnderstandTech sends back>,"
    log_warn "  or put that file in the folder ut-get --from installs from, and run it again."
    die "The license could not be activated here. Nothing else was changed on this machine."
}

# The license file this machine already holds is checked before anything goes
# on the network: an altered one, or one made for another machine, stops the
# install there. Only a genuine file that has ended, or whose license has ended
# or is suspended, is renewed from Keygen, which then says whether it may be.
take_license() {
    local tool key machine checked activated licensed_user licensed_registry
    tool=$(license_tool)
    key=$(mktemp)
    machine=$(mktemp)
    chmod 600 "$key" "$machine"
    if [[ -n "$LICENSE" ]]; then
        printf '%s\n' "$LICENSE" > "$key"
    else
        [[ -r "$LICENSE_FILE" ]] || { rm -f "$key" "$machine"; die "License file not readable: ${LICENSE_FILE}"; }
        cat "$LICENSE_FILE" > "$key"
    fi
    checked=1
    if [[ -n "$MACHINE_FILE_GIVEN" ]]; then
        [[ -r "$MACHINE_FILE_GIVEN" ]] || { rm -f "$key" "$machine"; die "License file not readable: ${MACHINE_FILE_GIVEN}"; }
        cat "$MACHINE_FILE_GIVEN" > "$machine"
        "$tool" check "$machine" || refuse_the_license "$key" "$machine"
        checked=0
    elif [[ -s "$MACHINE_FILE" ]] && stored_license_is "$key"; then
        cat "$MACHINE_FILE" > "$machine"
        checked=0
        "$tool" check "$machine" || checked=$?
        (( checked == 0 || checked == 2 )) || refuse_the_license "$key" "$machine"
    fi
    if (( checked != 0 )); then
        log_info "Asking Keygen for this machine's license file"
        activated=0
        "$tool" activate "$key" "$machine" || activated=$?
        if (( activated == 3 )); then
            rm -f "$key" "$machine"
            ask_for_the_license_by_file "$tool"
        fi
        (( activated == 0 )) || refuse_the_license "$key" "$machine"
        "$tool" check "$machine" || refuse_the_license "$key" "$machine"
    fi
    if ! REGISTRY_TOKEN=$("$tool" field registry_token "$machine" 2>/dev/null); then
        REGISTRY_TOKEN=""
        if $DO_PULL; then
            rm -f "$key" "$machine"
            die "This license carries no registry token to pull the images with. Ask UnderstandTech for one, or install with --skip-pull or from a folder ut-get --prepare wrote, which pull nothing."
        fi
        log_info "This license carries no registry token, and none is needed: nothing is pulled"
    fi
    licensed_user=$("$tool" field registry_user "$machine" 2>/dev/null || true)
    REGISTRY_USER=${licensed_user:-$REGISTRY_USER}
    licensed_registry=$("$tool" field registry "$machine" 2>/dev/null || true)
    if [[ -n "$licensed_registry" && -z "${UT_REGISTRY:-}" ]]; then
        REGISTRY=$licensed_registry
        log_info "Images come from ${REGISTRY}, the registry this license names"
    fi
    [[ -d "$(dirname "$LICENSE_STORE")" ]] || mkdir -p -m 750 "$(dirname "$LICENSE_STORE")"
    install -m 600 "$key" "$LICENSE_STORE"
    install -m 600 "$machine" "$MACHINE_FILE"
    rm -f "$key" "$machine"
}

read_credentials() {
    if [[ -n "$LICENSE" || -n "$LICENSE_FILE" ]]; then
        take_license
    elif [[ -n "$MACHINE_FILE_GIVEN" ]]; then
        if [[ -s "$LICENSE_STORE" ]]; then LICENSE_FILE=$LICENSE_STORE; else ask_for_license; fi
        take_license
    elif [[ -n "$REGISTRY_TOKEN" || -n "$TOKEN_FILE" ]]; then
        log_warn "A registry token on its own is accepted by this version only. Ask UnderstandTech for a license key, and pass it with --license-file."
        read_token
    elif [[ -s "$LICENSE_STORE" ]]; then
        LICENSE_FILE=$LICENSE_STORE
        take_license
    elif token_required; then
        ask_for_license
        take_license
    else
        log_warn "No license key on this machine. The next version will ask for one: ask UnderstandTech for it."
    fi
}

step_registry_login() {
    if ! $DO_PULL; then
        log_step "Images are already here (--skip-pull): no registry login"
        return 0
    fi
    if [[ -z "$REGISTRY_TOKEN" ]]; then
        log_step "Registry credentials already stored"
        return 0
    fi

    log_step "Authenticating with the registry"

    printf '%s' "$REGISTRY_TOKEN" | docker login "$REGISTRY" -u "$REGISTRY_USER" --password-stdin >/dev/null \
        || die "Registry login failed. Check the token, or ask for a new one."
    log_info "root can pull private images"

    if [[ "$TARGET_USER" != "root" ]]; then
        if printf '%s' "$REGISTRY_TOKEN" | as_target_user docker login "$REGISTRY" -u "$REGISTRY_USER" --password-stdin >/dev/null 2>&1; then
            log_info "${TARGET_USER} can pull private images"
        else
            log_warn "Could not store credentials for ${TARGET_USER}; updates will need sudo"
        fi
    fi
}

clone_without_persisting_token() {
    # The helper references the variables by name instead of expanding them, so
    # the token reaches git through the environment and never appears in the
    # process table, the shell history, or .git/config.
    UT_REGISTRY_USER="$REGISTRY_USER" UT_REGISTRY_TOKEN="$REGISTRY_TOKEN" \
    git -c 'credential.helper=!f() { printf "username=%s\npassword=%s\n" "$UT_REGISTRY_USER" "$UT_REGISTRY_TOKEN"; }; f' \
        clone --quiet --branch "$REPO_REF" "$REPO_URL" "$INSTALL_DIR"
}

assert_token_absent_from_git_config() {
    [[ -n "$REGISTRY_TOKEN" ]] || return 0
    grep -qF -f <(printf '%s\n' "$REGISTRY_TOKEN") "$INSTALL_DIR/.git/config" 2>/dev/null \
        && die "The token leaked into .git/config — refusing to continue."
    return 0
}

step_fetch_repo() {
    log_step "Fetching the deployment files"

    if release_comes_from_the_package_manager; then
        log_info "Release installed by the package at ${INSTALL_DIR}"
        log_info "Updates come from 'apt upgrade understandtech', not from here"
        return 0
    fi

    if checkout_exists; then
        if $DO_UPDATE; then
            ( cd "$INSTALL_DIR"
              git fetch --quiet origin "$REPO_REF"
              git checkout --quiet "$REPO_REF"
              git reset --quiet --hard "origin/${REPO_REF}" )
            log_info "Updated to ${REPO_REF} ($(cd "$INSTALL_DIR" && git rev-parse --short HEAD))"
        else
            log_info "Checkout already present ($(cd "$INSTALL_DIR" && git rev-parse --short HEAD)) — use --update to refresh"
        fi
        return 0
    fi

    [[ -e "$INSTALL_DIR" && -n "$(ls -A "$INSTALL_DIR" 2>/dev/null)" ]] \
        && die "${INSTALL_DIR} exists and is not a checkout. Move it aside first."

    mkdir -p "$(dirname "$INSTALL_DIR")"
    clone_without_persisting_token || die "Clone failed. Check the token and the network."
    assert_token_absent_from_git_config

    log_info "Cloned ${REPO_REF} into ${INSTALL_DIR}"
}

# Whatever it looks like, the password a machine was installed with is the
# password of its database: mongo only reads it when it creates the volume.
settings_carry_database_credentials() {
    local env_file=$1
    [[ -n "$(env_get "$env_file" MONGODB_PASSWORD || true)" ]]
}

# Generating a new password here would not reach the database — mongo reads it
# once, when it creates its data directory — so the stack would start and fail
# to connect, with nothing saying why.
die_on_a_database_nobody_has_the_password_for() {
    local env_file=$1 prefix volume
    prefix=$(env_get "$env_file" RESOURCE_PREFIX 2>/dev/null || true)
    volume="${prefix:-ut}-mongodb-data"

    log_error "A database volume is already here, and ${env_file} holds no password for it."
    log_error "  volume: ${volume}"
    log_error ""
    log_error "Either put the password this database was created with back into"
    log_error "MONGODB_USERNAME and MONGODB_PASSWORD, or discard the volume and"
    log_error "everything in it:"
    log_error ""
    log_error "  docker volume rm ${volume}"
    exit 1
}

generate_database_credentials() {
    local env_file=$1 local_file=$2 user

    # The mongo image only reads MONGO_INITDB_ROOT_PASSWORD when it creates the
    # data directory. Rotating it later changes nothing in the database and just
    # stops every service from connecting.
    if database_already_initialised "$env_file"; then
        settings_carry_database_credentials "$local_file" \
            || die_on_a_database_nobody_has_the_password_for "$local_file"
        log_info "Database already initialised — leaving its credentials alone"
        return 0
    fi

    if ! is_shipped_placeholder "$(env_get "$local_file" MONGODB_PASSWORD || true)"; then
        log_info "Database credentials already set"
        return 0
    fi

    user=$(env_get "$local_file" MONGODB_USERNAME || true)
    [[ -z "$user" || "$user" == "mongoadmin" ]] && user="ut$(random_alphanumeric 8)"
    env_set "$local_file" MONGODB_USERNAME "$user"
    env_set "$local_file" MONGODB_PASSWORD "$(random_alphanumeric 32)"
    log_info "Generated database credentials"
}

generate_application_secrets() {
    local local_file=$1 key rotated=()

    for key in "${GENERATED_SECRET_KEYS[@]}"; do
        if is_shipped_placeholder "$(env_get "$local_file" "$key" || true)"; then
            case "$key" in
                JWT_SECRET|BACKUP_FILES_PASSWORD) env_set "$local_file" "$key" "$(random_alphanumeric 64)" ;;
                APP_BUILDER_TOKEN_ENCRYPTION_KEY) env_set "$local_file" "$key" "$(random_fernet_key)" ;;
                *)                                env_set "$local_file" "$key" "$(random_alphanumeric 32)" ;;
            esac
            rotated+=("$key")
        fi
    done

    if (( ${#rotated[@]} == 0 )); then
        log_info "Secrets already set"
        return 0
    fi

    log_info "Generated: ${rotated[*]}"
    [[ " ${rotated[*]} " == *" JWT_SECRET "* ]] \
        && log_warn "JWT_SECRET was the shipped value — tokens were forgeable across deployments"
    return 0
}

# The release directory reaches the settings through a link into /etc, and GNU cp
# refuses to write through one whose target does not exist yet. Creating the
# target first is also what makes a second run a no-op.
create_settings_file_behind() {
    local link=$1 target
    [[ -L "$link" && ! -e "$link" ]] || return 0
    target=$(readlink "$link")
    install -d -m 750 "$(dirname "$target")"
    install -m 600 /dev/null "$target"
}

settings_directory() {
    local link=$1
    if [[ -L "$link" ]]; then
        dirname "$(readlink "$link")"
    else
        dirname "$link"
    fi
}

key_is_overridden_locally() {
    local key=$1 overridden=$2
    printf '%s\n' "$overridden" | grep -qx "$key"
}

# An install that predates the package keeps its settings inside its checkout,
# where /etc/understandtech never looks.
checkouts_holding_settings() {
    local candidate home
    home=$(eval echo "~${TARGET_USER}" 2>/dev/null || echo /root)
    for candidate in "$CHECKOUT_INSTALL_DIR" "$home/understand-tech" "$home/ai-in-a-box"; do
        [[ -f "$candidate/.env" && ! -L "$candidate/.env" && -s "$candidate/.env" ]] || continue
        printf '%s\n' "$candidate/.env"
    done
}

settings_of_a_previous_install() {
    local found count
    if [[ -n "$FROM_CHECKOUT" ]]; then
        [[ -s "$FROM_CHECKOUT/.env" ]] || die "No .env in ${FROM_CHECKOUT}."
        printf '%s' "$FROM_CHECKOUT/.env"
        return 0
    fi
    found=$(checkouts_holding_settings)
    count=$(printf '%s' "$found" | grep -c . || true)
    (( count == 0 )) && return 1
    if (( count > 1 )); then
        log_error "More than one previous install holds settings:"
        printf '%s\n' "$found" | while IFS= read -r candidate; do log_error "  ${candidate}"; done
        die "Say which one with --from-checkout PATH, or move the ones you do not want."
    fi
    printf '%s' "$found"
}

# Lines are carried over verbatim, never re-quoted: GATEWAY_MODELS holds JSON
# inside single quotes, which env_set would rewrite as KEY="value" and corrupt.
migrate_existing_settings_into_local() {
    local env_file=$1 local_file=$2 release line key kept=0 diverged=0
    release="$INSTALL_DIR/release.env"

    [[ -s "$env_file" ]] || return 0
    [[ -s "$local_file" ]] && return 0

    install -m 600 "$env_file" "${local_file%/*}/env.before-split"
    install -m 600 /dev/null "$local_file"

    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            [A-Za-z_]*=*) key=${line%%=*} ;;
            *) continue ;;
        esac
        if grep -qxF "$line" "$release" 2>/dev/null; then continue; fi
        if grep -qE "^${key}=" "$release" 2>/dev/null; then diverged=$((diverged + 1)); fi
        printf '%s\n' "$line" >> "$local_file"
        kept=$((kept + 1))
    done < "$env_file"

    log_info "Split the settings: ${kept} kept as yours, ${diverged} of them differing from this release"
    log_info "The file as it was: ${local_file%/*}/env.before-split"
}

# Waiving the accelerator check is not enough to install: left alone, the release
# keeps COMPOSE_PROFILES="nim" and the stack still asks docker for an nvidia
# device it will not find. Measured on a machine with none: the engines are
# created, then `could not select device driver "nvidia"` stops the install after
# the images have already been pulled.
#
# It goes to local.env, which render_settings lets win over release.env, so an
# operator who wrote these two by hand keeps exactly what they chose.
write_the_settings_a_machine_without_an_accelerator_needs() {
    local local_file=$1 compose_files

    compose_files=$(env_get "$local_file" COMPOSE_FILE 2>/dev/null || true)
    [[ -n "$compose_files" ]] || compose_files=$(release_declares COMPOSE_FILE || echo "compose.yaml")

    case "$compose_files" in
        *compose.no-gpu.yaml*) ;;
        *) env_set "$local_file" COMPOSE_FILE "${compose_files}:compose.no-gpu.yaml" ;;
    esac

    if [[ "$(env_get "$local_file" COMPOSE_PROFILES 2>/dev/null || true)" != "" ]] \
        || [[ -n "$(release_declares COMPOSE_PROFILES || true)" ]]; then
        env_set "$local_file" COMPOSE_PROFILES ""
    fi

    log_info "Inference left to another machine: no engine is started here"
    # ut-llm loads a CUDA build of llama.cpp when it starts, so without the
    # accelerator it does not run at all, and nothing answers over documents.
    log_warn "No accelerator for llm either: chats over documents answer nothing on this machine."
    log_warn "  Give it a GPU and install without --no-gpu to have them."

    if the_inference_url_names_a_service_this_machine_will_not_run; then
        log_warn "VLLM_LLM_BASE_URL still names ${INTERNAL_INFERENCE_HOST}, an engine this"
        log_warn "  machine no longer starts. The platform will come up and answer nothing"
        log_warn "  a model has to write. Point it at a machine that serves inference:"
        log_warn "    echo 'VLLM_LLM_BASE_URL=\"https://<that machine>/v1\"' | sudo tee -a ${local_file}"
    fi
}

inference_base_url() {
    local url=${1%/}
    printf '%s/v1' "${url%/v1}"
}

the_key_file_holds_one_key() {
    local key
    [[ -r "$1" ]] || return 1
    (( $(grep -c . "$1") == 1 )) || return 1
    key=$(tr -d '\r\n' < "$1")
    [[ -n "$key" && "$key" != *[[:space:]]* ]]
}

host_of_url() {
    local rest=${1#*://}
    rest=${rest%%/*}
    printf '%s' "${rest%:*}"
}

names_an_mdns_host() {
    local host
    host=$(printf '%s' "${1%.}" | tr '[:upper:]' '[:lower:]')
    [[ "$host" == *.local ]]
}

certificate_covers() {
    local names=$1 name=$2
    [[ "$names" == *",DNS:${name},"* || "$names" == *",DNS:*.${name#*.},"* ]]
}

problem_with_the_given_certificate() {
    local dir=$CERTIFICATE_DIR file names name missing=()
    [[ "$dir" == /* ]] || { echo "--certificate-dir takes an absolute path, not ${dir}: Compose mounts it from there"; return 0; }
    for file in fullchain.pem privkey.pem; do
        [[ -r "$dir/$file" ]] || { echo "${dir} holds no readable ${file}"; return 0; }
    done
    command -v openssl >/dev/null 2>&1 || { echo "openssl is needed to check the certificate in ${dir}, and this machine has none"; return 0; }
    openssl x509 -in "$dir/fullchain.pem" -noout 2>/dev/null || { echo "${dir}/fullchain.pem is not a certificate"; return 0; }
    openssl x509 -in "$dir/fullchain.pem" -noout -checkend 0 >/dev/null 2>&1 \
        || { echo "the certificate in ${dir} has expired"; return 0; }
    [[ "$(openssl x509 -in "$dir/fullchain.pem" -noout -pubkey 2>/dev/null)" == "$(openssl pkey -in "$dir/privkey.pem" -pubout 2>/dev/null)" ]] \
        || { echo "${dir}/privkey.pem is not the key of ${dir}/fullchain.pem"; return 0; }
    names=",$(openssl x509 -in "$dir/fullchain.pem" -noout -ext subjectAltName 2>/dev/null | tr -d ' \n' | sed 's/^[^:]*://'),"
    for name in "$DOMAIN" "llms.$DOMAIN" "assistants.$DOMAIN" "admin.$DOMAIN" "builder.$DOMAIN"; do
        certificate_covers "$names" "$name" || missing+=("$name")
    done
    (( ${#missing[@]} == 0 )) && return 1
    echo "the certificate in ${dir} does not cover ${missing[*]}"
}

problem_with_the_given_proxy() {
    local range
    for range in ${BEHIND_PROXY//,/ }; do
        case "$range" in
            0.0.0.0/0|::/0) echo "--behind-proxy ${range} would believe a forwarded address from anyone"; return 0 ;;
        esac
        [[ "$range" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$ || "$range" =~ ^[0-9a-fA-F:]+:[0-9a-fA-F:]*(/[0-9]{1,3})?$ ]] \
            || { echo "--behind-proxy takes address ranges such as 10.42.0.0/16, not ${range}"; return 0; }
    done
    return 1
}

die_on_a_way_for_tls_to_end_given_wrong() {
    local problem=""
    if [[ -n "$CERTIFICATE_DIR" && -n "$BEHIND_PROXY" ]]; then
        problem="--certificate-dir and --behind-proxy exclude each other: either this machine serves the certificate, or your load balancer does"
    elif [[ -n "$CERTIFICATE_DIR" ]]; then
        problem=$(problem_with_the_given_certificate) || return 0
    elif [[ -n "$BEHIND_PROXY" ]]; then
        problem=$(problem_with_the_given_proxy) || return 0
    else
        return 0
    fi
    die "$problem"
}

warn_on_generated_apps_the_certificate_leaves_out() {
    local names
    [[ -n "$CERTIFICATE_DIR" ]] || return 0
    names=",$(openssl x509 -in "$CERTIFICATE_DIR/fullchain.pem" -noout -ext subjectAltName 2>/dev/null | tr -d ' \n' | sed 's/^[^:]*://'),"
    [[ "$names" == *",DNS:*.apps.${DOMAIN},"* ]] && return 0
    log_warn "The certificate does not cover *.apps.${DOMAIN}: the App Builder's generated apps will fail TLS."
    log_warn "  A second wildcard goes in UT_APPS_CERT_FILE and UT_APPS_KEY_FILE (docs/certificates-and-dns.md)."
}

write_how_tls_ends() {
    local local_file=$1
    if [[ -n "$CERTIFICATE_DIR" ]]; then
        env_set "$local_file" UT_INGRESS_MODE custom
        env_set "$local_file" UT_CADDY_SCHEME https
        env_set "$local_file" UT_CERT_DIR "$CERTIFICATE_DIR"
        log_info "TLS ends here, with the certificate in ${CERTIFICATE_DIR}"
    elif [[ -n "$BEHIND_PROXY" ]]; then
        env_set "$local_file" UT_INGRESS_MODE edge
        env_set "$local_file" UT_CADDY_SCHEME http
        env_set "$local_file" UT_TRUSTED_PROXIES "$BEHIND_PROXY"
        log_info "TLS ends at your load balancer; forwarded addresses are believed from ${BEHIND_PROXY} only"
    fi
}

write_the_settings_a_control_plane_with_an_accelerator_needs() {
    local local_file=$1
    if [[ "$(env_get "$local_file" COMPOSE_PROFILES 2>/dev/null || true)" != "" ]] \
        || [[ -n "$(release_declares COMPOSE_PROFILES || true)" ]]; then
        env_set "$local_file" COMPOSE_PROFILES ""
    fi
    log_info "No engine started here; the GPU stays with llm, which searches the documents"
}

models_listed() {
    local entry
    for entry in "$INSTALL_DIR"/models/*.env; do
        [[ -f "$entry" ]] && basename "$entry" .env
    done
}

die_on_a_model_nobody_listed() {
    if [[ -n "$ENGINE_CHOICE" && "$ENGINE_CHOICE" != nim && "$ENGINE_CHOICE" != vllm ]]; then
        log_error "--engine takes nim or vllm, not ${ENGINE_CHOICE}"
        exit 1
    fi
    [[ -z "$MODEL_ID" || -f "$INSTALL_DIR/models/${MODEL_ID}.env" ]] && return 0
    log_error "No model called ${MODEL_ID} in ${INSTALL_DIR}/models. This release serves:"
    models_listed | sed 's/^/  /' >&2
    log_error "  Give one of those to --model, or leave it out to keep the model already set."
    exit 1
}

# The name nvidia-smi gives, lowered, without the vendor: "NVIDIA GB10" is gb10.
# A proof is kept per family, so that is what a model is chosen by.
gpu_family() {
    an_accelerator_answers || return 0
    nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 \
        | tr '[:upper:]' '[:lower:]' | sed 's/^nvidia //; s/[^a-z0-9]\{1,\}/-/g; s/-$//'
}

entry_has_variant() {
    local entry=$1 engine=$2
    case "$engine" in
        nim)  grep -q '^NIM_LLM_MODEL_PATH=' "$entry" ;;
        vllm) grep -q '^VLLM_ENGINE_IMAGE=' "$entry" ;;
    esac
}

proof_of() {
    local id=$1 engine=$2 family=$3
    printf '%s/models/proven/%s.%s.%s.md' "$INSTALL_DIR" "$id" "$engine" "$family"
}

engine_proven_for() {
    local id=$1 family=$2 engine entry="$INSTALL_DIR/models/$1.env"
    for engine in ${ENGINE_CHOICE:-nim vllm}; do
        entry_has_variant "$entry" "$engine" && [[ -f "$(proof_of "$id" "$engine" "$family")" ]] \
            && { printf '%s' "$engine"; return 0; }
    done
    return 1
}

die_on_a_model_not_proven_here() {
    local family=$1 id engine proven=""
    log_error "${MODEL_ID}${ENGINE_CHOICE:+ on ${ENGINE_CHOICE}} has not been proven on ${family:-an unknown GPU}."
    while read -r id; do
        [[ -n "$id" ]] || continue
        engine=$(ENGINE_CHOICE="" engine_proven_for "$id" "$family") && proven+="  ${id}, on ${engine}"$'\n'
    done <<< "$(models_listed)"
    if [[ -n "$proven" ]]; then
        log_error "  Proven on ${family}:"
        printf '%s' "$proven" >&2
    else
        log_error "  No model of this release has been proven on ${family:-it} yet."
    fi
    exit 1
}

size_of_the_weights_of() {
    local list="$INSTALL_DIR/models/weights/$1.txt"
    [[ -f "$list" ]] || { printf 'size not pinned'; return 0; }
    LC_ALL=C awk '{ bytes += $2 } END { printf "%.1f GB", bytes / 1e9 }' "$list"
}

list_the_models_this_machine_serves() {
    local id entry family="" engine served code unproven="" size license
    this_machine_goes_without_its_accelerator || family=$(gpu_family)
    while read -r id; do
        [[ -n "$id" ]] || continue
        entry="$INSTALL_DIR/models/${id}.env"
        if this_machine_goes_without_its_accelerator; then
            served="generation from another machine"
        elif engine=$(ENGINE_CHOICE="" engine_proven_for "$id" "$family"); then
            served="$( [[ "$engine" == vllm ]] && echo vLLM || echo NIM ) on ${family}"
        else
            unproven+=" ${id}"
            continue
        fi
        code=""
        grep -q -- '--trust-remote-code' "$entry" && code="runs code of its own"
        size=$(size_of_the_weights_of "$id") || true
        license=$(env_get "$entry" MODEL_LICENSE 2>/dev/null || echo 'license not read')
        printf '%-28s %-34s %-10s %-14s %s\n' "$id" "$served" "$size" "$license" "$code"
        [[ -z "$EVENTS_FILE" ]] || say_event model ",\"id\":$(json_string "$id"),\"served\":$(json_string "$served"),\"size\":$(json_string "$size"),\"license\":$(json_string "$license"),\"runs_its_own_code\":$( [[ -n "$code" ]] && echo true || echo false )"
    done <<< "$(models_listed)"
    [[ -z "$unproven" ]] || log_warn "Not proven on ${family:-an unknown GPU}:${unproven}"
}

# Copied line by line rather than through env_set: a passthrough argument holds
# JSON in single quotes, and env_set would wrap it in double quotes that compose
# then reads as the end of the value.
put_the_line_in_place_of_its_key() {
    local local_file=$1 line=$2 key tmp
    key=${line%%=*}
    tmp=$(mktemp)
    grep -v -E "^[[:space:]]*${key}=" "$local_file" > "$tmp" || true
    printf '%s\n' "$line" >> "$tmp"
    cat "$tmp" > "$local_file"
    rm -f "$tmp"
}

# The model is kept by name, and its entry applied again on every install: a
# release that moves an entry to a new engine reaches the boxes that chose it.
write_the_settings_the_model_needs() {
    local local_file=$1 entry engine="" family line compose_files chosen
    [[ -n "$MODEL_ID" ]] || MODEL_ID=$(env_get "$local_file" UT_MODEL 2>/dev/null || true)
    [[ -n "$ENGINE_CHOICE" ]] || ENGINE_CHOICE=$(env_get "$local_file" UT_MODEL_ENGINE 2>/dev/null || true)
    [[ -n "$MODEL_ID" ]] || return 0
    entry="$INSTALL_DIR/models/${MODEL_ID}.env"
    [[ -f "$entry" ]] || die_on_a_model_nobody_listed

    if ! this_machine_goes_without_its_accelerator && [[ -z "$INFERENCE_FROM" ]]; then
        family=$(gpu_family)
        engine=$(engine_proven_for "$MODEL_ID" "$family") || die_on_a_model_not_proven_here "$family"
    fi

    case "$engine" in
        nim)  chosen=NIM_ ;;
        vllm) chosen=VLLM_ENGINE_ ;;
        *)    chosen=none ;;
    esac
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            "$chosen"*=*) put_the_line_in_place_of_its_key "$local_file" "$line" ;;
            NIM_*=*|VLLM_ENGINE_*=*|MODEL_*=*) ;;
            [A-Z_]*=*) put_the_line_in_place_of_its_key "$local_file" "$line" ;;
        esac
    done < "$entry"
    env_set "$local_file" UT_MODEL "$MODEL_ID"
    [[ -z "$ENGINE_CHOICE" ]] || env_set "$local_file" UT_MODEL_ENGINE "$ENGINE_CHOICE"

    compose_files=$(env_get "$local_file" COMPOSE_FILE 2>/dev/null || true)
    [[ -n "$compose_files" ]] || compose_files=$(release_declares COMPOSE_FILE || echo "compose.yaml")
    case "$engine:$compose_files" in
        vllm:*compose.engine-vllm.yaml*) ;;
        vllm:*) env_set "$local_file" COMPOSE_FILE "${compose_files}:compose.engine-vllm.yaml" ;;
        *:*compose.engine-vllm.yaml*) env_set "$local_file" COMPOSE_FILE "${compose_files//:compose.engine-vllm.yaml/}" ;;
    esac
    if [[ -z "$engine" ]]; then
        log_info "Model ${MODEL_ID}: its names only, generation comes from another machine"
    else
        log_info "Model ${MODEL_ID}, served by $( [[ "$engine" == vllm ]] && echo vLLM || echo NIM ), proven on ${family} ($(basename "$(proof_of "$MODEL_ID" "$engine" "$family")"))"
    fi
}

BACKUP_DESTINATION_MARKER=".understandtech-backup-destination"

filesystem_of_the_nearest_existing() {
    local path=$1
    while [[ ! -e "$path" && "$path" != "/" ]]; do path=$(dirname "$path"); done
    stat -c %d "$path"
}

the_backup_destination_is_off_this_machine() {
    local filesystem
    filesystem=$(stat -c %d "$1")
    [[ "$filesystem" != "$(stat -c %d /)" && "$filesystem" != "$(filesystem_of_the_nearest_existing "$DATA_DIR")" ]]
}

die_on_a_backup_destination_that_is_not_one() {
    local destination=$1 reason=$2
    log_error "BACKUP_FILES_DESTINATION is ${destination}, and ${reason}."
    log_error ""
    log_error "Either mount the share or the disk there, or empty BACKUP_FILES_DESTINATION"
    log_error "to keep the backup on this machine:"
    log_error ""
    log_error "  sudoedit $(settings_directory "$INSTALL_DIR/.env")/local.env"
    exit 1
}

backup_destination_problem() {
    local destination=$1
    if [[ "$destination" != /* || ! -d "$destination" ]]; then
        echo "it is not an existing directory given by its full path"
    elif ! the_backup_destination_is_off_this_machine "$destination"; then
        echo "it sits on this machine's own disk: nothing is mounted there"
    elif ! touch "$destination/$BACKUP_DESTINATION_MARKER" 2>/dev/null; then
        echo "it cannot be written to"
    fi
}

die_on_two_backup_destinations() {
    local local_file=$1 repository
    repository=$(env_get "$local_file" BACKUP_FILES_REPOSITORY 2>/dev/null || true)
    the_backup_repository_is_reached_over_the_network "$repository" || return 0
    [[ -n "$(env_get "$local_file" BACKUP_FILES_DESTINATION 2>/dev/null || true)" ]] || return 0
    log_error "BACKUP_FILES_DESTINATION and BACKUP_FILES_REPOSITORY both say where the backup goes."
    log_error ""
    log_error "Keep one of them in $(settings_directory "$INSTALL_DIR/.env")/local.env: a disk the host"
    log_error "mounts, or ${repository%%:*} over the network."
    exit 1
}

# A destination on the root disk, or on the one holding DATA_ROOT, is either a
# mount point with nothing mounted yet or no destination at all: the backup
# would die with the machine. The marker is what files-backup looks for before
# each run, so it is only written once that has been ruled out. A destination
# accepted before and gone now stops nothing: files-backup refuses to write
# without the marker, and an update has no reason to wait for a NAS.
write_the_settings_a_backup_destination_needs() {
    local local_file=$1 destination compose_files problem

    destination=$(env_get "$local_file" BACKUP_FILES_DESTINATION 2>/dev/null || true)
    compose_files=$(env_get "$local_file" COMPOSE_FILE 2>/dev/null || true)
    [[ -n "$compose_files" ]] || compose_files=$(release_declares COMPOSE_FILE || echo "compose.yaml")

    if [[ -z "$destination" ]]; then
        case "$compose_files" in
            *:compose.backup-mount.yaml*)
                env_set "$local_file" COMPOSE_FILE "${compose_files//:compose.backup-mount.yaml/}"
                log_info "Backups kept on this machine again" ;;
        esac
        return 0
    fi

    problem=$(backup_destination_problem "$destination")
    if [[ -n "$problem" ]]; then
        case "$compose_files" in
            *compose.backup-mount.yaml*)
                log_warn "BACKUP_FILES_DESTINATION is ${destination}, and ${problem}."
                log_warn "  The install goes on; the backup writes nothing until it is back."
                return 0 ;;
        esac
        die_on_a_backup_destination_that_is_not_one "$destination" "$problem"
    fi

    case "$compose_files" in
        *compose.backup-mount.yaml*) ;;
        *) env_set "$local_file" COMPOSE_FILE "${compose_files}:compose.backup-mount.yaml" ;;
    esac
    log_info "Backups go to ${destination}, off this machine's disk"
}

the_backup_repository_is_reached_over_the_network() {
    case "$1" in
        s3:*|sftp:*|rest:*|b2:*|azure:*|gs:*|swift:*|rclone:*) return 0 ;;
        *) return 1 ;;
    esac
}

sftp_host_of() {
    local address=${1#sftp:}
    address=${address#//}
    address=${address#*@}
    address=${address%%[:/]*}
    printf '%s' "$address"
}

# The overlay gives files-backup a network with a gateway, and Docker cannot
# narrow it to one destination: it is only added when the repository needs it.
write_the_settings_a_backup_over_the_network_needs() {
    local local_file=$1 repository compose_files ssh_dir host

    repository=$(env_get "$local_file" BACKUP_FILES_REPOSITORY 2>/dev/null || true)
    compose_files=$(env_get "$local_file" COMPOSE_FILE 2>/dev/null || true)
    [[ -n "$compose_files" ]] || compose_files=$(release_declares COMPOSE_FILE || echo "compose.yaml")

    if ! the_backup_repository_is_reached_over_the_network "$repository"; then
        case "$compose_files" in
            *:compose.backup-network.yaml*)
                env_set "$local_file" COMPOSE_FILE "${compose_files//:compose.backup-network.yaml/}"
                log_info "The backup service has no way off this machine again" ;;
        esac
        return 0
    fi

    case "$compose_files" in
        *compose.backup-network.yaml*) ;;
        *) env_set "$local_file" COMPOSE_FILE "${compose_files}:compose.backup-network.yaml" ;;
    esac
    ssh_dir=$(env_get "$local_file" BACKUP_FILES_SSH_DIR 2>/dev/null || true)
    if [[ -z "$ssh_dir" ]]; then
        ssh_dir="$(settings_directory "$INSTALL_DIR/.env")/backup-ssh"
        env_set "$local_file" BACKUP_FILES_SSH_DIR "$ssh_dir"
    fi
    install -d -m 700 "$ssh_dir"
    log_warn "The backup service can now reach the network, to send to ${repository%%:*}."

    [[ "$repository" == sftp:* ]] || return 0
    host=$(sftp_host_of "$repository")
    if [[ ! -s "$ssh_dir/known_hosts" ]] || ! grep -q "$host" "$ssh_dir/known_hosts"; then
        log_warn "  But no host key is pinned for ${host}, so every backup will be refused."
        log_warn "  Check the fingerprint with whoever runs ${host}, then:"
        log_warn "    ssh-keyscan ${host} | sudo tee ${ssh_dir}/known_hosts"
    fi
    if [[ ! -s "$ssh_dir/id_ed25519" ]]; then
        log_warn "  And no key to log in with. Make one, and give ${host} its public half:"
        log_warn "    sudo ssh-keygen -t ed25519 -N '' -f ${ssh_dir}/id_ed25519"
    fi
}

INTERNAL_INFERENCE_HOST=""

# The release points VLLM_LLM_BASE_URL at nim-llm, a service on this machine's
# own compose network. On a control plane that service is never started, so the
# default is not a remote address waiting to be used — it is a dead one, and the
# summary would otherwise announce it as the source of inference.
the_inference_url_names_a_service_this_machine_will_not_run() {
    local url host
    # Read in the order render_settings resolves them, and local.env before the
    # release: on a first install .env does not exist yet, and an operator who
    # prepared local.env beforehand would otherwise be told their address is the
    # dead default.
    url=$(env_get "$INSTALL_DIR/.env" VLLM_LLM_BASE_URL 2>/dev/null || true)
    [[ -n "$url" ]] || url=$(env_get "$(settings_directory "$INSTALL_DIR/.env")/local.env" VLLM_LLM_BASE_URL 2>/dev/null || true)
    [[ -n "$url" ]] || url=$(release_declares VLLM_LLM_BASE_URL || true)
    host=${url#*://}; host=${host%%/*}; host=${host%%:*}
    INTERNAL_INFERENCE_HOST="$host"
    case "$host" in
        nim-llm|nim-vlm|llm|localhost|127.0.0.1|"") return 0 ;;
        *) return 1 ;;
    esac
}

# Compose reads .env from the project directory and interpolates ${} from it, so
# it has to stay one flat file — a list of sources would not be read at all.
# The registry keeps every image under the path it has on its own registry,
# Docker Hub's short names under library/, so a byte-for-byte copy keeps the
# digest release.env pins.
image_in_registry() {
    local reference=$1 first
    if [[ "$reference" == */* ]]; then
        first=${reference%%/*}
        case "$first" in
            *.*|*:*|localhost) reference=${reference#*/} ;;
        esac
    else
        reference="library/${reference}"
    fi
    printf '%s/%s' "$REGISTRY" "$reference"
}

render_settings() {
    local target=$1 local_file=$2 release key line overridden tmp
    release="$INSTALL_DIR/release.env"
    [[ -f "$release" ]] || die "No release.env in ${INSTALL_DIR}."

    overridden=$(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "$local_file" 2>/dev/null | tr -d '=' || true)
    tmp=$(mktemp)
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            [A-Za-z_]*=*)
                key=${line%%=*}
                if key_is_overridden_locally "$key" "$overridden"; then continue; fi
                if [[ "$REGISTRY" != "ghcr.io" && "$line" =~ ^[A-Z0-9_]+_IMAGE=\"(.+)\"$ ]]; then
                    line="${key}=\"$(image_in_registry "${BASH_REMATCH[1]}")\""
                fi
                ;;
        esac
        printf '%s\n' "$line" >> "$tmp"
    done < "$release"

    if [[ -s "$local_file" ]]; then
        printf '\n# ---------------------------------------------- yours, never replaced ----\n' >> "$tmp"
        printf '# Edit %s, not this file: this one is rebuilt on every install.\n\n' "$local_file" >> "$tmp"
        cat "$local_file" >> "$tmp"
    fi

    cat "$tmp" > "$target"
    rm -f "$tmp"
}

# compose.yaml derives the allowed origins from UT_DOMAIN unless they are set,
# and an install taken from a checkout often carries them set. Left on the old
# domain, the API refuses to hand a session to any satellite app.
move_the_allowed_origins_to_the_new_domain() {
    local local_file=$1 previous=$2 origins moved
    [[ -n "$previous" ]] || return 0
    origins=$(env_get "$local_file" EXTRA_ALLOWED_ORIGINS 2>/dev/null || true)
    [[ -n "$origins" ]] || return 0
    moved=${origins//.${previous}/.${DOMAIN}}
    moved=${moved//\/\/${previous}/\/\/${DOMAIN}}
    [[ "$moved" != "$origins" ]] || return 0
    env_set "$local_file" EXTRA_ALLOWED_ORIGINS "$moved"
    log_info "Allowed origins moved from ${previous} to ${DOMAIN}"
}

# An engine address naming a service of this stack that no compose file declares
# any more answers nothing: the vision engine left the release on 2026-10-06, and
# a settings file that still named it broke every chat at its last step.
warn_on_engine_addresses_no_service_answers() {
    local key url host files file declared
    files=$(env_get "$INSTALL_DIR/.env" COMPOSE_FILE 2>/dev/null || true)
    files=${files:-compose.yaml}
    for key in VLLM_LLM_BASE_URL VLLM_VLM_BASE_URL; do
        url=$(env_get "$INSTALL_DIR/.env" "$key" 2>/dev/null || true)
        host=${url#*://}; host=${host%%/*}; host=${host%%:*}
        [[ -n "$host" && "$host" != *.* && "$host" != localhost ]] || continue
        declared=false
        for file in ${files//:/ }; do
            grep -qE "^  ${host}:$" "$INSTALL_DIR/$file" 2>/dev/null && declared=true
        done
        $declared && continue
        log_warn "${key} names ${host}, a service this stack does not run: every request it carries will fail."
        log_warn "  Remove the line from $(settings_directory "$INSTALL_DIR/.env")/local.env to take the release's address."
    done
}

step_configure() {
    log_step "Writing the configuration"

    local env_file="$INSTALL_DIR/.env" local_file
    create_settings_file_behind "$env_file"

    local_file="$(settings_directory "$env_file")/local.env"
    install -d -m 750 "$(dirname "$local_file")"
    [[ -f "$local_file" ]] || install -m 600 /dev/null "$local_file"
    local source_settings="$env_file" previous
    if [[ ! -s "$env_file" ]] && previous=$(settings_of_a_previous_install); then
        source_settings="$previous"
        log_info "Settings taken from ${previous} — that checkout is left as it is"
    fi
    migrate_existing_settings_into_local "$source_settings" "$local_file"

    local previous_domain
    previous_domain=$(env_get "$local_file" UT_DOMAIN || true)
    if [[ "$previous_domain" != "$DOMAIN" ]]; then
        env_set "$local_file" UT_DOMAIN "$DOMAIN"
        log_info "Address set to ${DOMAIN} — every other URL derives from it"
        move_the_allowed_origins_to_the_new_domain "$local_file" "$previous_domain"
    fi

    write_the_settings_a_compute_role_needs "$local_file"
    write_the_settings_an_arbiter_role_needs "$local_file"
    write_the_settings_the_model_needs "$local_file"
    write_the_settings_a_compute_node_needs "$local_file"
    write_how_tls_ends "$local_file"
    if this_machine_goes_without_its_accelerator; then
        write_the_settings_a_machine_without_an_accelerator_needs "$local_file"
    elif [[ -n "$INFERENCE_FROM" ]]; then
        write_the_settings_a_control_plane_with_an_accelerator_needs "$local_file"
    fi
    die_on_two_backup_destinations "$local_file"
    write_the_settings_a_backup_destination_needs "$local_file"
    write_the_settings_a_backup_over_the_network_needs "$local_file"

    render_settings "$env_file" "$local_file"
    generate_database_credentials "$env_file" "$local_file"
    generate_application_secrets "$local_file"
    give_the_api_the_openai_key_it_needs_to_start "$env_file" "$local_file"
    render_settings "$env_file" "$local_file"
    warn_on_engine_addresses_no_service_answers

    chmod 600 "$env_file" "$local_file"
    chown "$TARGET_USER" "$env_file" "$local_file" 2>/dev/null || true

    mkdir -p "$DATA_DIR/app-data" "$DATA_DIR/appbuilder"/{workspaces,prod-workspaces,traefik-dynamic}
    log_info "Data directories ready under ${DATA_DIR}"
}

# The platform's API builds its OpenAI client while it loads its modules, from
# OA_KEY, so an empty value is an exception rather than a disabled feature: the
# container restarts forever and the eight services that depend on it never
# start. Measured on a bare install, 2026-09-21 — thirty-five restarts before
# anyone read far enough up the Python traceback to find the name.
#
# Any value that is not empty keeps it up — the client is built, never called —
# and a key the operator gives in local.env is never replaced.
give_the_api_the_openai_key_it_needs_to_start() {
    local env_file=$1 local_file=$2
    [[ -n "$(env_get "$env_file" OA_KEY 2>/dev/null || true)" ]] && return 0
    env_set "$local_file" OA_KEY "not-configured"
    log_info "OA_KEY set to \"not-configured\": the platform API does not start without a value"
    log_info "  A real OpenAI key, if one is ever needed, goes in ${local_file}"
}

step_check_resolution_of_the_inference_address() {
    local address
    address=$(env_get "$INSTALL_DIR/.env" UT_INFERENCE_ADDRESS 2>/dev/null || echo "$DOMAIN")
    log_step "Checking how ${address} resolves"
    if [[ "$address" =~ ^[0-9.]+$ ]]; then
        log_info "${address} is an address: the control plane needs no record to reach it"
    elif getent hosts "$address" >/dev/null 2>&1; then
        log_info "${address} resolves"
    else
        log_warn "${address} does not resolve yet. The control plane needs one record:"
        log_warn "    ${address}.      A   <this machine's address>"
    fi
}

step_check_resolution() {
    if this_machine_is_a_compute_node; then
        step_check_resolution_of_the_inference_address
        return 0
    fi
    log_step "Checking how ${DOMAIN} resolves"

    if [[ "$DOMAIN" == *.local ]]; then
        log_warn "${DOMAIN} is an mDNS name: it only resolves on this network"
        log_warn "  segment. A box in a datacentre will be unreachable — use a"
        log_warn "  domain from the customer's DNS zone instead."
        command -v avahi-daemon >/dev/null 2>&1 \
            || log_warn "  avahi is not installed, so nothing publishes it either."
        return 0
    fi

    if getent hosts "$DOMAIN" >/dev/null 2>&1; then
        log_info "${DOMAIN} resolves"
    else
        log_warn "${DOMAIN} does not resolve yet. Two records are needed:"
        log_warn "    ${DOMAIN}.      A   <this machine's address>"
        log_warn "    *.${DOMAIN}.    A   <this machine's address>"
        log_warn "  The wildcard covers the satellite apps and every generated app."
    fi
}

step_docker_group() {
    log_step "Granting Docker access"

    if [[ "$TARGET_USER" == "root" ]]; then
        log_info "Running as root — nothing to grant"
        return 0
    fi

    if id -nG "$TARGET_USER" | tr ' ' '\n' | grep -qx docker; then
        log_info "${TARGET_USER} is already in the docker group"
        return 0
    fi

    usermod -aG docker "$TARGET_USER"
    log_info "Added ${TARGET_USER} to the docker group"
    log_warn "${TARGET_USER} must log out and back in before running docker unprivileged"
}

step_networks() {
    log_step "Preparing Docker networks"

    if ! appbuilder_enabled; then
        log_info "App Builder disabled — no extra network needed"
        return 0
    fi

    if docker network inspect proxy >/dev/null 2>&1; then
        log_info "Network 'proxy' already present"
    else
        docker network create proxy >/dev/null
        log_info "Created network 'proxy' — the App Builder overlay declares it external"
    fi
}

compose_reports_progress_as_json() { compose_in_dir --progress json version >/dev/null 2>&1; }

images_the_release_runs() { compose_in_dir config --images 2>/dev/null | sort -u | grep -c . || true; }

say_each_image_as_it_lands() {
    local total=$1 started=$SECONDS landed=0 line image
    (( total > 0 )) || total="?"
    while IFS= read -r line; do
        [[ "$line" == "{"* ]] || { log "$line"; continue; }
        if [[ "$line" == *'"error":true'* ]]; then
            log_error "$(sed -n 's/.*"message":"\(.*\)"}$/\1/p' <<< "$line")"
            continue
        fi
        [[ "$line" == *'"id":"Image '* ]] || continue
        image=${line#*\"id\":\"Image }
        image=${image%%\"*}
        case "$line" in
            *'"status":"Done"'*)
                landed=$((landed + 1))
                log "     ${landed}/${total}  ${image}  ($(( (SECONDS - started) / 60 )) min)"
                [[ -z "$EVENTS_FILE" ]] || say_event image ",\"landed\":${landed},\"total\":$( [[ "$total" == "?" ]] && echo null || echo "$total" ),\"name\":$(json_string "$image"),\"minutes\":$(( (SECONDS - started) / 60 ))"
                ;;
            *'"status":"Error"'*)
                log_error "${image}: $(sed -n 's/.*"text":"\([^"]*\)".*/\1/p' <<< "$line")"
                ;;
        esac
    done
}

# Compose draws its progress bars only on a terminal, and start_logging sends
# everything through tee: without JSON, a pull of tens of GB shows "0B" per layer.
# The JSON comes on stderr, beside any error that is not JSON.
# The tools a folder carries, as ut-get --prepare names them, as docker archives:
# overlay2 loads no OCI archive skopeo writes. A tool is loaded only when its
# config has one of these digests, arm64 then amd64 for each; docker load then
# refuses any layer the config does not list, in either store.
FOLDER_REGISTRY_TOOL="ghcr.io/distribution/distribution:3.0.0@sha256:4ba3adf47f5c866e9a29288c758c5328ef03396cb8f5f6454463655fa8bc83e2"
FOLDER_SKOPEO_TOOL="quay.io/skopeo/stable:v1.20.0@sha256:47853bb9fb24202af9110531ebd6e43c5f97701254ca290596640290d17942f4"
FOLDER_TOOL_CONFIGS="sha256:ab30a3bba4ba93e95d10e1805239b169e9ac0c0a8a25df9715192ac98cdcb261 sha256:4030e89c351e33ab32ba5abff03c553a0a9af89b118814b260556e5c1948bf36 sha256:376e07f615c23241d20f43a5816d9e5faec33b44838cef233ee30faf70b882f6 sha256:ed9ceaa074fd5f77d47b826b5be839568ba4676ff1011a5cbf60b73038dd8fa3"
FOLDER_REGISTRY_ADDRESS="127.0.0.1:15000"
FOLDER_LOADER="ut-images-from-a-folder"

repository_of() {
    local repository=${1%@*} last
    last=${repository##*/}
    [[ "$last" == *:* ]] && repository=${repository%:*}
    printf '%s' "$repository"
}

folder_path_of() {
    printf 'images/%s/%s' "$(repository_of "$1" | tr '/:' '__')" "${1#*@sha256:}"
}

name_in_the_folder_registry() {
    local reference=$1 repository first
    repository=$(repository_of "$reference")
    first=${repository%%/*}
    [[ "$repository" == */* && ( "$first" == *.* || "$first" == *:* ) ]] && repository=${repository#*/}
    printf '%s/%s@%s' "$FOLDER_REGISTRY_ADDRESS" "$repository" "${reference#*@}"
}

role_this_install_takes() {
    local compose_files
    compose_files=$(env_get "$INSTALL_DIR/.env" COMPOSE_FILE 2>/dev/null || true)
    if [[ -n "$ARBITER_ADDRESS" || "$compose_files" == *compose.arbiter.yaml* ]]; then
        echo arbiter
    elif [[ -n "$COMPUTE_ADDRESS" || "$compose_files" == *compose.compute.yaml* ]]; then
        echo compute
    elif [[ -n "$INFERENCE_FROM" ]] || $NO_GPU || [[ "$compose_files" == *compose.remote-inference.yaml* || "$compose_files" == *compose.no-gpu.yaml* ]]; then
        echo control-plane
    else
        echo appliance
    fi
}

# The digests the folder's bill of materials says this role runs, one per line;
# nothing for a bill that names no roles, whose images are then all required.
digests_the_role_runs() {
    local bill role=$1
    bill=$(ls "$IMAGES_FROM"/understandtech_*.cdx.json 2>/dev/null | head -1 || true)
    [[ -n "$bill" ]] || return 0
    sed -n 's|.*"purl": "pkg:oci/[^@]*@\(sha256:[0-9a-f]\{64\}\)?[^"]*&roles=\([^&#"]*\).*|\1 \2|p' "$bill" \
        | while read -r digest roles; do
            [[ "+${roles}+" == *"+${role}+"* ]] && printf '%s\n' "$digest"
        done
}

# What the stack runs: release.env, with the settings file's own choices on top
# (a model's engine), as "<variable>=<image>" lines; from a folder, only the
# images its bill says this machine's role runs.
# Whether a service belongs to the role is read from the image the release gives
# it; what is required is the image the settings file runs, its own if it has one.
images_the_stack_runs() {
    local line digests released
    if [[ -n "$IMAGES_FROM" ]]; then
        digests=$(digests_the_role_runs "$(role_this_install_takes)" || true)
        if [[ -n "$digests" ]]; then
            every_image_the_stack_names | while IFS= read -r line; do
                released=$(env_get "$INSTALL_DIR/release.env" "${line%%=*}" 2>/dev/null || true)
                if [[ -z "$released" ]] || grep -qxF "${released##*@}" <<< "$digests"; then
                    printf '%s\n' "$line"
                fi
            done
            return 0
        fi
    fi
    every_image_the_stack_names
}

die_on_a_folder_for_another_role() {
    local prepared here
    prepared=$(cat "$IMAGES_FROM/role" 2>/dev/null || echo appliance)
    here=$(role_this_install_takes)
    [[ "$prepared" == appliance || "$prepared" == "$here" ]] && return 0
    die "${IMAGES_FROM} was prepared for the ${prepared} role, and this machine is installed as ${here}: prepare it again with ut-get --prepare --role ${here}"
}

every_image_the_stack_names() {
    local local_file line key value
    local_file="$(settings_directory "$INSTALL_DIR/.env")/local.env"
    while IFS= read -r line; do
        key=${line%%=*}
        value=$(env_get "$local_file" "$key" 2>/dev/null || true)
        [[ -n "$value" && "$value" != "$FOLDER_REGISTRY_ADDRESS"/* ]] || value=$(env_get "$INSTALL_DIR/release.env" "$key")
        printf '%s=%s\n' "$key" "$value"
    done < <(grep -E '^[A-Z_]+_IMAGE=' "$INSTALL_DIR/release.env")
    { grep -E '^[A-Z_]+_IMAGE=' "$local_file" 2>/dev/null || true; } | while IFS= read -r line; do
        key=${line%%=*}
        grep -qE "^${key}=" "$INSTALL_DIR/release.env" && continue
        value=$(env_get "$local_file" "$key")
        [[ "$value" == "$FOLDER_REGISTRY_ADDRESS"/* ]] || printf '%s=%s\n' "$key" "$value"
    done
}

sha256_of() { printf 'sha256:%s' "$(openssl dgst -sha256 -r "$1" | cut -d' ' -f1)"; }

# The manifest the folder holds for the box is the one release.env names, or one
# that manifest lists: either way its digest is proven from the signed package.
box_digest_in_the_folder() {
    local reference=$1 dir box
    dir="$IMAGES_FROM/$(folder_path_of "$reference")"
    [[ -f "$dir/named.json" && -f "$dir/box/manifest.json" ]] || return 1
    [[ "$(sha256_of "$dir/named.json")" == "${reference#*@}" ]] || return 1
    box=$(sha256_of "$dir/box/manifest.json")
    [[ "$box" == "${reference#*@}" ]] || tr -d ' \n' < "$dir/named.json" | grep -qF "\"digest\":\"${box}\"" || return 1
    printf '%s' "$box"
}

architecture_docker_runs() {
    case "$(docker info --format '{{.Architecture}}' 2>/dev/null)" in
        aarch64|arm64) echo arm64 ;;
        x86_64|amd64)  echo amd64 ;;
        *)             docker info --format '{{.Architecture}}' 2>/dev/null ;;
    esac
}

die_on_a_folder_for_another_architecture() {
    local prepared here
    prepared=$(cat "$IMAGES_FROM/architecture" 2>/dev/null || true)
    here=$(architecture_docker_runs)
    [[ -n "$prepared" && "$prepared" == "$here" ]] && return 0
    die "${IMAGES_FROM} was prepared for ${prepared:-no architecture}, and this machine runs ${here:-an unknown one}: prepare it again with ut-get --prepare --architecture ${here}"
}

# Weights are taken only as the signed package lists them, models/weights/<list>.txt,
# one line per file: "<sha256> <size> <repository>@<revision>/<path>". A file the
# folder holds and no list names is never placed.
weights_problems_in_the_folder() {
    local dir name list sha size location repository revision path file
    [[ -d "$IMAGES_FROM/weights" ]] || return 0
    for dir in "$IMAGES_FROM"/weights/*/; do
        [[ -d "$dir" ]] || continue
        name=$(basename "$dir")
        list="$INSTALL_DIR/models/weights/${name}.txt"
        [[ -f "$list" ]] || { printf '  weights/%s, which this release does not list\n' "$name"; continue; }
        while read -r sha size location; do
            [[ -n "$sha" && "$sha" != \#* ]] || continue
            repository=${location%%@*}; revision=${location#*@}; revision=${revision%%/*}; path=${location#*@*/}
            file="$IMAGES_FROM/weights/$name/$(printf '%s' "$repository" | tr '/' '_')/$revision/$path"
            if [[ ! -f "$file" ]] || [[ "$(wc -c < "$file" | tr -d ' ')" != "$size" ]] \
                    || [[ "$(sha256_of "$file")" != "sha256:$sha" ]]; then
                printf '  %s/%s, missing or not the file the release lists\n' "$repository" "$path"
            fi
        done < "$list"
    done
}

# A folder serves the release it was prepared for, which ut-get --prepare names by
# its package. Anything else would name every image missing and say nothing of why.
# The package stamps release.env "<version>+<commit>"; its file name has the version.
die_on_a_folder_of_another_release() {
    local packages prepared here
    here=$(env_get "$INSTALL_DIR/release.env" UT_RELEASE_VERSION 2>/dev/null || true)
    here=${here%%+*}
    [[ -n "$here" ]] || return 0
    packages=$(cd "$IMAGES_FROM" && ls understandtech_*_all.deb 2>/dev/null || true)
    prepared=$(printf '%s\n' "$packages" | sed -n 's/^understandtech_\(.*\)_all\.deb$/\1/p' | head -1)
    [[ "$prepared" == "$here" ]] && return 0
    die "${IMAGES_FROM} was prepared for release ${prepared:-none}, and this is ${here}: prepare it again with ut-get --prepare --version ${here}"
}

die_on_a_folder_that_misses_an_image() {
    [[ -n "$IMAGES_FROM" ]] || return 0
    [[ -d "$IMAGES_FROM" ]] || die "No such folder: ${IMAGES_FROM}"
    die_on_a_folder_for_another_architecture
    die_on_a_folder_of_another_release
    die_on_a_folder_for_another_role
    local line missing="" tool
    for tool in distribution.tar stable.tar; do
        [[ -f "$IMAGES_FROM/tools/$tool" ]] || missing+="  tools/${tool}"$'\n'
    done
    local version extra="" released
    while IFS= read -r line; do
        box_digest_in_the_folder "${line#*=}" >/dev/null && continue
        missing+="  ${line#*=}, missing or not the one the release names"$'\n'
        released=$(env_get "$INSTALL_DIR/release.env" "${line%%=*}" 2>/dev/null || true)
        [[ "${line#*=}" == "$released" ]] || extra+=" --image ${line#*=}"
    done < <(images_the_stack_runs)
    missing+=$(weights_problems_in_the_folder)
    [[ -z "$missing" ]] && return 0
    version=$(env_get "$INSTALL_DIR/release.env" UT_RELEASE_VERSION 2>/dev/null || echo '<version>')
    log_error "${IMAGES_FROM} lacks what this install runs:"
    printf '%s' "$missing" >&2
    log_error "  Prepare it again, for this release, with: ut-get --prepare <folder> --version ${version%%+*} --role $(role_this_install_takes)${extra}"
    [[ -z "$extra" ]] || log_error "  (--image carries what this machine's settings file runs instead of the release's)"
    exit 1
}

config_digest_of_the_archive() {
    local config
    config=$(tar -xOf "$1" manifest.json 2>/dev/null | sed -n 's/.*"Config" *: *"\([^"]*\)".*/\1/p')
    [[ -n "$config" ]] || return 1
    sha256_of <(tar -xOf "$1" "$config")
}

load_the_folder_tools() {
    local tool archive config
    for tool in "$FOLDER_REGISTRY_TOOL" "$FOLDER_SKOPEO_TOOL"; do
        archive="$IMAGES_FROM/tools/$(basename "${tool%%:*}").tar"
        config=$(config_digest_of_the_archive "$archive" || true)
        [[ -n "$config" && " $FOLDER_TOOL_CONFIGS " == *" $config "* ]] \
            || die "${archive} is not the ${tool%@*} this release loads images with — prepare the folder again"
        docker load -q -i "$archive" >/dev/null || die "Could not load ${archive}"
    done
}

folder_registry_answers() {
    local waited=0
    while (( waited < 30 )); do
        docker exec "$FOLDER_LOADER" wget -q -O /dev/null "http://127.0.0.1:5000/v2/" 2>/dev/null && return 0
        sleep 1; waited=$((waited + 1))
    done
    return 1
}

forget_the_images_of_a_folder() {
    local local_file=$1 tmp
    grep -qE "^[A-Z_]+_IMAGE=\"?${FOLDER_REGISTRY_ADDRESS}/" "$local_file" 2>/dev/null || return 0
    tmp=$(mktemp)
    grep -vE "^[A-Z_]+_IMAGE=\"?${FOLDER_REGISTRY_ADDRESS}/" "$local_file" > "$tmp" || true
    cat "$tmp" > "$local_file"
    rm -f "$tmp"
    log_info "Images come from the registry again, no longer from a folder"
}

# docker load forgets an image's digest on overlay2, the store of every box
# measured, so the images go through a registry that lives for this step only,
# and are pulled from it by the digest release.env names.
step_images_from_a_folder() {
    local local_file line key reference local_name
    local_file="$(settings_directory "$INSTALL_DIR/.env")/local.env"
    if [[ -z "$IMAGES_FROM" ]]; then
        if $DO_PULL; then forget_the_images_of_a_folder "$local_file"; fi
        return 0
    fi

    log_step "Loading the images from ${IMAGES_FROM}"
    load_the_folder_tools
    docker rm -f "$FOLDER_LOADER" >/dev/null 2>&1 || true
    docker run -d --name "$FOLDER_LOADER" -p "${FOLDER_REGISTRY_ADDRESS}:5000" "${FOLDER_REGISTRY_TOOL%@*}" >/dev/null \
        || die "Could not start the registry the images load through on ${FOLDER_REGISTRY_ADDRESS}"
    folder_registry_answers || { docker rm -f "$FOLDER_LOADER" >/dev/null 2>&1; die "The registry on ${FOLDER_REGISTRY_ADDRESS} never answered"; }

    while IFS= read -r line; do
        key=${line%%=*}; reference=${line#*=}
        local_name=$(name_in_the_folder_registry "$(repository_of "$reference")@$(box_digest_in_the_folder "$reference")")
        docker run --rm --network host -v "$IMAGES_FROM":/folder:ro "${FOLDER_SKOPEO_TOOL%@*}" \
            copy -q --preserve-digests --dest-tls-verify=false \
            "dir:/folder/$(folder_path_of "$reference")/box" "docker://${local_name%@*}:from-a-folder" >/dev/null \
            && docker pull -q "$local_name" >/dev/null \
            || { docker rm -f "$FOLDER_LOADER" >/dev/null 2>&1; die "Could not load ${reference%@*} under its digest from ${IMAGES_FROM}"; }
        env_set "$local_file" "$key" "$local_name"
        log_info "${reference%@*}, under the digest the release names"
    done < <(images_the_stack_runs)

    docker rm -f "$FOLDER_LOADER" >/dev/null 2>&1 || true
    render_settings "$INSTALL_DIR/.env" "$local_file"
    log_info "Every image is here, and nothing was downloaded"
}

volume_named() {
    local prefix
    prefix=$(env_get "$INSTALL_DIR/.env" RESOURCE_PREFIX 2>/dev/null || true)
    printf '%s-%s' "${prefix:-ut}" "$1"
}

# Created here, before compose, with the labels compose would give it, so that
# compose takes it as its own rather than warning about a stranger.
volume_ready() {
    local key=$1 volume project
    volume=$(volume_named "$key")
    project=$(env_get "$INSTALL_DIR/.env" COMPOSE_PROJECT_NAME 2>/dev/null || true)
    docker volume inspect "$volume" >/dev/null 2>&1 \
        || docker volume create --label "com.docker.compose.project=${project:-understandtech}" \
            --label "com.docker.compose.volume=${key}" "$volume" >/dev/null \
        || die "Could not create the volume ${volume}"
    printf '%s' "$volume"
}

# One "<from> <to>" line per file becomes a shell script run in the folder's
# registry tool, which every folder carries and which runs a shell: the volumes
# are written by root inside it, and a copy already the right size is skipped.
# A <from> of "=<text>" writes that text instead.
copy_into_a_volume() {
    local volume=$1 owner=$2 script="set -e" from to
    while read -r from to; do
        [[ -n "$from" ]] || continue
        script+="; mkdir -p '$(dirname "$to")'"
        if [[ "$from" == =* ]]; then
            script+="; printf '%s' '${from#=}' > '$to'"
        else
            script+="; [ -f '$to' ] && [ \"\$(stat -c %s '$to')\" = \"\$(stat -c %s '$from')\" ] || cp '$from' '$to'"
        fi
    done
    [[ -n "$owner" ]] && script+="; chown -R ${owner} /dest"
    docker run --rm --entrypoint sh -v "$volume":/dest -v "${WEIGHTS_ROOT:-$IMAGES_FROM}/weights":/weights:ro \
        "${WEIGHTS_TOOL:-${FOLDER_REGISTRY_TOOL%@*}}" -c "$script" || die "Could not place the weights in ${volume}"
}

# The Hugging Face cache layout: the files under snapshots/<revision>, and
# refs/main naming that revision, which is what an offline load resolves.
engine_weight_copies() {
    local name=$1 sha size location repository revision path hub
    while read -r sha size location; do
        [[ -n "$sha" && "$sha" != \#* ]] || continue
        repository=${location%%@*}; revision=${location#*@}; revision=${revision%%/*}; path=${location#*@*/}
        hub="/dest/huggingface/hub/models--$(printf '%s' "$repository" | sed 's|/|--|g')"
        printf '/weights/%s/%s/%s/%s %s/snapshots/%s/%s\n' "$name" "$(printf '%s' "$repository" | tr '/' '_')" "$revision" "$path" "$hub" "$revision" "$path"
        printf '=%s %s/refs/main\n' "$revision" "$hub"
    done < "$INSTALL_DIR/models/weights/${name}.txt" | sort -u
}

# Where ut-llm's own download script looks, and skips a model found there.
platform_weight_copies() {
    local sha size location repository revision path from embed reranker reranker_dir
    embed=$(env_get "$INSTALL_DIR/.env" EMBED_MODEL_NAME 2>/dev/null || true)
    reranker=$(env_get "$INSTALL_DIR/.env" RERANKER_HF_PATH 2>/dev/null || true)
    reranker_dir=$(env_get "$INSTALL_DIR/.env" RERANKER_MODEL_NAME 2>/dev/null || true)
    while read -r sha size location; do
        [[ -n "$sha" && "$sha" != \#* ]] || continue
        repository=${location%%@*}; revision=${location#*@}; revision=${revision%%/*}; path=${location#*@*/}
        from="/weights/platform/$(printf '%s' "$repository" | tr '/' '_')/$revision/$path"
        if [[ -n "$embed" && "$path" == "$embed" ]]; then
            printf '%s /dest/%s\n' "$from" "$embed"
        elif [[ -n "$reranker" && "$repository" == "$reranker" && "$path" != README.md ]]; then
            printf '%s /dest/%s/%s\n' "$from" "$reranker_dir" "$path"
        fi
    done < "$INSTALL_DIR/models/weights/platform.txt"
}

# The engine runs as uid 1000 (nim), and the cache NIM writes itself is 1000:1000.
step_weights_from_a_folder() {
    [[ -n "$IMAGES_FROM" && -d "$IMAGES_FROM/weights" ]] || return 0
    local dir lists=""
    log_step "Placing the model weights from ${IMAGES_FROM}"
    for dir in "$IMAGES_FROM"/weights/*/; do
        lists+="$(basename "$dir") "
    done
    place_the_weights $lists
}

place_the_weights() {
    local local_file name
    local_file="$(settings_directory "$INSTALL_DIR/.env")/local.env"
    for name in "$@"; do
        if [[ "$name" == platform ]]; then
            this_machine_is_a_compute_node && continue
            platform_weight_copies | copy_into_a_volume "$(volume_ready llm-models)" ""
            env_set "$local_file" DOWNLOAD_ONNX_EMBED "false"
            log_info "The platform's embedding and reranking models, in $(volume_named llm-models)"
        else
            engine_weight_copies "$name" | copy_into_a_volume "$(volume_ready nim-llm-cache)" "1000:1000"
            log_info "The weights of ${name}, in $(volume_named nim-llm-cache)"
        fi
    done
    env_set "$local_file" HF_HUB_OFFLINE "1"
    render_settings "$INSTALL_DIR/.env" "$local_file"
    log_info "No model is downloaded on its first start"
}

model_this_box_serves() {
    local id entry shipped
    id=$(env_get "$(settings_directory "$INSTALL_DIR/.env")/local.env" UT_MODEL 2>/dev/null || true)
    [[ -n "$id" ]] && { printf '%s' "$id"; return 0; }
    shipped=$(release_declares NIM_LLM_MODEL_PATH || true)
    [[ -n "$shipped" ]] || return 1
    for entry in "$INSTALL_DIR"/models/*.env; do
        [[ "$(env_get "$entry" NIM_LLM_MODEL_PATH 2>/dev/null || true)" == "$shipped" ]] || continue
        basename "$entry" .env
        return 0
    done
    return 1
}

lists_of_the_weights_this_box_loads() {
    local model
    this_machine_is_a_compute_node || this_machine_goes_without_its_accelerator || echo platform
    the_inference_is_served_by_another_machine && return 0
    model=$(model_this_box_serves) || return 0
    [[ -f "$INSTALL_DIR/models/weights/${model}.txt" ]] && echo "$model"
}

# What was placed, by checksum, next to the data: a later run downloads only what
# the release changed, as long as the volume it went into is still there.
weights_placed_record() {
    local data_root
    data_root=$(env_get "$INSTALL_DIR/.env" DATA_ROOT 2>/dev/null || true)
    printf '%s/weights-placed.txt' "${data_root:-$DATA_DIR}"
}

list_already_placed() {
    local list=$1 key=$2 sha
    docker volume inspect "$(volume_named "$key")" >/dev/null 2>&1 || return 1
    while read -r sha _; do
        [[ -n "$sha" && "$sha" != \#* ]] || continue
        grep -qx "$sha" "$(weights_placed_record)" 2>/dev/null || return 1
    done < "$INSTALL_DIR/models/weights/${list}.txt"
}

download_the_listed_weights_into() {
    local root=$1 list key sha size location repository revision path target
    shift
    for list in "$@"; do
        key=nim-llm-cache; [[ "$list" == platform ]] && key=llm-models
        list_already_placed "$list" "$key" && continue
        while read -r sha size location; do
            [[ -n "$sha" && "$sha" != \#* ]] || continue
            repository=${location%%@*}; revision=${location#*@}; revision=${revision%%/*}; path=${location#*@*/}
            target="$root/weights/$list/$(printf '%s' "$repository" | tr '/' '_')/$revision/$path"
            [[ -f "$target" && "$(sha256_of "$target")" == "sha256:$sha" ]] && continue
            mkdir -p "$(dirname "$target")"
            log_info "Downloading ${repository}/${path} ($(( size / 1000000 )) MB)"
            curl -fsSL --retry 3 --connect-timeout 20 --continue-at - --output "$target.part" \
                "https://huggingface.co/${repository}/resolve/${revision}/${path}" \
                || die "Could not download ${repository}/${path} from Hugging Face — run ut-install again to resume"
            if [[ "$(sha256_of "$target.part")" != "sha256:$sha" ]]; then
                rm -f "$target.part"
                die "${repository}/${path} is not the file this release lists — run ut-install again"
            fi
            mv "$target.part" "$target"
        done < "$INSTALL_DIR/models/weights/${list}.txt"
    done
}

# Online, the engine and ut-llm would otherwise fetch their weights on their
# first start, by repository name: whatever Hugging Face serves that day, never
# checked. They are fetched here instead, as a prepared folder carries them.
step_weights_from_the_network() {
    [[ -z "$IMAGES_FROM" ]] && $DO_PULL || return 0
    local lists root list
    lists=$(lists_of_the_weights_this_box_loads | tr '\n' ' ')
    [[ -n "${lists// /}" ]] || return 0
    root="$(dirname "$(weights_placed_record)")/weights-download"
    log_step "Downloading the model weights this release pins"
    download_the_listed_weights_into "$root" $lists
    if [[ -d "$root/weights" ]]; then
        WEIGHTS_ROOT=$root WEIGHTS_TOOL=$(image_in_registry "$FOLDER_REGISTRY_TOOL") place_the_weights $(ls "$root/weights")
        for list in $lists; do
            awk '!/^#/ && NF { print $1 }' "$INSTALL_DIR/models/weights/${list}.txt"
        done | sort -u > "$(weights_placed_record)"
    fi
    [[ "$root" == */weights-download ]] && rm -rf -- "$root"
    log_info "The weights are the ones this release lists, checked by checksum"
}

step_pull() {
    if ! $DO_PULL; then
        log_step "Skipping image download (--skip-pull)"
        return 0
    fi
    log_step "Downloading images"
    log "     First run downloads several tens of GB. This is the long part."
    if compose_reports_progress_as_json; then
        compose_in_dir --progress json pull 2>&1 | say_each_image_as_it_lands "$(images_the_release_runs)" \
            || die "Image pull failed. Check the token and the network."
    else
        compose_in_dir pull || die "Image pull failed. Check the token and the network."
    fi
    log_info "Images present locally"
}

# As the boot service does: a service the release stopped declaring is removed,
# rather than left holding the GPU memory its replacement now asks for.
step_start() {
    log_step "Starting services"
    compose_in_dir up -d --remove-orphans
    log_info "Containers created"
}

container_health_lines() {
    local container_id
    compose_in_dir ps -q 2>/dev/null | while read -r container_id; do
        [[ -n "$container_id" ]] || continue
        docker inspect --format \
            '{{.Name}}|{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}|{{index .Config.Labels "ut.role"}}' \
            "$container_id" 2>/dev/null || true
    done
}

# An unlabelled container is waited for. A compose file written before roles
# existed then behaves exactly as it did, which is what an installed machine
# replaying ut-install expects.
role_is_waited_for() {
    [[ "$1" != "inference" && "$1" != "backup" ]]
}

step_wait_healthy() {
    log_step "Waiting for the platform to become ready"
    log "     Inference engines load their models in the background and are not"
    log "     waited for; the platform is usable before they answer."
    log "     Waiting up to $((HEALTH_TIMEOUT / 60)) minutes for everything else."

    local deadline=$(( SECONDS + HEALTH_TIMEOUT ))
    local pending loading failed backup name status health role line

    while (( SECONDS < deadline )); do
        pending=""
        loading=""
        failed=""
        backup=""
        while IFS='|' read -r name status health role; do
            [[ -n "$name" ]] || continue
            name=${name#/}
            case "$health" in
                healthy) continue ;;
                none)    [[ "$status" == "running" ]] && continue ;;
            esac
            if role_is_waited_for "$role"; then
                pending+="  ${name}: ${status}/${health}"$'\n'
            elif [[ "$role" == "backup" ]]; then
                backup+="  ${name}: ${status}/${health}"$'\n'
            elif [[ "$health" == "starting" ]]; then
                loading+="  ${name}: ${status}/${health}"$'\n'
            else
                failed+="  ${name}: ${status}/${health}"$'\n'
            fi
        done < <(container_health_lines)

        if [[ -z "$pending" ]]; then
            printf '\r\033[K'
            log_info "The platform is ready"
            report_inference_still_loading "$loading"
            report_backup_not_working "$backup"
            report_inference_that_failed "$failed" && return 0
            return 1
        fi

        printf '\r%s     %d service(s) still starting: %s (%dm elapsed)%s\033[K' \
            "$YELLOW" "$(printf '%s' "$pending" | grep -c .)" "$(names_in "$pending")" \
            "$(( SECONDS / 60 ))" "$NC"
        sleep 15
    done

    printf '\r\033[K'
    log_warn "Timed out after $((HEALTH_TIMEOUT / 60)) minutes. Still not ready:"
    printf '%s' "$pending" | while IFS= read -r line; do [[ -n "$line" ]] && log_warn "$line"; done
    log_warn "Inspect one with: cd ${INSTALL_DIR} && docker compose logs <service>"
    return 0
}

# A count tells the operator to keep waiting; a name tells them what to look at.
names_in() {
    local block=$1 line names=""
    printf '%s' "$block" | while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        line=${line#  }
        printf '%s ' "${line%%:*}"
    done | sed 's/ $//; s/ /, /g'
}

report_inference_still_loading() {
    local loading=$1 line
    [[ -n "$loading" ]] || return 0
    INFERENCE_STILL_LOADING=$(names_in "$loading")
    log ""
    log "     Inference is not ready yet, and the platform does not wait for it:"
    printf '%s' "$loading" | while IFS= read -r line; do [[ -n "$line" ]] && log "  ${line# }"; done
    log "     Follow it with: cd ${INSTALL_DIR} && sudo docker compose ps"
}

# A destination that is not mounted, does not answer or does not open with this
# machine's password held the install for an hour before; the users do not need
# the backup to start working, the operator needs to know it does not.
report_backup_not_working() {
    local backup=$1 line name reason
    [[ -n "$backup" ]] || return 0
    log_warn ""
    log_warn "The backup is not working yet, and the platform does not wait for it:"
    printf '%s' "$backup" | while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        log_warn "  ${line# }"
        name=${line#  }
        name=${name%%:*}
        reason=$(docker logs --tail 20 "$name" 2>&1 | grep -F '[files-backup]' | tail -1)
        [[ -z "$reason" ]] || log_warn "    ${reason#*\[files-backup\] }"
    done
    log_warn "  cd ${INSTALL_DIR} && docker compose logs files-backup mongodb-backup"
}

# Saying "still loading" about a container that has already failed would be the
# fourth way this installer has claimed success it did not have. A model that is
# loading reports starting; one that gave up reports unhealthy, and the two must
# not leave by the same door.
report_inference_that_failed() {
    local failed=$1 line
    [[ -n "$failed" ]] || return 0
    log_error ""
    log_error "Inference did not start. The platform is up, the models are not:"
    printf '%s' "$failed" | while IFS= read -r line; do [[ -n "$line" ]] && log_error "  ${line# }"; done
    log_error "  cd ${INSTALL_DIR} && docker compose logs nim-llm"
    return 1
}

step_autostart() {
    if ! $DO_AUTOSTART; then
        log_step "Skipping boot service (--no-autostart)"
        return 0
    fi

    log_step "Installing the boot service and mDNS names"

    if [[ ! -x "$INSTALL_DIR/setup-autostart.sh" ]]; then
        log_warn "setup-autostart.sh not found — the stack will NOT restart after a reboot,"
        log_warn "and the satellite hostnames will not be published."
        return 0
    fi

    "$INSTALL_DIR/setup-autostart.sh" --install --dir "$INSTALL_DIR" \
        || log_warn "setup-autostart.sh reported a problem; re-run it manually"
    log_info "Boot service and mDNS publisher installed"
}

print_secrets_out_of_band() {
    local env_file=$1 admin_password backup_password
    if ! terminal_is_reachable; then
        log_info "No terminal here, so nothing was printed. The secrets are in $(settings_directory "$env_file")/local.env"
        [[ -z "$EVENTS_FILE" ]] || say_event secrets ",\"file\":$(json_string "$(settings_directory "$env_file")/local.env")"
        return 0
    fi

    admin_password=$(env_get "$env_file" ADMIN_SETUP_PASSWORD 2>/dev/null || true)
    backup_password=$(env_get "$env_file" BACKUP_FILES_PASSWORD 2>/dev/null || true)

    if [[ -n "$admin_password" ]]; then
        printf '  %sInitial admin password%s  %s\n' "$BOLD" "$NC" "$admin_password" > /dev/tty
    fi

    if [[ -n "$backup_password" ]]; then
        printf '\n  %sBackup repository password%s  %s\n' "$BOLD" "$NC" "$backup_password" > /dev/tty
        printf '  %sWrite this down somewhere other than this machine.%s Losing it makes\n' "$YELLOW" "$NC" > /dev/tty
        printf '  every snapshot unreadable, including copies held off-site — there is\n' > /dev/tty
        printf '  no recovery path.\n' > /dev/tty
    fi

    printf '\n  (shown here only — stored in %s, never in the install log)\n\n' "$env_file" > /dev/tty
}

install_history() {
    local data_root
    data_root=$(env_get "$INSTALL_DIR/.env" DATA_ROOT 2>/dev/null || true)
    printf '%s/install-history.jsonl' "${data_root:-$DATA_DIR}"
}

# Failed runs are kept too: an install re-run until it works must not read as
# one that served the first time.
record_this_install() {
    local status=$? outcome="done" step="" release history
    if (( status != 0 )); then
        outcome="failed"
        step=${CURRENT_STEP//\"/}
    fi
    release=$(env_get "$INSTALL_DIR/release.env" UT_RELEASE_VERSION 2>/dev/null || true)
    history=$(install_history)
    mkdir -p "$(dirname "$history")" 2>/dev/null || return 0
    printf '{"at":"%s","tool":"ut-install","outcome":"%s","step":"%s","release":"%s"}\n' \
        "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$outcome" "$step" "${release:-unstamped}" \
        >> "$history" 2>/dev/null || true
}

reporting_already_decided() {
    local said
    said=$("$UT_SEND" status 2>/dev/null) || return 1
    [[ "$said" != "Reporting: not decided" ]]
}

# No answer is offered as the default: pressing Enter asks again.
ask_about_reporting() {
    local answer=""
    log_step "Usage reports"
    log "  This machine can send UnderstandTech, every 15 minutes, how loaded it was and"
    log "  how many people it served — counts, never content, never who. docs/usage-report.md"
    log "  lists every field. The answer can be changed later with ut-send configure."
    log ""
    while [[ "$answer" != "yes" && "$answer" != "no" ]]; do
        printf '  Send usage reports to UnderstandTech? (yes/no): '
        read -r answer || return 1
    done
    REPORTING=$answer
    [[ "$REPORTING" == "yes" ]] || return 0
    log "  Where they go can wait: leave a field empty to give it later."
    [[ -n "$REPORTING_RECEIVER" ]] || { printf '  Receiver address (https://…): '; read -r REPORTING_RECEIVER || true; }
    [[ -n "$REPORTING_TOKEN_FILE" ]] || { printf '  File holding this machine'"'"'s token: '; read -r REPORTING_TOKEN_FILE || true; }
    [[ -n "$REPORTING_RECEIVER_CERT" ]] || { printf '  File holding the receiver'"'"'s certificate: '; read -r REPORTING_RECEIVER_CERT || true; }
}

reporting_configure_arguments() {
    printf '%s\n' configure --consent "$REPORTING"
    [[ -n "$REPORTING_RECEIVER" ]] && printf '%s\n' --receiver "$REPORTING_RECEIVER"
    [[ -n "$REPORTING_TOKEN_FILE" ]] && printf '%s\n' --token-file "$REPORTING_TOKEN_FILE"
    [[ -n "$REPORTING_RECEIVER_CERT" ]] && printf '%s\n' --receiver-cert "$REPORTING_RECEIVER_CERT"
    [[ -n "$REPORTING_EVERY" ]] && printf '%s\n' --every "$REPORTING_EVERY"
    return 0
}

# Reporting never holds an install back: the platform serves whether or not this
# step works, and the operator is told how to finish it.
step_reporting() {
    local arguments=() line
    if ! command -v "$UT_SEND" >/dev/null 2>&1; then
        log_warn "ut-send is not installed here — usage reports stay off. A package install carries it."
        return 0
    fi
    if [[ -z "$REPORTING" && -n "${REPORTING_RECEIVER}${REPORTING_TOKEN_FILE}${REPORTING_RECEIVER_CERT}${REPORTING_EVERY}" ]]; then
        log_warn "Receiver details were given without --reporting yes — they are not taken as a yes, nothing changes"
        return 0
    fi
    if [[ -z "$REPORTING" ]]; then
        if reporting_already_decided; then
            log_info "$("$UT_SEND" status) — kept from an earlier answer"
            return 0
        fi
        if terminal_is_reachable; then
            ask_about_reporting < /dev/tty > /dev/tty || REPORTING="no"
        else
            REPORTING="no"
            log_info "No --reporting given and no terminal to ask on — usage reports stay off"
        fi
    fi
    [[ "$REPORTING" == "yes" || "$REPORTING" == "no" ]] || die "--reporting must be yes or no, not '${REPORTING}'"
    while IFS= read -r line; do arguments+=("$line"); done < <(reporting_configure_arguments)
    if "$UT_SEND" "${arguments[@]}"; then
        return 0
    fi
    log_warn "Usage reports could not be set up. The platform is unaffected; finish with: sudo ut-send configure --consent yes|no …"
}

print_compute_node_summary() {
    local surface settings
    surface=$(inference_surface_url)
    settings="$(settings_directory "$INSTALL_DIR/.env")/local.env"
    cat <<EOF

${BOLD}Installation complete in $(( SECONDS / 60 )) min${NC}

  This machine serves inference only: no platform, no admin password.

  Directory      ${INSTALL_DIR}
  Configuration  ${settings}   (holds the engine key)
  Role           $(role_this_machine_was_installed_as)
  Engine         ${INFERENCE_STILL_LOADING:+still loading: }${INFERENCE_STILL_LOADING:-ready}

  On the control plane, give its install this node's key and root:

    sudo grep '^VLLM_API_KEY=' ${settings} | cut -d= -f2- | tr -d '"' > node.key
    docker exec ut-caddy cat /data/caddy/pki/authorities/local/root.crt > node-root.crt
    sudo ut-install --inference-from ${surface} \\
        --inference-key-file node.key --inference-ca-file node-root.crt

  Status         cd ${INSTALL_DIR} && docker compose ps
  Logs           cd ${INSTALL_DIR} && docker compose logs -f nim-llm
  Install log    ${LOG_FILE}

EOF
}

print_summary() {
    local env_file="$INSTALL_DIR/.env" inference=""
    if this_machine_is_a_compute_node; then
        print_compute_node_summary
        return 0
    fi
    [[ -z "$INFERENCE_STILL_LOADING" ]] \
        || inference=$'\n'"  Inference      still loading: ${INFERENCE_STILL_LOADING} — the platform works meanwhile"

    cat <<EOF

${BOLD}Installation complete in $(( SECONDS / 60 )) min${NC}

  Open https://${DOMAIN} — the initial admin password printed below opens
  the first-run wizard: models, sign-on, data sources.

  Address        https://${DOMAIN}${inference}
  Directory      ${INSTALL_DIR}
  Configuration  ${env_file}   (0600, contains generated secrets)
  Role           $(role_this_machine_was_installed_as)

  Satellite apps  https://llms.${DOMAIN}
                  https://assistants.${DOMAIN}
                  https://admin.${DOMAIN}

  Your browser will warn about the certificate: it is issued by the
  appliance's own authority. To remove the warning on a machine, export
  and trust the root certificate:

    docker exec ut-caddy cat /data/caddy/pki/authorities/local/root.crt > ut-root-ca.crt

  Status         cd ${INSTALL_DIR} && docker compose ps
  Logs           cd ${INSTALL_DIR} && docker compose logs -f api
  Install log    ${LOG_FILE}

EOF

    print_secrets_out_of_band "$env_file"
}

start_logging() {
    mkdir -p "$(dirname "$LOG_FILE")"
    touch "$LOG_FILE"
    chmod 600 "$LOG_FILE"
    exec > >(tee -a "$LOG_FILE") 2>&1
    printf '\n===== ut-install %s =====\n' "$(date -Is)"
}

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check)          ACTION="check" ;;
            --list-models)    ACTION="list-models" ;;
            --events)         EVENTS_FILE="${2:?--events needs a file}"; shift ;;
            --no-gpu)         NO_GPU=true ;;
            --arbiter)        ARBITER_ADDRESS="${2:?--arbiter needs the address the two boxes reach this machine at}"; shift ;;
            --update)         DO_UPDATE=true ;;
            --no-autostart)   DO_AUTOSTART=false ;;
            --skip-pull)      DO_PULL=false ;;
            --license-file)   LICENSE_FILE="${2:?--license-file needs a path}"; shift ;;
            --machine-file)   MACHINE_FILE_GIVEN="${2:?--machine-file needs the license file UnderstandTech sent}"; shift ;;
            --token-file)     TOKEN_FILE="${2:?--token-file needs a path}"; shift ;;
            --dir)            INSTALL_DIR="${2:?--dir needs a path}"; shift ;;
            --from-checkout)  FROM_CHECKOUT="${2:?--from-checkout needs a path}"; shift ;;
            --domain)         DOMAIN="${2:?--domain needs a name}"; shift ;;
            --certificate-dir) CERTIFICATE_DIR="${2:?--certificate-dir needs the directory holding fullchain.pem and privkey.pem}"; shift ;;
            --behind-proxy)   BEHIND_PROXY="${2:?--behind-proxy needs the range your load balancer connects from}"; shift ;;
            --health-timeout) HEALTH_TIMEOUT="${2:?--health-timeout needs seconds}"; shift ;;
            --reporting)      REPORTING="${2:?--reporting needs yes or no}"; shift ;;
            --reporting-receiver)      REPORTING_RECEIVER="${2:?--reporting-receiver needs an address}"; shift ;;
            --reporting-token-file)    REPORTING_TOKEN_FILE="${2:?--reporting-token-file needs a path}"; shift ;;
            --reporting-receiver-cert) REPORTING_RECEIVER_CERT="${2:?--reporting-receiver-cert needs a path}"; shift ;;
            --reporting-every)         REPORTING_EVERY="${2:?--reporting-every needs minutes}"; shift ;;
            --inference-from)     INFERENCE_FROM="${2:?--inference-from needs an address}"; shift ;;
            --images-from)        IMAGES_FROM="${2:?--images-from needs the folder ut-get --prepare wrote}"; DO_PULL=false; shift ;;
            --compute)            COMPUTE_ADDRESS="${2:?--compute needs the address the control plane reaches this machine at}"; shift ;;
            --inference-key-file) INFERENCE_KEY_FILE="${2:?--inference-key-file needs a path}"; shift ;;
            --inference-ca-file)  INFERENCE_CA_FILE="${2:?--inference-ca-file needs a path}"; shift ;;
            --model)              MODEL_ID="${2:?--model needs one of the models in models/}"; shift ;;
            --engine)             ENGINE_CHOICE="${2:?--engine needs nim or vllm}"; shift ;;
            -h|--help)        usage; exit 0 ;;
            *)                log_error "Unknown option: $1"; usage; exit 2 ;;
        esac
        shift
    done
}

main() {
    parse_arguments "$@"
    [[ -z "$EVENTS_FILE" ]] || : >> "$EVENTS_FILE" || die "Cannot write the events to ${EVENTS_FILE}."
    die_on_a_compute_node_given_wrong
    die_on_a_compute_role_given_wrong
    die_on_an_arbiter_role_given_wrong
    resolve_install_dir
    die_on_a_folder_that_misses_an_image
    die_on_a_model_nobody_listed

    if [[ "$ACTION" == "list-models" ]]; then
        list_the_models_this_machine_serves
        exit 0
    fi

    if [[ "$ACTION" == "check" ]]; then
        DOMAIN=$(domain_to_check)
        say_what_is_installed
        preflight
        exit 0
    fi

    [[ $EUID -eq 0 ]] || die "Run with sudo: sudo $0"

    start_logging
    trap record_this_install EXIT
    preflight
    read_domain
    die_on_a_way_for_tls_to_end_given_wrong
    warn_on_generated_apps_the_certificate_leaves_out
    read_credentials
    step_registry_login
    step_fetch_repo
    step_configure
    step_check_resolution
    step_docker_group
    step_networks
    step_images_from_a_folder
    step_weights_from_a_folder
    step_pull
    step_weights_from_the_network
    step_start
    step_wait_healthy
    step_autostart
    step_reporting
    print_summary
    [[ -z "$EVENTS_FILE" ]] || say_event done ",\"address\":$(json_string "https://${DOMAIN}"),\"minutes\":$(( SECONDS / 60 ))"
}

# An `if` rather than `&&`: a false condition would otherwise be the script's
# exit status, so sourcing it for tests would fail under `set -e` — which is the
# one thing this guard exists to allow.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
