#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHECKOUT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
PACKAGE_SHARE_DIR="/usr/share/understandtech"
INSTALL_DIR="${UT_INSTALL_DIR:-}"
TARGET=""

if [[ -t 1 ]]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; BOLD=""; NC=""
fi

log_info()  { printf '%s[ ok ]%s %s\n' "$GREEN" "$NC" "$*"; }
log_error() { printf '%s[fail]%s %s\n' "$RED" "$NC" "$*" >&2; }
log_step()  { printf '\n%s==>%s %s%s%s\n' "$BOLD" "$NC" "$BOLD" "$*" "$NC"; }
die()       { log_error "$*"; exit 1; }

usage() {
    cat <<'EOF'
Bring PostgreSQL back to an instant, from its pgBackRest repository on this machine.

  sudo ut-restore-postgres --to "2026-11-03 14:32:00+01"

Everything written after that instant is lost. PostgreSQL and its backup service
are stopped for the restore and started again after it.

Options
  --to TIME    The instant, as PostgreSQL reads a timestamp. Give the offset: a time
               without one is read in the database's time zone, UTC.
  --dir PATH   Install directory. Defaults to /usr/share/understandtech, then to
               the directory this script sits in.
  -h, --help   This message.
EOF
}

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --to)      TARGET="${2:?--to needs an instant}"; shift ;;
            --dir)     INSTALL_DIR="${2:?--dir needs a path}"; shift ;;
            -h|--help) usage; exit 0 ;;
            *)         log_error "Unknown option: $1"; usage; exit 2 ;;
        esac
        shift
    done
    [[ -n "$TARGET" ]] || { usage; exit 2; }
}

resolve_install_dir() {
    [[ -n "$INSTALL_DIR" ]] && return 0
    if [[ -f "$PACKAGE_SHARE_DIR/compose.yaml" ]]; then
        INSTALL_DIR="$PACKAGE_SHARE_DIR"
    else
        INSTALL_DIR="$CHECKOUT_DIR"
    fi
}

compose_here() { ( cd "$INSTALL_DIR" && docker compose "$@" ); }

main() {
    parse_arguments "$@"
    [[ $EUID -eq 0 ]] || die "Run with sudo: sudo $0 --to \"$TARGET\""
    resolve_install_dir
    [[ -f "$INSTALL_DIR/compose.yaml" ]] || die "No install in ${INSTALL_DIR}"

    log_step "The backups this repository holds"
    compose_here exec -T postgres pgbackrest info || die "pgBackRest cannot read its repository: is POSTGRES_BACKUP_PASSWORD the one it was created with?"

    log_step "Stopping PostgreSQL and its backups"
    compose_here stop postgres-backup postgres

    log_step "Restoring to ${TARGET}"
    compose_here run --rm --no-deps -T --entrypoint pgbackrest postgres \
        restore --delta --type=time --target="$TARGET" --target-action=promote \
        || die "The restore failed, above; PostgreSQL is stopped. Fix the cause and run it again, or start it unchanged with: cd ${INSTALL_DIR} && docker compose start postgres postgres-backup"

    log_step "Starting PostgreSQL and its backups"
    compose_here start postgres postgres-backup
    for _ in $(seq 60); do
        compose_here exec -T postgres pg_isready -q && break
        sleep 2
    done
    compose_here exec -T postgres pg_isready -q || die "PostgreSQL did not start again; read: cd ${INSTALL_DIR} && docker compose logs postgres"
    log_info "PostgreSQL is back at ${TARGET}. Its next backup starts a new timeline; take a full one now: cd ${INSTALL_DIR} && docker compose exec postgres-backup pgbackrest backup --type=full"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
