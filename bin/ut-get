#!/usr/bin/env bash

set -Eeuo pipefail

# The same key as ut-verify, carried rather than read from the release it is
# about to trust: a capability holds the two equal.
RELEASE_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEIeeiLHqWayycgLe6biw7lXXcdsMO
62Aggan6cqsWHSgzZiJavGHBySYn+I1uzEOn8paEHBZkBtNO4gUDVhv3Sw==
-----END PUBLIC KEY-----'

if [[ -t 1 ]]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; CYAN=""; BOLD=""; NC=""
fi

RELEASES_URL="${UT_RELEASES_URL:-https://github.com/understand-tech/ai-in-a-box/releases}"
DOWNLOAD_DIR="/var/cache/understandtech/releases"
RELEASE_DIR=""
PREPARE_DIR=""
MODEL_ID=""
FOLDER_ROLE="appliance"
EXTRA_IMAGES=()
TOKEN_FILE=""
LICENSE_FILE=""
REGISTRY_TOKEN=""
REGISTRY_USER="${UT_REGISTRY_USER:-dgx-access}"
KEYGEN_API="${UT_KEYGEN_API:-https://api.keygen.sh/v1/accounts/cdfe8998-3b6e-4f86-8f9f-c51a7cb642e0}"
VERSION=""

# The two tools a folder carries to load its images on the box. ut-install
# names the same digests: a capability holds the two equal.
FOLDER_REGISTRY_TOOL="ghcr.io/distribution/distribution:3.0.0@sha256:4ba3adf47f5c866e9a29288c758c5328ef03396cb8f5f6454463655fa8bc83e2"
FOLDER_SKOPEO_TOOL="quay.io/skopeo/stable:v1.20.0@sha256:47853bb9fb24202af9110531ebd6e43c5f97701254ca290596640290d17942f4"
BOX_ARCHITECTURE="arm64"
NEXT=ut-install
INSTALL_ARGUMENTS=()

usage() {
    cat <<'EOF'
ut-get — installs UnderstandTech AI in a Box from a release, then runs ut-install.

  sudo ./ut-get [--version <version>] [ut-install options]
  sudo ./ut-get --from <directory> [ut-install options]
  ./ut-get --prepare <directory> [--version <version>] --license-file <file>

  --version <version>  the release to install, 2026.09.1 for example.
                       Without it, the latest one.
  --from <directory>   the release, carried in by hand: the package and its
                       .sig beside it, the images when --prepare put them
                       there, and the license file UnderstandTech sent back
                       for a box that cannot reach Keygen. Nothing is
                       downloaded.
  --prepare <directory>
                       on a connected Linux or macOS machine with Docker, not
                       the box: download the release and every image it runs
                       into the directory, for a box with no network to install
                       with --from. Runs again where it stopped.
  --license-file <file>
                       the license key. With --prepare, the registry access it
                       carries is read from Keygen, never shown; ut-install
                       takes it too.
  --token-file <file>  with --prepare, a registry token instead of a license
                       key. Read from the file, never shown.
  --role appliance|control-plane|compute
                       with --prepare, what the box runs: all of it (the default),
                       the platform taking its inference from another machine, or
                       the inference only. The folder carries that role alone.
  --image <reference>  with --prepare, one more image to carry, pinned by digest
                       (name:tag@sha256:...): one the box's settings file runs
                       instead of the release's. Can be given several times.
  --model <id>         with --prepare, the model whose weights the folder carries,
                       beside those of the platform; the release's own without it.
                       Elsewhere, passed on to ut-install.
  --architecture arm64|amd64
                       with --prepare, the box's processor: arm64 for a GB10 or a
                       GB300 (the default), amd64 for an x86 control plane.
  --browser            continue in a browser on this machine (ut-setup)
                       rather than in this terminal (ut-install).

A download that stopped resumes when the same command is run again.

Every other option goes to ut-install unchanged, for example --domain.
Nothing is installed unless the package is signed by UnderstandTech.
EOF
}

log_info() { printf '%s[ ok ]%s %s\n' "$GREEN" "$NC" "$*"; }
log_step() { printf '\n%s==>%s %s%s%s\n' "$CYAN" "$NC" "$BOLD" "$*" "$NC"; }
fail()     { printf '%s[fail]%s %s\n' "$RED" "$NC" "$*" >&2; exit 1; }

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from)    RELEASE_DIR="${2:?--from needs a directory}"; shift ;;
            --prepare) PREPARE_DIR="${2:?--prepare needs a directory}"; shift ;;
            --token-file) TOKEN_FILE="${2:?--token-file needs a file}"; shift ;;
            --image)   EXTRA_IMAGES+=("${2:?--image needs an image pinned by digest}"); shift ;;
            --role)    FOLDER_ROLE="${2:?--role needs appliance, control-plane or compute}"; shift ;;
            --model)   MODEL_ID="${2:?--model needs a model}"; INSTALL_ARGUMENTS+=(--model "$2"); shift ;;
            --license-file) LICENSE_FILE="${2:?--license-file needs a file}"; INSTALL_ARGUMENTS+=("$1" "$2"); shift ;;
            --architecture) BOX_ARCHITECTURE="${2:?--architecture needs arm64 or amd64}"; shift ;;
            --version) VERSION="${2:?--version needs a version}"; shift ;;
            --browser) NEXT=ut-setup ;;
            -h|--help) usage; exit 0 ;;
            *)         INSTALL_ARGUMENTS+=("$1") ;;
        esac
        shift
    done
    [[ "$NEXT" == ut-install || ${#INSTALL_ARGUMENTS[@]} -eq 0 ]] \
        || fail "--browser asks everything in the page — give it no ut-install option (${INSTALL_ARGUMENTS[0]})"
}

is_a_release_version() { [[ "$1" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]+(-rc[0-9]+)?$ ]]; }

fetch() {
    curl --fail --silent --show-error --proto '=https' --connect-timeout 20 --max-time 900 --retry 3 "$@"
}

latest_version() {
    local tag_url
    tag_url=$(fetch --output /dev/null --write-out '%{redirect_url}' "$RELEASES_URL/latest") \
        || fail "Cannot reach ${RELEASES_URL} — check the network, or carry the release in and use --from"
    [[ "$tag_url" == */releases/tag/v* ]] \
        || fail "${RELEASES_URL} has published no release yet, only pre-releases — name one with --version"
    printf '%s' "${tag_url##*/tag/v}"
}

download_release() {
    local version=$1 dir=${2:-$DOWNLOAD_DIR/$1} name
    shift $(( $# < 2 ? $# : 2 ))
    mkdir -p "$dir"
    for name in "understandtech_${version}_all.deb" "understandtech_${version}_all.deb.sig" "$@"; do
        [[ -f "$dir/$name" ]] && continue
        fetch --location --continue-at - --output "$dir/$name.part" "$RELEASES_URL/download/v${version}/$name" \
            || fail "Could not download ${name} — run the same command again to resume"
        mv "$dir/$name.part" "$dir/$name"
    done
    printf '%s' "$dir"
}

the_only_package_in() {
    local dir=$1 packages
    packages=("$dir"/understandtech_*_all.deb)
    [[ -f "${packages[0]}" ]] || fail "No understandtech_<version>_all.deb in ${dir}"
    (( ${#packages[@]} == 1 )) || fail "${#packages[@]} packages in ${dir} — leave only the one to install"
    printf '%s' "${packages[0]}"
}

# A command substitution does not inherit set -e: without the explicit checks, a
# key file that could not be written verifies against nothing.
key_file() {
    local file
    file=$(mktemp) || return 1
    printf '%s\n' "$RELEASE_PUBLIC_KEY" > "$file" || return 1
    printf '%s' "$file"
}

verify_signature() {
    local package=$1 key
    [[ -f "${package}.sig" ]] || fail "No signature beside it: $(basename "$package").sig — do not install it"
    command -v openssl >/dev/null 2>&1 || fail "openssl is required: sudo apt-get install openssl"

    key=$(key_file) || fail "Cannot write the key to a temporary file"
    if openssl dgst -sha256 -verify "$key" -signature "${package}.sig" "$package" >/dev/null 2>&1; then
        rm -f "$key"
        log_info "$(basename "$package") is signed by UnderstandTech"
        return 0
    fi
    rm -f "$key"
    return 1
}

# One line per image the release runs, "<repository>@<digest>", read from its bill
# of materials. Nothing here is trusted: the box checks every image against the
# release.env of the signed package.
images_of_the_bill() {
    local bill=$1 role=${2:-} model=${3:-} for_model
    sed -n 's|.*"purl": "pkg:oci/[^@]*@\(sha256:[0-9a-f]\{64\}\)?repository_url=\([^&"]*\)\([^"]*\)".*|\2@\1 \3|p' "$bill" \
        | while read -r reference qualifiers; do
            for_model=$(sed -n 's/.*&model=\([^&#]*\).*/\1/p' <<< "$qualifiers")
            [[ -z "$for_model" || "+${for_model}+" == *"+${model}+"* ]] || continue
            runs_in_the_role "$qualifiers" "$role" && printf '%s\n' "$reference"
        done
}

# A bill written before roles names none, and its images are taken for every role.
runs_in_the_role() {
    local qualifiers=$1 role=$2 roles
    [[ -z "$role" ]] && return 0
    roles=$(sed -n 's/.*&roles=\([^&#]*\).*/\1/p' <<< "$qualifiers")
    [[ -z "$roles" || "+${roles}+" == *"+${role}+"* ]]
}

# The folder names an image by repository and digest, without its tag: the bill
# of materials has no tag, release.env has one. ut-install computes the same path.
repository_of() {
    local repository=${1%@*} last
    last=${repository##*/}
    [[ "$last" == *:* ]] && repository=${repository%:*}
    printf '%s' "$repository"
}

folder_path_of() {
    printf 'images/%s/%s' "$(repository_of "$1" | tr '/:' '__')" "${1#*@sha256:}"
}

# skopeo resolves no short name: caddy is docker.io/library/caddy.
fully_qualified() {
    local repository first=${1%%/*}
    if [[ "$1" == */* && ( "$first" == *.* || "$first" == *:* || "$first" == localhost ) ]]; then
        printf '%s' "$1"
    elif [[ "$1" == */* ]]; then
        printf 'docker.io/%s' "$1"
    else
        printf 'docker.io/library/%s' "$1"
    fi
}

# The license key alone reads its own license, metadata included, under the
# license authentication Keygen gives our policies.
read_the_registry_access_of_the_license() {
    local key answer user
    command -v jq >/dev/null 2>&1 || fail "--prepare with --license-file needs jq on this machine"
    key=$(tr -d ' \t\r\n' < "$LICENSE_FILE")
    [[ "$key" =~ ^[A-Za-z0-9._/+=-]+$ && "$key" != UT1.* ]] \
        || fail "${LICENSE_FILE} does not hold a license key UnderstandTech issued"
    answer=$(curl -sS --max-time 20 "${KEYGEN_API}/me" \
        -K <(printf 'header = "Authorization: License %s"\n' "$key") \
        -H 'Accept: application/vnd.api+json' -H 'Keygen-Version: 1.8') \
        || fail "Keygen could not be reached to read the registry access of the license"
    REGISTRY_TOKEN=$(jq -r '.data.attributes.metadata.registryToken // empty' <<< "$answer" 2>/dev/null) || REGISTRY_TOKEN=""
    [[ -n "$REGISTRY_TOKEN" ]] || fail "Keygen refused the license key, or the license carries no registry access: ask UnderstandTech"
    user=$(jq -r '.data.attributes.metadata.registryUser // empty' <<< "$answer" 2>/dev/null) || user=""
    REGISTRY_USER=${user:-$REGISTRY_USER}
}

# A box that cannot reach Keygen gets its license file from UnderstandTech; carried
# in the folder, it is the only .lic there.
license_file_in() {
    local folder=$1 found=() file
    for file in "$folder"/*.lic; do
        [[ -f "$file" ]] && found+=("$file")
    done
    (( ${#found[@]} <= 1 )) || fail "${folder} holds more than one license file: keep the one UnderstandTech sent for this box"
    (( ${#found[@]} == 0 )) || printf '%s' "${found[0]}"
}

write_registry_auth() {
    local dir=$1 token=$2
    mkdir -m 700 "$dir"
    printf '{"auths":{"ghcr.io":{"auth":"%s"}}}\n' "$(printf '%s:%s' "$REGISTRY_USER" "$token" | base64 | tr -d '\n')" > "$dir/auth.json"
    chmod 600 "$dir/auth.json"
}

# As the user preparing the folder: skopeo runs as root in its container, and the
# files it wrote could then not be removed without sudo.
skopeo_in() {
    local folder=$1 auth=$2; shift 2
    docker run --rm --user "$(id -u):$(id -g)" -v "$folder":/folder -v "$auth":/auth:ro "$FOLDER_SKOPEO_TOOL" "$@" --authfile /auth/auth.json
}

# Per image, the manifest the release names as it is, then the box's own image
# only: two requests to the registry instead of one per platform, which Docker
# Hub's anonymous limit did not survive on 2026-10-20. The box proves the second
# belongs to the first.
# quay.io answered 503 now and then on 2026-10-24, in CI and here: a copy is
# tried three times, from scratch each time, before the preparation stops.
with_retries() {
    local attempt
    for attempt in 1 2 3; do
        "$@" && return 0
        (( attempt == 3 )) || sleep $(( attempt * ${UT_GET_RETRY_SECONDS:-10} ))
    done
    return 1
}

copy_an_image() {
    local folder=$1 auth=$2 path=$3 source=$4
    rm -rf "${folder:?}/$path/box"
    skopeo_in "$folder" "$auth" inspect --raw "$source" > "$folder/$path/named.json" \
        && skopeo_in "$folder" "$auth" --override-os linux --override-arch "$BOX_ARCHITECTURE" \
            copy -q --preserve-digests "$source" "dir:/folder/$path/box"
}

copy_a_tool() {
    local folder=$1 auth=$2 tool=$3 name=$4
    rm -f "$folder/tools/$name.part"
    skopeo_in "$folder" "$auth" --override-os linux --override-arch "$BOX_ARCHITECTURE" \
        copy -q "docker://$(fully_qualified "$(repository_of "$tool")@${tool#*@}")" \
        "docker-archive:/folder/tools/$name.part:${tool%@*}"
}

copy_the_images_into() {
    local folder=$1 auth=$2 reference path source
    while read -r reference; do
        [[ -n "$reference" ]] || continue
        path=$(folder_path_of "$reference")
        if [[ -f "$folder/$path/named.json" && -f "$folder/$path/box/manifest.json" ]]; then
            log_info "${reference%@*} already in the folder"
            continue
        fi
        rm -rf "${folder:?}/$path"
        mkdir -p "$folder/$path"
        source="docker://$(fully_qualified "$reference")"
        with_retries copy_an_image "$folder" "$auth" "$path" "$source" \
            || fail "Could not copy ${reference%@*} — check the token and the network, then run the same command again"
        log_info "${reference%@*} copied"
    done
}

copy_the_tools_into() {
    local folder=$1 auth=$2 tool name
    mkdir -p "$folder/tools"
    for tool in "$FOLDER_REGISTRY_TOOL" "$FOLDER_SKOPEO_TOOL"; do
        name=$(basename "${tool%%:*}").tar
        [[ -f "$folder/tools/$name" ]] && continue
        with_retries copy_a_tool "$folder" "$auth" "$tool" "$name" \
            || fail "Could not copy the tool ${tool%@*}"
        mv "$folder/tools/$name.part" "$folder/tools/$name"
    done
    log_info "The registry and skopeo the box loads its images with are in the folder"
}

# One line per weight file the folder carries, "<list> <sha256> <size>
# <repository> <revision> <path>": the platform's, and the model's, or the
# release default's. The box takes a file only as models/weights/ lists it.
weights_of_the_bill() {
    local bill=$1 model=$2 role=${3:-}
    sed -n 's|.*"purl": "pkg:huggingface/\([^@]*\)@\([0-9a-f]\{40\}\)?checksum=sha256:\([0-9a-f]\{64\}\)&size=\([0-9]*\)&weights=\([^&#]*\)\(&default=true\)\{0,1\}\([^#]*\)#\([^"]*\)".*|\5 \3 \4 \1 \2 \8 \6 \7|p' "$bill" \
        | while read -r list sha size repository revision path default roles; do
            [[ "$default" == "&default=true" ]] || { roles=$default; default=""; }
            runs_in_the_role "$roles" "$role" || continue
            if [[ "$list" == platform || "$list" == "$model" || ( -z "$model" && -n "$default" ) ]]; then
                printf '%s %s %s %s %s %s\n' "$list" "$sha" "$size" "$repository" "$revision" "$path"
            fi
        done
}

die_on_a_model_the_bill_does_not_carry() {
    [[ -z "$MODEL_ID" ]] || grep -q "^${MODEL_ID} " <<< "$1" \
        || fail "Release ${VERSION:-} lists no weights for ${MODEL_ID}: a model goes in a folder once its license is read and its weights pinned"
}

weight_path_of() {
    local list=$1 repository=$2 revision=$3 path=$4
    printf 'weights/%s/%s/%s/%s' "$list" "$(printf '%s' "$repository" | tr '/' '_')" "$revision" "$path"
}

sha256_of_file() { openssl dgst -sha256 -r "$1" | cut -d' ' -f1; }

download_the_weights_into() {
    local folder=$1 list sha size repository revision path target
    while read -r list sha size repository revision path; do
        [[ -n "$list" ]] || continue
        target="$folder/$(weight_path_of "$list" "$repository" "$revision" "$path")"
        if [[ -f "$target" && "$(wc -c < "$target" | tr -d ' ')" == "$size" && "$(sha256_of_file "$target")" == "$sha" ]]; then
            log_info "${repository}/${path} already in the folder"
            continue
        fi
        mkdir -p "$(dirname "$target")"
        fetch --location --continue-at - --output "$target.part" "https://huggingface.co/${repository}/resolve/${revision}/${path}" \
            || fail "Could not download ${repository}/${path} — run the same command again to resume"
        if [[ "$(wc -c < "$target.part" | tr -d ' ')" != "$size" || "$(sha256_of_file "$target.part")" != "$sha" ]]; then
            rm -f "$target.part"
            fail "${repository}/${path} is not the file the release lists — run the same command again"
        fi
        mv "$target.part" "$target"
        log_info "${repository}/${path}"
    done
}

# A folder serves one architecture: what it holds for the box, tools included,
# runs on that processor only. ut-install compares it with the box's.
mark_the_folder_role() {
    local folder=$1 marked=""
    [[ -f "$folder/role" ]] && marked=$(cat "$folder/role")
    [[ -z "$marked" || "$marked" == "$FOLDER_ROLE" ]] \
        || fail "${folder} was prepared for the ${marked} role, not ${FOLDER_ROLE} — use another folder"
    printf '%s\n' "$FOLDER_ROLE" > "$folder/role"
}

mark_the_folder_architecture() {
    local folder=$1 marked=""
    [[ -f "$folder/architecture" ]] && marked=$(cat "$folder/architecture")
    [[ -z "$marked" || "$marked" == "$BOX_ARCHITECTURE" ]] \
        || fail "${folder} was prepared for ${marked}, not ${BOX_ARCHITECTURE} — use another folder"
    printf '%s\n' "$BOX_ARCHITECTURE" > "$folder/architecture"
}

prepare_a_folder() {
    command -v docker >/dev/null 2>&1 || fail "--prepare needs Docker on this machine"
    [[ "$BOX_ARCHITECTURE" == arm64 || "$BOX_ARCHITECTURE" == amd64 ]] \
        || fail "--architecture takes arm64 or amd64, not ${BOX_ARCHITECTURE}"
    [[ "$FOLDER_ROLE" =~ ^(appliance|control-plane|compute)$ ]] \
        || fail "--role takes appliance, control-plane or compute, not ${FOLDER_ROLE}"
    local image
    for image in ${EXTRA_IMAGES[@]+"${EXTRA_IMAGES[@]}"}; do
        [[ "$image" =~ @sha256:[0-9a-f]{64}$ ]] || fail "--image takes an image pinned by digest, name:tag@sha256:..., not ${image}"
    done
    [[ -r "$LICENSE_FILE" || -r "$TOKEN_FILE" ]] || fail "--prepare needs --license-file: the license key UnderstandTech issued"
    [[ -n "$VERSION" ]] || VERSION=$(latest_version) || exit 1
    is_a_release_version "$VERSION" || fail "${VERSION:-nothing} is not a release version — expected one like 2026.09.1"

    local folder package auth
    mkdir -p "$PREPARE_DIR"
    folder=$(cd "$PREPARE_DIR" && pwd)
    log_step "Downloading release ${VERSION} into ${folder}"
    download_release "$VERSION" "$folder" "understandtech_${VERSION}.cdx.json" >/dev/null || exit 1
    package=$(the_only_package_in "$folder") || exit 1
    verify_signature "$package" || fail "$(basename "$package") is NOT signed by UnderstandTech — delete ${folder} and run again"

    mark_the_folder_architecture "$folder"
    mark_the_folder_role "$folder"
    if [[ -r "$LICENSE_FILE" ]]; then
        read_the_registry_access_of_the_license
    else
        REGISTRY_TOKEN=$(tr -d '\r\n' < "$TOKEN_FILE")
    fi
    auth=$(mktemp -d)/auth
    write_registry_auth "$auth" "$REGISTRY_TOKEN"
    log_step "Copying every image the ${FOLDER_ROLE} role of release ${VERSION} runs"
    { images_of_the_bill "$folder/understandtech_${VERSION}.cdx.json" "$FOLDER_ROLE" "$MODEL_ID"
      for image in ${EXTRA_IMAGES[@]+"${EXTRA_IMAGES[@]}"}; do printf '%s@%s\n' "$(repository_of "$image")" "${image#*@}"; done
    } | copy_the_images_into "$folder" "$auth"
    copy_the_tools_into "$folder" "$auth"
    rm -rf "$(dirname "$auth")"

    local weights
    weights=$(weights_of_the_bill "$folder/understandtech_${VERSION}.cdx.json" "$MODEL_ID" "$FOLDER_ROLE")
    die_on_a_model_the_bill_does_not_carry "$weights"
    local of_the_model=${MODEL_ID:+of $MODEL_ID}
    log_step "Downloading the weights ${of_the_model:-of the release model} and of the platform"
    download_the_weights_into "$folder" <<< "$weights"

    log_step "Ready: $(du -sh "$folder" | cut -f1) in ${folder}"
    printf '  Carry it to the box, then run there:  sudo ut-get --from <where it is>\n'
    printf '  A box that cannot reach Keygen writes a license request: the license file\n'
    printf '  UnderstandTech sends back goes into the folder, and ut-get --from runs again.\n'
}

install_package() {
    local package=$1
    log_step "Installing $(basename "$package")"
    DEBIAN_FRONTEND=noninteractive apt-get install -y "$package" \
        || fail "apt-get could not install $(basename "$package")"
}

main() {
    parse_arguments "$@"
    if [[ -n "$PREPARE_DIR" ]]; then
        prepare_a_folder
        return 0
    fi
    [[ $EUID -eq 0 ]] || fail "Run with sudo: sudo $0 $*"

    if [[ -z "$RELEASE_DIR" ]]; then
        [[ -n "$VERSION" ]] || VERSION=$(latest_version) || exit 1
        is_a_release_version "$VERSION" \
            || fail "${VERSION:-nothing} is not a release version — expected one like 2026.09.1"
        log_step "Downloading UnderstandTech AI in a Box ${VERSION}"
        RELEASE_DIR=$(download_release "$VERSION") || exit 1
    fi

    [[ -d "$RELEASE_DIR" ]] || fail "No such directory: ${RELEASE_DIR}"
    local package
    package=$(the_only_package_in "$(cd "$RELEASE_DIR" && pwd)") || exit 1
    log_step "Checking $(basename "$package")"
    verify_signature "$package" \
        || fail "$(basename "$package") is NOT signed by UnderstandTech — nothing was installed. If it was downloaded, delete ${RELEASE_DIR} and run again"
    install_package "$package"
    if [[ -d "$RELEASE_DIR/images" ]]; then
        INSTALL_ARGUMENTS+=(--images-from "$(cd "$RELEASE_DIR" && pwd)")
    fi
    local license_file
    license_file=$(license_file_in "$(cd "$RELEASE_DIR" && pwd)") || exit 1
    if [[ -n "$license_file" ]]; then
        INSTALL_ARGUMENTS+=(--machine-file "$license_file")
    fi
    exec "$NEXT" ${INSTALL_ARGUMENTS[@]+"${INSTALL_ARGUMENTS[@]}"}
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
