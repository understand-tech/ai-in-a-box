# Mode "internal" — Caddy's own internal CA, self-signed certificates.
#
# This is the default, and the only mode that works on a .local domain: no
# public authority issues for .local, and an appliance on a flat network has no
# enterprise certificate to hand over either. The browser warns on first visit;
# the internal CA lives in the ut-caddy-data volume, so that warning keeps the
# same fingerprint across restarts instead of changing every time.

# Every mode carries the same metrics option: the global block lives in this
# file, and a Caddyfile has only one. Hosts that no site names are pooled under
# "_other", so a forged Host header cannot grow the counters.
#
# A client calling an IP sends no SNI, and Caddy would then look for a
# certificate under its container's address, not the one called: default_sni
# lets a compute node be reached by IP. Caddy does not nest {$VAR:default}.
{
    metrics {
        per_host
    }
    default_sni {$UT_INFERENCE_ADDRESS:understand.local}
    # The authority the links between boxes run on. backup-files.sh saves the
    # "local" one only: a restored box is paired again, never a clone of the first.
    pki {
        ca link {
            name "UnderstandTech link"
        }
    }
}

(tls) {
    tls internal
}

(tls_apps) {
    tls internal
}
