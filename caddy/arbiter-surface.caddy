# The arbiter's lease server, for the two boxes of a high-availability pair.
#
# Imported by the file ut-pair writes, and only once that file names one box:
# without a trust pool, client_auth checks certificates against the system
# roots. A box is known by the root of its link authority, which it handed over
# when it paired; served under link.internal whatever address the box dials,
# as the compute node's surface is.

https://link.internal:8446 {
    tls {
        issuer internal {
            ca link
        }
        client_auth {
            mode require_and_verify
            import admitted_boxes
        }
    }

    reverse_proxy arbiter:8446
}
