# The engine, for the platforms this compute node admits.
#
# Imported by the file ut-pair writes, and only once that file names one
# platform: without a trust pool, client_auth checks certificates against the
# system roots, and a public authority would get in. A platform is known by the
# root of its link authority, which it handed over when it paired.
#
# Served under one name whatever address the platform dials: a client calling
# an IP sends no SNI, and Caddy then applies no site's client_auth at all. The
# node is known by its root, not by its name.

https://link.internal:8444 {
    tls {
        issuer internal {
            ca link
        }
        client_auth {
            mode require_and_verify
            import admitted_boxes
        }
    }

    reverse_proxy nim-llm:8000
}
