#########################################################################
# LLM Configuration                                                     #
#########################################################################

COMPOSE_PROFILES="nim"
LLM_BACKEND="nim"

VLLM_LLM_IMAGE="vllm/vllm-openai:muse-glimmer"
VLLM_LLM_MODEL_PATH="Inferact/Muse-Glimmer-30B-NVFP4-W4A4"

NIM_VLM_PASSTHROUGH_ARGS=--gpu-memory-utilization 0.25 --max-model-len 8192
NIM_LLM_PASSTHROUGH_ARGS=--gpu-memory-utilization 0.55 --max-model-len 131072 --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3 --speculative-config '{"method":"mtp","num_speculative_tokens":3}' --default-chat-template-kwargs '{"enable_thinking":false}' --enable-prefix-caching
NIM_LLM_MODEL_PATH="hf://Inferact/Qwen3.8-27B-NVFP4"

VLLM_CONDENSE_MODEL="Qwen/Qwen3.8-27B"
VLLM_VLM_MODEL="Qwen/Qwen3-VL-4B-Instruct"
VLLM_LLM_BASE_URL="http://nim-llm:8000/v1"
VLLM_VLM_BASE_URL="http://nim-vlm:8000/v1"
VLLM_LLM_GPU_MEM_UTIL="0.45"
VLLM_VLM_GPU_MEM_UTIL="0.12"
VLLM_LLM_EXTRA_ARGS="--max-model-len 32768"
VLLM_VLM_EXTRA_ARGS="--limit-mm-per-prompt.video 0 --max-model-len 8192"
VLLM_API_KEY="EMPTY"
LLM_MAX_CONTEXT_LEN="131072"
DOWNLOAD_ONNX_EMBED="true"
ONNX_EMBED_HF_REPO="Qwen/Qwen3-Embedding-0.6B"
EMBED_MODEL_BACKEND="nomic"
HF_HUB_OFFLINE="0"
