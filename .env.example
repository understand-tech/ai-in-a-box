#########################################################################
#   For quarterly updates, update the image tags below and re-deploy.   #
#########################################################################

LLM_IMAGE="ghcr.io/understand-tech/ut-llm-customers:2.0-arm64"
API_IMAGE="ghcr.io/understand-tech/ut-api-customer:2.0-arm64"
WORKER_IMAGE="ghcr.io/understand-tech/ut-worker-customer:2.0-arm64"
FRONTEND_IMAGE="ghcr.io/understand-tech/ut-frontendv2-customer:2.0-arm64"
API_CUSTOMER_IMAGE="ghcr.io/understand-tech/ut-api-rest-customer:2.0-arm64"
WORKER_CUSTOMER_IMAGE="ghcr.io/understand-tech/ut-worker-rest-customer:2.0-arm64"
LLMS_APP_IMAGE="ghcr.io/understand-tech/ut-app-llms-customer:2.0-arm64"
ADMIN_PORTAL_IMAGE="ghcr.io/understand-tech/ut-portal-customer:2.0-arm64"
ASSISTANTS_APP_IMAGE="ghcr.io/understand-tech/ut-app-assistants-customer:2.0-arm64"
APP_BUILDER_IMAGE="ghcr.io/understand-tech/agentic-app-builder-customer:2.0-arm64"
NIM_IMAGE="ghcr.io/understand-tech/nim/nvidia/model-free-nim:2.0.9"

#########################################################################
#   Domain, TLS and upstream proxy                                      #
#                                                                       #
#   UT_DOMAIN is the only place the appliance's public name is written.  #
#   Every service URL derives from it (see the x-public-urls block in    #
#   compose.yaml), so moving to another domain is a one-line change.     #
#   Each URL stays individually overridable by setting it here — an      #
#   explicit value always wins over the derived default.                 #
#########################################################################

# Base name of this appliance. Every published surface derives from it:
#   <UT_DOMAIN>                platform and API
#   llms.<UT_DOMAIN>           LLMs app
#   assistants.<UT_DOMAIN>     Assistants app
#   admin.<UT_DOMAIN>          administration portal
#   builder.<UT_DOMAIN>        App Builder
#   <app>.apps.<UT_DOMAIN>     one per generated app
#
# A .local domain is published over mDNS by ut-mdns-alias, apex included, so
# the machine's own host name no longer has to match it. Any other domain
# needs real DNS records, and the mDNS service then stands itself down.
#
# mDNS does not cross a router: a .local name is unreachable from another
# network segment, and unusable for an appliance in a datacentre. Use a domain
# from the customer's DNS zone in that case.
#
# Two appliances on the same network need two distinct UT_DOMAIN values, or
# both publish the same mDNS name and clients reach whichever answers first.
# Give each its own JWT_SECRET, STATE_SECRET and MongoDB credentials too:
# they are independent instances with no shared state.
UT_DOMAIN="understand.local"

# Who terminates TLS:
#   internal  Caddy's internal CA, self-signed. The default, and the only
#             mode possible on a .local domain.
#   custom    certificate supplied by the operator, placed in UT_CERT_DIR.
#   edge      a reverse proxy or load balancer in front handles it; set
#             UT_CADDY_SCHEME="http" as well.
UT_INGRESS_MODE="internal"

# The scheme the applications advertise to the browser. Leave it on https
# even behind an upstream proxy: https is what the browser actually sees.
UT_PUBLIC_SCHEME="https"

# The scheme Caddy listens on — a different question from the one above. In
# edge mode TLS is already terminated upstream, so Caddy serves plain HTTP.
# Must be "http" when UT_INGRESS_MODE="edge", and "https" otherwise.
UT_CADDY_SCHEME="https"

# Sources allowed to set X-Forwarded-* (edge mode). Narrow this to the
# network your proxy speaks from: the private_ranges default lets any machine
# on the LAN spoof its source address.
#UT_TRUSTED_PROXIES="10.42.0.0/16"

# Certificates for custom mode. The directory is mounted on /etc/caddy/certs
# and must hold fullchain.pem and privkey.pem. The certificate has to cover
# the apex and the llms. assistants. admin. builder. names; generated apps
# sit two levels further down (*.apps.<domain>), so supply their wildcard
# separately.
#UT_CERT_DIR="/etc/understandtech/certs"
#UT_APPS_CERT_FILE="/etc/caddy/certs/apps-fullchain.pem"
#UT_APPS_KEY_FILE="/etc/caddy/certs/apps-privkey.pem"

# Host ports Caddy publishes, if 80/443 are already taken.
#UT_HTTP_PORT="80"
#UT_HTTPS_PORT="443"

#########################################################################
#   SECRETS — every one of these must be generated for this appliance   #
#                                                                       #
#   They ship empty on purpose. A value shipped here would be identical #
#   on every deployment, and JWT_SECRET in particular is shared by four #
#   services: a token minted at one customer would be accepted at       #
#   another.                                                            #
#                                                                       #
#   Generate all of them in one go:                                     #
#                                                                       #
#     for k in MONGODB_USERNAME MONGODB_PASSWORD JWT_SECRET \           #
#              STATE_SECRET OPENID_SECRET_KEY ADMIN_SETUP_PASSWORD \    #
#              GPU_VM_API_TOKEN BACKUP_FILES_PASSWORD; do               #
#         sed -i "s|^${k}=.*|${k}=\"$(openssl rand -hex 24)\"|" .env    #
#     done                                                              #
#                                                                       #
#   Hexadecimal on purpose: the database URI is built by concatenation, #
#   so a value holding @ / # or % breaks the connection string.         #
#                                                                       #
#   Note the two that cannot be rotated afterwards:                     #
#   MONGODB_PASSWORD is only read when the database is first created,   #
#   and BACKUP_FILES_PASSWORD is the key the backups are encrypted      #
#   with — losing it makes every snapshot unreadable, including the     #
#   copies held off-site. Write that one down somewhere other than      #
#   this machine.                                                       #
#########################################################################

MONGODB_USERNAME=""
MONGODB_PASSWORD=""

JWT_SECRET=""
STATE_SECRET=""
OPENID_SECRET_KEY=""
ADMIN_SETUP_PASSWORD=""

# Presented by the platform to the inference service.
GPU_VM_API_TOKEN=""

# Encrypts the file backup repository. See the warning above.
BACKUP_FILES_PASSWORD=""

# Unused in an on-premise deployment: both are cloud services this appliance
# does not reach. They shipped with short made-up values, which read as
# configured and were therefore never corrected.
OA_KEY=""
SENDGRID_API_KEY=""

##################################################################################################################################
#   Edit these as needed. For more information visit                                                                             #
#   https://docs.understand.tech/documentation/ai-in-a-box/installation-and-setup-guide#step-8-configure-environment-variables   #
##################################################################################################################################

WORKER_REPLICAS="2"
WORKER_CUSTOMER_REPLICAS="2"

# Which model is served depends on LLM_BACKEND, at the bottom of this file:
#   LLM_BACKEND="nim"   NIM_LLM_MODEL_PATH is what takes effect
#   LLM_BACKEND="vllm"  VLLM_LLM_MODEL is what takes effect
# The default is "nim", so editing VLLM_LLM_MODEL alone changes nothing.

#########################################################################
#   Do not edit below                                                   #
#########################################################################

# Database configuration
MONGODB_HOST="mongodb"
MONGODB_PORT="27017"
MONGODB_DATABASE="ut-db"

MODELS_DIR="/root/models/"
EMBED_URL="https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/main/nomic-embed-text-v1.5.f32.gguf"
EMBED_MODEL_NAME="nomic-embed-text-v1.5.f32.gguf"
RERANKER_HF_PATH="tomaarsen/Qwen3-Reranker-0.6B-seq-cls"
RERANKER_MODEL_NAME="Qwen3-Reranker-0.6B-seq-cls"
GPU_VM_URL="http://llm:8000"

ADMIN_MAIL="cto@understand.tech"
REDIS_HOST="redis"
REDIS_PORT="6379"
openid_scope="openid profile email"

DEPLOY_ENV="production"

VITE_AUTH_TYPE="open-id"
VITE_DEPLOYMENT_TYPE="onprem-ai-in-a-box"

DB_PROVIDER="mongodb"
STORAGE_PROVIDER="local"
LOCAL_STORAGE_BASE="/app/storage"

# INFO, not DEBUG: this is a customer's appliance, and an audit found sensitive
# content in the verbose logs. Note that a value written here wins over the
# default in compose.yaml, so leaving DEBUG here cancels that change.
LOG_LEVEL="INFO"

TYPE_DEPLOIEMENT="onprem"

APP_LLMS_MONGODB_DB="ut-app-llms"
APP_LLMS_UT_APP_BASE_URL="http://api:8501/api"
APP_LLMS_UT_CUSTOMER_URL="http://api-customer:8501"
UNDERSTAND_API_VERSION="v3"
APP_ASSISTANTS_MONGODB_DB="ut-app-assistants"

# Models offered in the catalogue. Local models only: an entry with an external
# base_url sends prompts off the appliance, which is the one thing this product
# promises not to do. A cloud model was listed here by default; it has been
# removed rather than commented, so it cannot be re-enabled by accident.
GATEWAY_MODELS='[{"id": "uai-large", "served": "Qwen/Qwen3.8-27B", "upstream": "llm", "display_name": "Understand AI", "multimodal": false}, {"id": "uai-vision", "served": "Qwen/Qwen3-VL-4B-Instruct", "upstream": "vlm", "display_name": "Understand AI Vision", "multimodal": true}]'

#########################################################################
#   App Builder                                                         #
#                                                                       #
#   Off by default, and it cannot be enabled on a first install: its    #
#   gateway key is generated inside the platform, which has to be       #
#   running first. Enabling it before that leaves the key empty.        #
#                                                                       #
#   To enable it, once the platform is up:                              #
#     1. platform UI -> DEVELOPER -> API keys, create one               #
#     2. set APP_BUILDER_GATEWAY_API_KEY below                          #
#     3. docker network create proxy                                    #
#     4. uncomment COMPOSE_FILE                                         #
#     5. docker compose up -d                                           #
#                                                                       #
#   Step 3 is not optional: the overlay declares that network external,  #
#   generated apps join it from their own compose projects, so no       #
#   project owns it and compose refuses to start without it.            #
#########################################################################

#COMPOSE_FILE="compose.yaml:compose.appbuilder.yaml"
APP_BUILDER_GATEWAY_API_KEY=""
APP_BUILDER_AGENT_BACKEND="deepagents"
APP_BUILDER_ANTHROPIC_API_KEY=""
APP_BUILDER_AGENT_MAX_OUTPUT_TOKENS="8192"
APP_BUILDER_AGENT_CONTEXT_TOKENS="24576"
APP_BUILDER_MEMORY_LIMIT="4G"
APP_BUILDER_CPU_LIMIT="2"

#########################################################################
# Do not edit below                                                     #
#########################################################################

APP_BUILDER_UT_API_URL="http://ut-api:8501"
APP_BUILDER_GATEWAY_URL="http://ut-api-customer:8501/api/llm"
APP_BUILDER_GATEWAY_MODEL="uai-large"
APP_BUILDER_UT_V3_URL="http://ut-api-v3"
APP_BUILDER_UT_CUSTOMER_URL="http://api-customer:8501"
APP_BUILDER_HOST_PORT="8011"
APP_BUILDER_LLM_PROXY_PORT="8011"
APP_BUILDER_MONGODB_DB="app-builder"
APP_BUILDER_SESSION_COOKIE_SECURE="1"

#########################################################################
# LLM Configuration                                                     #
#########################################################################

COMPOSE_PROFILES="nim"
LLM_BACKEND="nim"

VLLM_LLM_IMAGE="vllm/vllm-openai:muse-glimmer"
VLLM_LLM_MODEL_PATH="Inferact/Muse-Glimmer-30B-NVFP4-W4A4"

NIM_VLM_PASSTHROUGH_ARGS=--gpu-memory-utilization 0.25 --max-model-len 8192
NIM_LLM_PASSTHROUGH_ARGS=--gpu-memory-utilization 0.55 --max-model-len 131072 --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3 --speculative-config '{"method":"mtp","num_speculative_tokens":3}' --default-chat-template-kwargs '{"enable_thinking":false}' --enable-prefix-caching
NIM_LLM_MODEL_PATH="hf://Inferact/Qwen3.8-27B-NVFP4"

VLLM_LLM_MODEL="Qwen/Qwen3.8-27B"
VLLM_CONDENSE_MODEL="Qwen/Qwen3.8-27B"
VLLM_VLM_MODEL="Qwen/Qwen3-VL-4B-Instruct"
VLLM_LLM_BASE_URL="http://nim-llm:8000/v1"
VLLM_VLM_BASE_URL="http://nim-vlm:8000/v1"
VLLM_LLM_GPU_MEM_UTIL="0.45"
VLLM_VLM_GPU_MEM_UTIL="0.12"
VLLM_LLM_EXTRA_ARGS="--max-model-len 32768"
VLLM_VLM_EXTRA_ARGS="--limit-mm-per-prompt.video 0 --max-model-len 8192"

# "EMPTY" is vLLM's convention for "no authentication", not a placeholder to
# fill in — which is why inference is reachable without credentials. Turning
# authentication on means setting a real key here AND passing --api-key through
# NIM_LLM_PASSTHROUGH_ARGS. Keep the ports bound to loopback until then.
VLLM_API_KEY="EMPTY"

# Interface the NIM engines listen on, and the reason the line above is
# survivable: on loopback, inference is unreachable from the network even
# without a key.
#
# A second machine added as a compute node must override both. It exists to
# serve inference to the machine that holds the data, and on loopback it would
# start, pass its healthcheck, and serve nobody — a failure that looks like a
# model problem. See the header of compose.compute.yaml.
NIM_LLM_BIND_ADDRESS="127.0.0.1"
NIM_VLM_BIND_ADDRESS="127.0.0.1"

LLM_MAX_CONTEXT_LEN="131072"
DOWNLOAD_ONNX_EMBED="true"
ONNX_EMBED_HF_REPO="Qwen/Qwen3-Embedding-0.6B"
EMBED_MODEL_BACKEND="nomic"

# 0 lets the containers fetch model weights on first start, which is why an
# appliance sold as offline is only offline after a connected first boot.
# Setting it to 1 requires the weights to be present already — see the
# offline-first change in flight.
HF_HUB_OFFLINE="0"

#OLLAMA_MODEL_LLM="gpt-oss:20b"
#OLLAMA_MODEL_VLM="qwen3-vl:4b-instruct"
#OLLAMA_MODEL_CONDENSE_LLM="qwen3:4b-instruct-2507-q4_K_M"
#OLLAMA_HOST_PORT="11434"

LLM_MODEL="Qwen/Qwen3.8-27B"
CONDENSE_MODEL="Qwen/Qwen3.8-27B"
VLM_MODEL="Qwen/Qwen3-VL-4B-Instruct"
GATEWAY_LLM_SERVED_NAME="Qwen/Qwen3.8-27B"
GATEWAY_VLM_MODEL="Qwen/Qwen3-VL-4B-Instruct"

AGENT_MAX_OUTPUT_TOKENS=24576
