APP_BUILDER_UT_V3_URL="http://ut-api-v3"
APP_BUILDER_UT_CUSTOMER_URL="http://api-customer:8501"
APP_BUILDER_HOST_PORT="8011"
APP_BUILDER_LLM_PROXY_PORT="8011"
APP_BUILDER_MONGODB_DB="app-builder"
APP_BUILDER_SESSION_COOKIE_SECURE="1"

