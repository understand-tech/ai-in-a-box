#########################################################################
#   App Builder add-on (optional)                                       #
#   Uncomment COMPOSE_FILE to include it, then fill in the gateway key.  #
#########################################################################

# Enables compose.appbuilder.yaml for every `docker compose` command run in
# this directory, including the understandtech.service unit. Leave commented
# out on installs without the App Builder.
#COMPOSE_FILE="compose.yaml:compose.appbuilder.yaml"

# Workspace API key the builder uses for its own LLM calls through the
# gateway. Mint it in the platform UI: Account -> API keys. Builds fail with
# 401s until this is set.
APP_BUILDER_GATEWAY_API_KEY=""

# deepagents = fully local, every model call goes through the box gateway.
# sdk = Anthropic's Claude Code CLI, which needs outbound internet and
# APP_BUILDER_ANTHROPIC_API_KEY.
APP_BUILDER_AGENT_BACKEND="deepagents"
APP_BUILDER_ANTHROPIC_API_KEY=""

# Agent token budgets. Keep the context value at the serving engine's usable
# window: VLLM_LLM_EXTRA_ARGS --max-model-len (32768) minus the output
# budget (8192) = 24576. Raise both together if you raise --max-model-len.
APP_BUILDER_AGENT_MAX_OUTPUT_TOKENS="8192"
APP_BUILDER_AGENT_CONTEXT_TOKENS="24576"

# Resource ceiling for the orchestrator. Generated apps are capped
# separately, per app, by the templates.
APP_BUILDER_MEMORY_LIMIT="4G"
APP_BUILDER_CPU_LIMIT="2"

#########################################################################
#   App Builder — do not edit below                                     #
#########################################################################

# Public origins. builder.understand.local must also appear in
# EXTRA_ALLOWED_ORIGINS above, or ut-api refuses the login handoff.
APP_BUILDER_BASE_URL="https://builder.understand.local"
APP_BUILDER_ADMIN_URL="https://admin.understand.local"

# Hostname suffix for generated apps: <project>.apps.understand.local. Change
# it only together with the *.apps.understand.local block in the Caddyfile and
# the mDNS suffix in setup-autostart.sh — and note that existing apps keep
# their old hostnames until the orchestrator rewrites their routes at startup.
APP_BUILDER_PREVIEW_SUFFIX="apps.understand.local"

# In-cluster platform endpoints (plain HTTP inside the docker networks).
APP_BUILDER_UT_API_URL="http://api:8501"
APP_BUILDER_GATEWAY_URL="http://api-customer:8501/api/llm"
APP_BUILDER_GATEWAY_MODEL="uai-large"
APP_BUILDER_UT_V3_URL="http://ut-api"

# Host port for the builder, and the same number as generated apps see it
# (they reach it as host.docker.internal:<port>, having no route to the
# docker networks). These two MUST agree. Apps created before a change keep
# the old value in their own .env.
APP_BUILDER_HOST_PORT="8001"
APP_BUILDER_LLM_PROXY_PORT="8001"

# Own database on ut-mongodb, kept separate from ut-db.
APP_BUILDER_MONGODB_DB="app-builder"

APP_BUILDER_SESSION_COOKIE_SECURE="1"
