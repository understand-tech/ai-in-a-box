#########################################################################
#   App Builder                                                         #
#   Enabled by default through COMPOSE_FILE below: comment that line    #
#   out to run without it, otherwise fill in the gateway key.           #
#########################################################################

COMPOSE_FILE="compose.yaml:compose.appbuilder.yaml"
# Generate this in the platform UI: DEVELOPER -> API keys
APP_BUILDER_GATEWAY_API_KEY=""
APP_BUILDER_AGENT_BACKEND="deepagents"
APP_BUILDER_ANTHROPIC_API_KEY=""
APP_BUILDER_AGENT_MAX_OUTPUT_TOKENS="8192"
APP_BUILDER_AGENT_CONTEXT_TOKENS="24576"
# Live build progress ('Writing <file> — N tokens' + 'Waiting for
# capacity'): on by default. Set "0" to revert to whole-message LLM calls
# (also disables the first-token watchdog). Watchdog threshold in seconds:
#APP_BUILDER_LLM_STREAMING="1"
#APP_BUILDER_PROGRESS_WAIT_SECS="15"
APP_BUILDER_MEMORY_LIMIT="4G"
APP_BUILDER_CPU_LIMIT="2"

# ---- GitLab integration (optional) ----
# Lets Studio push each generated app's code to a GitLab repository. Two
# independent flows — enable either or both; each hides itself when its own
# variables are empty.
#
#   Token flow  -> set APP_BUILDER_TOKEN_ENCRYPTION_KEY only. Nothing to
#                  register: users paste an instance URL and a personal
#                  access token (scope: api).
#   OAuth flow  -> also set the client id and secret below. gitlab.com
#                  only. Register a Confidential application (Settings ->
#                  Applications) with scopes api + read_user, and
#                  https://builder.<UT_DOMAIN>/api/gitlab/auth/callback as
#                  the Redirect URI -- that callback follows UT_DOMAIN on
#                  its own, so there is nothing else to set. Override it
#                  with APP_BUILDER_GITLAB_REDIRECT_URI only if GitLab has
#                  to call back some other URL.
#
# The encryption key is a Fernet key that encrypts stored GitLab tokens at
# rest. Without it the token flow is refused (we will not store a personal
# access token in plaintext). With the App Builder running, generate one with:
#   docker compose exec ut-app-builder \
#     python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Back it up alongside your MongoDB backup, and do not rotate it: existing
# connections become undecryptable and every user has to reconnect.
#
# To restrict which GitLab hosts users may connect to, add
# APP_BUILDER_GITLAB_ALLOWED_HOSTS with a comma-separated list. Absent, any
# public HTTPS GitLab host is allowed.
APP_BUILDER_TOKEN_ENCRYPTION_KEY=""
APP_BUILDER_GITLAB_CLIENT_ID=""
APP_BUILDER_GITLAB_CLIENT_SECRET=""

#########################################################################
# Do not edit below                                                     #
#########################################################################

APP_BUILDER_UT_API_URL="http://ut-api:8501"
