#########################################################################
#   Domain, TLS and upstream proxy                                      #
#                                                                       #
#   UT_DOMAIN is the only place the appliance's public name is written. #
#   Every service URL derives from it (see the x-public-urls block in   #
#   compose.yaml), so moving to another domain is a one-line change.    #
#   Each URL stays individually overridable by setting it here — an     #
#   explicit value always wins over the derived default.                #
#########################################################################

# Base name of this appliance. Every published surface derives from it:
#   <UT_DOMAIN>                platform and API
#   llms.<UT_DOMAIN>           LLMs app
#   assistants.<UT_DOMAIN>     Assistants app
#   admin.<UT_DOMAIN>          administration portal
#   builder.<UT_DOMAIN>        App Builder
#   <app>.apps.<UT_DOMAIN>     one per generated app
#
# A .local domain is published over mDNS by ut-mdns-alias, apex included, so
# the machine's own host name no longer has to match it. Any other domain
# needs real DNS records, and the mDNS service then stands itself down.
#
# Two appliances on the same network need two distinct UT_DOMAIN values, or
# both publish the same mDNS name and clients reach whichever answers first.
# Give each its own JWT_SECRET, STATE_SECRET and MongoDB credentials too:
# they are independent instances with no shared state.
UT_DOMAIN="understand.local"

# Who terminates TLS:
#   internal  Caddy's internal CA, self-signed. The default, and the only
#             mode possible on a .local domain.
#   custom    certificate supplied by the operator, placed in UT_CERT_DIR.
#   edge      a reverse proxy or load balancer in front handles it; set
#             UT_CADDY_SCHEME="http" as well.
UT_INGRESS_MODE="internal"

# The scheme the applications advertise to the browser. Leave it on https
# even behind an upstream proxy: https is what the browser actually sees.
UT_PUBLIC_SCHEME="https"

# The scheme Caddy listens on — a different question from the one above. In
# edge mode TLS is already terminated upstream, so Caddy serves plain HTTP.
# Must be "http" when UT_INGRESS_MODE="edge", and "https" otherwise.
UT_CADDY_SCHEME="https"

# Sources allowed to set X-Forwarded-* (edge mode). Narrow this to the
# network your proxy speaks from: the private_ranges default lets any machine
# on the LAN spoof its source address.
#UT_TRUSTED_PROXIES="10.42.0.0/16"

# Certificates for custom mode. The directory is mounted on /etc/caddy/certs
# and must hold fullchain.pem and privkey.pem. The certificate has to cover
# the apex and the llms. assistants. admin. builder. names; generated apps
# sit two levels further down (*.apps.<domain>), so supply their wildcard
# separately.
#UT_CERT_DIR="/etc/understandtech/certs"
#UT_APPS_CERT_FILE="/etc/caddy/certs/apps-fullchain.pem"
#UT_APPS_KEY_FILE="/etc/caddy/certs/apps-privkey.pem"

# Host ports Caddy publishes, if 80/443 are already taken.
#UT_HTTP_PORT="80"
#UT_HTTPS_PORT="443"

