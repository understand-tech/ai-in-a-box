NIM_VLM_PASSTHROUGH_ARGS=--gpu-memory-utilization 0.25 --max-model-len 8192
NIM_LLM_PASSTHROUGH_ARGS=--gpu-memory-utilization 0.55 --max-model-len 131072 --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3 --speculative-config '{"method":"mtp","num_speculative_tokens":3}' --default-chat-template-kwargs '{"enable_thinking":false}' --enable-prefix-caching
NIM_LLM_MODEL_PATH="hf://Inferact/Qwen3.8-27B-NVFP4"

VLLM_CONDENSE_MODEL="Qwen/Qwen3.8-27B"
VLLM_VLM_MODEL="Qwen/Qwen3-VL-4B-Instruct"
VLLM_LLM_BASE_URL="http://nim-llm:8000/v1"
VLLM_VLM_BASE_URL="http://nim-vlm:8000/v1"
VLLM_LLM_GPU_MEM_UTIL="0.45"
VLLM_VLM_GPU_MEM_UTIL="0.12"
VLLM_LLM_EXTRA_ARGS="--max-model-len 32768"
VLLM_VLM_EXTRA_ARGS="--limit-mm-per-prompt.video 0 --max-model-len 8192"
VLLM_API_KEY="EMPTY"
# App-side context budget: ut-llm trims chat/RAG history to this many
# tokens before the engine sees it. 65536 keeps a GB10-class box responsive
# under concurrent agent traffic (the engine window stays --max-model-len);
# GB300-class boxes can run 98304.
LLM_MAX_CONTEXT_LEN="65536"
DOWNLOAD_ONNX_EMBED="true"
ONNX_EMBED_HF_REPO="Qwen/Qwen3-Embedding-0.6B"
EMBED_MODEL_BACKEND="nomic"
HF_HUB_OFFLINE="0"
#OLLAMA_MODEL_LLM="gpt-oss:20b"
#OLLAMA_MODEL_VLM="qwen3-vl:4b-instruct"
#OLLAMA_MODEL_CONDENSE_LLM="qwen3:4b-instruct-2507-q4_K_M"
#OLLAMA_HOST_PORT="11434"

LLM_MODEL="Qwen/Qwen3.8-27B"
CONDENSE_MODEL="Qwen/Qwen3.8-27B"
VLM_MODEL="Qwen/Qwen3-VL-4B-Instruct"
GATEWAY_LLM_SERVED_NAME="Qwen/Qwen3.8-27B"
GATEWAY_VLM_MODEL="Qwen/Qwen3-VL-4B-Instruct"

# ── Gateway protections (saturation guards) ─────────────────────────────
# Per-request prompt-size cap, estimated tokens. Oversized requests get the
# provider-exact 400 (context_length_exceeded) so coding CLIs auto-compact
# and retry — never trimmed. Default 65536; GB300-class boxes: 100000.
GATEWAY_MAX_PROMPT_TOKENS="65536"
# Requests/min per API key (sliding window; 0 disables). 30 suits one
# active coding session per key; GB300-class boxes: 60.
GATEWAY_RPM_PER_KEY="30"
# Per-user rate slices for the shared app-builder key: the gateway honors
# X-UT-Acting-User only from keys listed in GATEWAY_TRUSTED_PROXY_KEYS
# (compose defaults it to APP_BUILDER_GATEWAY_API_KEY — normally nothing to
# set). Each asserted user gets GATEWAY_RPM_PER_USER (default = per-key),
# bounded by the GATEWAY_RPM_PER_KEY_TOTAL aggregate (default 10x per-key).
#GATEWAY_TRUSTED_PROXY_KEYS=""
#GATEWAY_RPM_PER_USER="30"
#GATEWAY_RPM_PER_KEY_TOTAL="300"

AGENT_MAX_OUTPUT_TOKENS=24576
