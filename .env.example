#########################################################################
#   For quarterly updates, update the image tags below and re-deploy.   #
#########################################################################

LLM_IMAGE="ghcr.io/understand-tech/ut-llm-customer:1.1.0-arm64"
API_IMAGE="ghcr.io/understand-tech/ut-api-customer:1.1.0-arm64"
WORKER_IMAGE="ghcr.io/understand-tech/ut-worker-customer:1.1.0-arm64"
FRONTEND_IMAGE="ghcr.io/understand-tech/ut-frontend-customer:1.1.0"
API_CUSTOMER_IMAGE="ghcr.io/understand-tech/ut-api-rest-customer:1.1.0-arm64"
WORKER_CUSTOMER_IMAGE="ghcr.io/understand-tech/ut-worker-rest-customer:1.1.0-arm64"
# Must be an on-prem build of ut-admin-dashboard (VITE_DEPLOYMENT_TYPE=onprem-*)
ADMIN_DASHBOARD_IMAGE="ghcr.io/understand-tech/ut-portal-customer:1.1.0"

##################################################################################################################################    
#   Edit these as needed. For more information visit                                                                             #
#   https://docs.understand.tech/documentation/ai-in-a-box/installation-and-setup-guide#step-8-configure-environment-variables   # 
##################################################################################################################################

MONGODB_USERNAME="your-chosen-username"
MONGODB_PASSWORD="your-chosen-password"

WORKER_REPLICAS="2"
WORKER_CUSTOMER_REPLICAS="2"

VLLM_LLM_MODEL="openai/gpt-oss-20b"

#########################################################################
#   Do not edit below                                                   #
#########################################################################

# Database configuration
MONGODB_HOST="mongodb"
MONGODB_PORT="27017"
MONGODB_DATABASE="ut-db"

# LLM configuration
LLM_BACKEND="vllm"
VLLM_CONDENSE_MODEL="openai/gpt-oss-20b"
VLLM_VLM_MODEL="Qwen/Qwen3-VL-4B-Instruct"
VLLM_LLM_BASE_URL="http://localhost:8001/v1"                                                                                                                                    
VLLM_VLM_BASE_URL="http://localhost:8002/v1"
VLLM_LLM_GPU_MEM_UTIL="0.55"
VLLM_VLM_GPU_MEM_UTIL="0.12"
VLLM_LLM_EXTRA_ARGS="--max-model-len 32768"
VLLM_VLM_EXTRA_ARGS="--limit-mm-per-prompt.video 0 --max-model-len 8192"
VLLM_API_KEY="EMPTY"
LLM_MAX_CONTEXT_LEN="32768"
DOWNLOAD_ONNX_EMBED="true"
ONNX_EMBED_HF_REPO="Qwen/Qwen3-Embedding-0.6B"
EMBED_MODEL_BACKEND="nomic"
HF_HUB_OFFLINE="0"

MODELS_DIR="/root/models/"
EMBED_URL="https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/main/nomic-embed-text-v1.5.f32.gguf"
EMBED_MODEL_NAME="nomic-embed-text-v1.5.f32.gguf"
RERANKER_HF_PATH="tomaarsen/Qwen3-Reranker-0.6B-seq-cls"
RERANKER_MODEL_NAME="Qwen3-Reranker-0.6B-seq-cls"
GPU_VM_API_TOKEN=""
GPU_VM_URL="http://llm:8000"

#OLLAMA_MODEL_LLM="gpt-oss:20b"
#OLLAMA_MODEL_VLM="qwen3-vl:4b-instruct"
#OLLAMA_MODEL_CONDENSE_LLM="qwen3:4b-instruct-2507-q4_K_M"
#OLLAMA_HOST_PORT="11434"

ADMIN_MAIL="cto@understand.tech"
FRONTEND_URL_AUTH="https://understand.local/en/chat"
REDIS_HOST="redis"
REDIS_PORT="6379"
openid_scope="openid profile email"

VITE_URL_API_REST="https://understand.local"
VITE_AUTH_TYPE="open-id"
VITE_DEPLOYMENT_TYPE="onprem-ai-in-a-box"

PUBLIC_BASE_URL="https://understand.local"
REDIRECT_PATH="/api/auth/callback"
REDIRECT_URI="https://understand.local/api/auth/callback"
STATE_SECRET="SECRET"

BACKEND_URL="https://understand.local/api"
DOMAIN_URL="https://understand.local/"

DB_PROVIDER="mongodb"
STORAGE_PROVIDER="local"
LOCAL_STORAGE_BASE="/app/storage"
LOG_LEVEL="DEBUG"
TYPE_DEPLOIEMENT="onprem"
DEPLOY_ENV="production"
ADMIN_SETUP_PASSWORD="password000"

# Admin dashboard origin, trusted by the API before the first configuration
# is saved (CORS + SSO handoff). Must match the hostname Caddy serves the
# dashboard on.
EXTRA_ALLOWED_ORIGINS="https://admin.understand.local"
