# UnderstandTech ingress.
#
# This file holds no hostname of its own. The domain comes from UT_DOMAIN and
# the listening scheme from UT_CADDY_SCHEME, both set in .env: to move the
# appliance to another name, edit .env, not this file.
#
# ingress.caddy is bind-mounted by compose according to UT_INGRESS_MODE
# (caddy/ingress-internal.caddy, -custom.caddy or -edge.caddy). It supplies the
# global options that mode needs and the (tls) and (tls_apps) snippets imported
# below — it is the one place where the TLS mode is decided.
import /etc/caddy/ingress.caddy

{$UT_CADDY_SCHEME:https}://{$UT_DOMAIN:understand.local} {
    handle {
        reverse_proxy frontend:80
    }

    handle /api/* {
        reverse_proxy api:8501
    }

    handle /api/v3/* {
        reverse_proxy api-customer:8501
    }

    handle /api/llm/* {
        reverse_proxy api-customer:8501
    }

    import tls

}

{$UT_CADDY_SCHEME:https}://llms.{$UT_DOMAIN:understand.local} {
    reverse_proxy app-llms:80

    import tls
}

{$UT_CADDY_SCHEME:https}://admin.{$UT_DOMAIN:understand.local} {
    handle {
        reverse_proxy admin-portal:8080
    }

    handle /api/* {
        reverse_proxy api:8501
    }

    import tls
}

{$UT_CADDY_SCHEME:https}://assistants.{$UT_DOMAIN:understand.local} {
    reverse_proxy app-assistants:80

    import tls
}


{$UT_CADDY_SCHEME:https}://builder.{$UT_DOMAIN:understand.local} {
    reverse_proxy app-builder:8001

    import tls
}

# App Builder generated apps sit two levels below the apex, hence a separate
# TLS snippet: a *.<domain> wildcard does not cover *.apps.<domain>.
{$UT_CADDY_SCHEME:https}://*.apps.{$UT_DOMAIN:understand.local} {
    reverse_proxy app-builder-traefik:80

    import tls_apps
}
